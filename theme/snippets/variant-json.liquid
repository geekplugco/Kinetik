{% doc %}
  Canonical variant payload for <variant-picker>. Emits the full field superset
  consumed by variant-picker.js, product-gallery.js, and product-loadout.js so
  every section shares one schema.
  @param {object} product - the product whose variants are serialized
  @param {number} [image_width] - featured image width in px (default 800)
{% enddoc %}
{%- assign vj_width = image_width | default: 800 -%}
<script type="application/json">
  [
    {%- for variant in product.variants -%}
      {"id":{{ variant.id }},"options":{{ variant.options | json }},"available":{{ variant.available }},"price":{{ variant.price | money | json }},"price_cents":{{ variant.price }},"compare_at":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},"on_sale":{% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},"sku":{{ variant.sku | json }},"inventory_management":{{ variant.inventory_management | json }},"inventory_quantity":{{ variant.inventory_quantity }},"featured_media_id":{% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %},"featured_image":{% if variant.featured_media %}{{ variant.featured_media | image_url: width: vj_width | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>
