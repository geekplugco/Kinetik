{%- doc -%}
  Render one product media item by type for the PDP media lab (image, hosted video,
  external video, or 3D model). Image is the LCP-eligible path; video/model preload
  nothing so they never block the first paint.

  @param media {object} - a product media object (product.media item)
  @param loading {string} - img loading attribute: 'eager' (first media) or 'lazy'
  @param priority {string} - img fetchpriority: 'high' (first media) or 'auto'
  @param sizes {string} - the img sizes attribute for srcset selection
  @param alt {string} - alt text for the media
  @param [fit] {string} - object-fit keyword, defaults to 'cover'; pass 'contain' to show the full frame uncropped

  @example
  {%- render 'product-media', media: media, loading: 'eager', priority: 'high', sizes: '100vw', alt: product.title -%}
{%- enddoc -%}
{%- liquid
  assign m_widths = '600,900,1200,1600'
  assign m_contain = false
  if fit == 'contain'
    assign m_contain = true
  endif
-%}
{%- case media.media_type -%}
  {%- when 'video' -%}
    {%- if m_contain -%}
      {{ media | video_tag: image_size: '1100x', controls: true, preload: 'none', class: 'h-full w-full object-contain' }}
    {%- else -%}
      {{ media | video_tag: image_size: '1100x', controls: true, preload: 'none', class: 'h-full w-full object-cover' }}
    {%- endif -%}
  {%- when 'external_video' -%}
    {{ media | external_video_tag: loading: 'lazy', class: 'h-full w-full' }}
  {%- when 'model' -%}
    {{ media | model_viewer_tag: image_size: '1200x', toggleable: true, class: 'h-full w-full' }}
    <script src="{{ 'product-model.js' | asset_url }}" defer="defer"></script>
  {%- else -%}
    {%- if m_contain -%}
      {{ media | image_url: width: 1600 | image_tag: loading: loading, fetchpriority: priority, widths: m_widths, sizes: sizes, alt: alt, class: 'h-full w-full object-contain transition-transform duration-200 ease-out' }}
    {%- else -%}
      {{ media | image_url: width: 1600 | image_tag: loading: loading, fetchpriority: priority, widths: m_widths, sizes: sizes, alt: alt, class: 'h-full w-full object-cover transition-transform duration-200 ease-out' }}
    {%- endif -%}
{%- endcase -%}
