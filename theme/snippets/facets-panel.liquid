{%- liquid
  assign has_color_filter = false
  assign has_size_filter = false
  assign color_values = '|'
  assign size_values = '|'
  for filter in collection.filters
    assign flabel = filter.label | downcase
    if flabel contains 'color' or flabel contains 'colour'
      assign has_color_filter = true
    endif
    if flabel contains 'size'
      assign has_size_filter = true
    endif
  endfor
  for product in collection.products
    for option in product.options_with_values
      assign oname = option.name | downcase
      if oname contains 'color' or oname contains 'colour'
        for value in option.values
          assign token = '|' | append: value | append: '|'
          unless color_values contains token
            assign color_values = color_values | append: value | append: '|'
          endunless
        endfor
      elsif oname contains 'size'
        for value in option.values
          assign token = '|' | append: value | append: '|'
          unless size_values contains token
            assign size_values = size_values | append: value | append: '|'
          endunless
        endfor
      endif
    endfor
  endfor
  assign color_list = color_values | split: '|'
  assign size_list = size_values | split: '|'
-%}
{%- for filter in collection.filters -%}
  <details class="border-b border-border-hairline py-4"{% if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank %} open{% endif %}>
    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-mono text-xs uppercase tracking-label text-text-strong [&::-webkit-details-marker]:hidden">
      {{ filter.label }}
      <span aria-hidden="true">+</span>
    </summary>
    <div class="mt-4 flex flex-col gap-3">
      {%- liquid
        assign is_color_filter = false
        assign is_size_filter = false
        assign f_label_dc = filter.label | downcase
        if f_label_dc contains 'color' or f_label_dc contains 'colour'
          assign is_color_filter = true
        elsif f_label_dc contains 'size'
          assign is_size_filter = true
        endif
      -%}
      {%- case filter.type -%}
        {%- when 'boolean', 'list' -%}
          {%- if is_color_filter -%}
            <div class="flex flex-wrap gap-2.5 pt-1">
              {%- for value in filter.values -%}
                {%- assign sw_title = value.label | append: ' (' | append: value.count | append: ')' -%}
                <label class="cursor-pointer{% if value.count == 0 and value.active == false %} pointer-events-none opacity-35{% endif %}">
                  <input type="checkbox" class="peer sr-only" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                  <span class="sr-only">{{ value.label }} ({{ value.count }})</span>
                  {%- if value.swatch.color or value.swatch.image -%}
                    {%- render 'swatch', value: value, title: sw_title, size_class: 'h-8 w-8' -%}
                  {%- else -%}
                    {%- render 'swatch', value: value.label, title: sw_title, size_class: 'h-8 w-8' -%}
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </div>
          {%- elsif is_size_filter -%}
            <div class="flex flex-wrap gap-2 pt-1">
              {%- for value in filter.values -%}
                <label class="cursor-pointer{% if value.count == 0 and value.active == false %} pointer-events-none opacity-35{% endif %}" title="{{ value.label | escape }} ({{ value.count }})">
                  <input type="checkbox" class="peer sr-only" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                  <span class="block min-w-[2.75rem] border border-border-hairline px-3 py-2 text-center font-mono text-xs uppercase tracking-wide text-text-muted peer-checked:border-border-strong peer-checked:bg-surface-sunken peer-checked:text-text-strong peer-focus-visible:ring-2 peer-focus-visible:ring-accent-press">{{ value.label }}</span>
                </label>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="flex max-h-72 flex-col gap-3 overflow-y-auto pr-1">
              {%- for value in filter.values -%}
                <label class="flex min-h-[44px] items-center justify-between gap-4 text-sm text-text-body{% if value.count == 0 and value.active == false %} opacity-40{% endif %}">
                  <span class="flex items-center gap-3">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      class="h-4 w-4 border border-border-strong accent-[var(--accent)]"
                    >
                    <span>{{ value.label }}</span>
                  </span>
                  <span class="font-mono text-[11px] text-text-muted">{{ value.count }}</span>
                </label>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- when 'price_range' -%}
          {%- liquid
            assign price_range_max = filter.range_max | money_without_currency | replace: ',', '' | times: 1
            assign price_min_val = 0
            if filter.min_value.value
              assign price_min_val = filter.min_value.value | money_without_currency | replace: ',', '' | times: 1
            endif
            assign price_max_val = price_range_max
            if filter.max_value.value
              assign price_max_val = filter.max_value.value | money_without_currency | replace: ',', '' | times: 1
            endif
          -%}
          <div data-price-slider data-range-max="{{ price_range_max }}" class="pt-1">
            <div class="relative h-1 rounded-full bg-border-hairline">
              <div data-price-fill class="absolute h-1 rounded-full bg-accent"></div>
              <input type="range" data-price-thumb="min" min="0" max="{{ price_range_max }}" step="1" value="{{ price_min_val }}" aria-label="Minimum price" class="pointer-events-none absolute inset-x-0 top-1/2 h-1 w-full -translate-y-1/2 appearance-none bg-transparent [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:cursor-pointer [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-2 [&::-moz-range-thumb]:border-surface-page [&::-moz-range-thumb]:bg-accent [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-surface-page [&::-webkit-slider-thumb]:bg-accent [&::-webkit-slider-thumb]:shadow-[0_0_0_1px_var(--border-strong)]">
              <input type="range" data-price-thumb="max" min="0" max="{{ price_range_max }}" step="1" value="{{ price_max_val }}" aria-label="Maximum price" class="pointer-events-none absolute inset-x-0 top-1/2 h-1 w-full -translate-y-1/2 appearance-none bg-transparent [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:h-4 [&::-moz-range-thumb]:w-4 [&::-moz-range-thumb]:cursor-pointer [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-2 [&::-moz-range-thumb]:border-surface-page [&::-moz-range-thumb]:bg-accent [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-surface-page [&::-webkit-slider-thumb]:bg-accent [&::-webkit-slider-thumb]:shadow-[0_0_0_1px_var(--border-strong)]">
            </div>
            <div class="mt-6 grid grid-cols-2 gap-3">
              <label class="flex flex-col gap-1 font-mono text-[11px] uppercase tracking-label text-text-muted">
                Min
                <input data-price-number="min" name="{{ filter.min_value.param_name }}" type="number" inputmode="numeric" min="0" max="{{ price_range_max }}" value="{% if filter.min_value.value %}{{ price_min_val }}{% endif %}" class="min-h-[44px] border border-border-hairline bg-surface-page px-3 py-2 font-sans text-sm text-text-strong">
              </label>
              <label class="flex flex-col gap-1 font-mono text-[11px] uppercase tracking-label text-text-muted">
                Max
                <input data-price-number="max" name="{{ filter.max_value.param_name }}" type="number" inputmode="numeric" min="0" max="{{ price_range_max }}" value="{% if filter.max_value.value %}{{ price_max_val }}{% endif %}" class="min-h-[44px] border border-border-hairline bg-surface-page px-3 py-2 font-sans text-sm text-text-strong">
              </label>
            </div>
          </div>
      {%- endcase -%}
    </div>
  </details>
{%- endfor -%}
{%- unless has_color_filter -%}
  {%- assign rendered_color = false -%}
  {%- for value in color_list -%}
    {%- if value != blank -%}{%- assign rendered_color = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if rendered_color -%}
    <details class="border-b border-border-hairline py-4">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-mono text-xs uppercase tracking-label text-text-strong [&::-webkit-details-marker]:hidden">Color<span aria-hidden="true">+</span></summary>
      <div class="mt-4 flex flex-wrap gap-2.5">
        {%- for value in color_list -%}
          {%- if value == blank -%}{%- continue -%}{%- endif -%}
          <label class="cursor-pointer">
            <input type="checkbox" data-client-filter="color" value="{{ value | escape }}" class="peer sr-only">
            <span class="sr-only">{{ value }}</span>
            {%- render 'swatch', value: value, title: value, size_class: 'h-8 w-8' -%}
          </label>
        {%- endfor -%}
      </div>
    </details>
  {%- endif -%}
{%- endunless -%}
{%- unless has_size_filter -%}
  {%- assign rendered_size = false -%}
  {%- for value in size_list -%}
    {%- if value != blank -%}{%- assign rendered_size = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if rendered_size -%}
    <details class="border-b border-border-hairline py-4">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-mono text-xs uppercase tracking-label text-text-strong [&::-webkit-details-marker]:hidden">Size<span aria-hidden="true">+</span></summary>
      <div class="mt-4 flex flex-wrap gap-2">
        {%- for value in size_list -%}
          {%- if value == blank -%}{%- continue -%}{%- endif -%}
          <label class="cursor-pointer">
            <input type="checkbox" data-client-filter="size" value="{{ value | escape }}" class="peer sr-only">
            <span class="block min-w-[2.75rem] border border-border-hairline px-3 py-2 text-center font-mono text-xs uppercase tracking-wide text-text-muted peer-checked:border-border-strong peer-checked:bg-surface-sunken peer-checked:text-text-strong peer-focus-visible:ring-2 peer-focus-visible:ring-accent-press">{{ value }}</span>
          </label>
        {%- endfor -%}
      </div>
    </details>
  {%- endif -%}
{%- endunless -%}
