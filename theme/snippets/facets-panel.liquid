{%- liquid
  assign has_color_filter = false
  assign has_size_filter = false
  assign color_values = '|'
  assign size_values = '|'
  for filter in collection.filters
    assign flabel = filter.label | downcase
    if flabel contains 'color' or flabel contains 'colour'
      assign has_color_filter = true
    endif
    if flabel contains 'size'
      assign has_size_filter = true
    endif
  endfor
  for product in collection.products
    for option in product.options_with_values
      assign oname = option.name | downcase
      if oname contains 'color' or oname contains 'colour'
        for value in option.values
          assign token = '|' | append: value | append: '|'
          unless color_values contains token
            assign color_values = color_values | append: value | append: '|'
          endunless
        endfor
      elsif oname contains 'size'
        for value in option.values
          assign token = '|' | append: value | append: '|'
          unless size_values contains token
            assign size_values = size_values | append: value | append: '|'
          endunless
        endfor
      endif
    endfor
  endfor
  assign color_list = color_values | split: '|'
  assign size_list = size_values | split: '|'
-%}
{%- for filter in collection.filters -%}
  <details class="border-b border-border-hairline py-4"{% if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank %} open{% endif %}>
    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-mono text-xs uppercase tracking-label text-text-strong [&::-webkit-details-marker]:hidden">
      {{ filter.label }}
      <span aria-hidden="true">+</span>
    </summary>
    <div class="mt-4 flex flex-col gap-3">
      {%- case filter.type -%}
        {%- when 'boolean', 'list' -%}
          {%- for value in filter.values -%}
            <label class="flex min-h-[44px] items-center justify-between gap-4 text-sm text-text-body{% if value.count == 0 and value.active == false %} opacity-40{% endif %}">
              <span class="flex items-center gap-3">
                <input
                  type="checkbox"
                  name="{{ value.param_name }}"
                  value="{{ value.value }}"
                  {% if value.active %}checked{% endif %}
                  {% if value.count == 0 and value.active == false %}disabled{% endif %}
                  class="h-4 w-4 border border-border-strong accent-[var(--accent)]"
                >
                <span>{{ value.label }}</span>
              </span>
              <span class="font-mono text-[11px] text-text-muted">{{ value.count }}</span>
            </label>
          {%- endfor -%}
        {%- when 'price_range' -%}
          <div class="grid grid-cols-2 gap-3">
            <label class="flex flex-col gap-1 font-mono text-[11px] uppercase tracking-label text-text-muted">
              Min
              <input name="{{ filter.min_value.param_name }}" type="number" inputmode="numeric" min="0" {% if filter.range_max != blank %}max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"{% endif %} value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}" class="min-h-[44px] border border-border-hairline bg-surface-page px-3 py-2 font-sans text-sm text-text-strong">
            </label>
            <label class="flex flex-col gap-1 font-mono text-[11px] uppercase tracking-label text-text-muted">
              Max
              <input name="{{ filter.max_value.param_name }}" type="number" inputmode="numeric" min="0" {% if filter.range_max != blank %}max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"{% endif %} value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}" class="min-h-[44px] border border-border-hairline bg-surface-page px-3 py-2 font-sans text-sm text-text-strong">
            </label>
          </div>
      {%- endcase -%}
    </div>
  </details>
{%- endfor -%}
{%- unless has_color_filter -%}
  {%- assign rendered_color = false -%}
  {%- for value in color_list -%}
    {%- if value != blank -%}{%- assign rendered_color = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if rendered_color -%}
    <details class="border-b border-border-hairline py-4">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-mono text-xs uppercase tracking-label text-text-strong [&::-webkit-details-marker]:hidden">Color<span aria-hidden="true">+</span></summary>
      <div class="mt-4 flex flex-col gap-3">
        {%- for value in color_list -%}
          {%- if value == blank -%}{%- continue -%}{%- endif -%}
          <label class="flex min-h-[44px] items-center gap-3 text-sm text-text-body">
            <input type="checkbox" name="filter.v.option.color" value="{{ value | escape }}" class="h-4 w-4 border border-border-strong accent-[var(--accent)]">
            <span>{{ value }}</span>
          </label>
        {%- endfor -%}
      </div>
    </details>
  {%- endif -%}
{%- endunless -%}
{%- unless has_size_filter -%}
  {%- assign rendered_size = false -%}
  {%- for value in size_list -%}
    {%- if value != blank -%}{%- assign rendered_size = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if rendered_size -%}
    <details class="border-b border-border-hairline py-4">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-mono text-xs uppercase tracking-label text-text-strong [&::-webkit-details-marker]:hidden">Size<span aria-hidden="true">+</span></summary>
      <div class="mt-4 flex flex-col gap-3">
        {%- for value in size_list -%}
          {%- if value == blank -%}{%- continue -%}{%- endif -%}
          <label class="flex min-h-[44px] items-center gap-3 text-sm text-text-body">
            <input type="checkbox" name="filter.v.option.size" value="{{ value | escape }}" class="h-4 w-4 border border-border-strong accent-[var(--accent)]">
            <span>{{ value }}</span>
          </label>
        {%- endfor -%}
      </div>
    </details>
  {%- endif -%}
{%- endunless -%}
