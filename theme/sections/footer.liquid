{%- liquid
  assign s = section.settings
  assign menu = linklists[s.menu]
  assign footer_style = s.footer_style | default: 'system'
-%}
<div data-color-scheme="{{ s.color_scheme | default: 'scheme-2' }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;" class="theme-dark bg-surface-page text-text-body">
  {%- if footer_style == 'compact' -%}
    <div class="mx-auto flex max-w-[var(--page-width)] flex-col gap-8 px-6 py-8 md:flex-row md:items-center md:justify-between">
      <div class="max-w-md">
        <a href="{{ routes.root_url }}" class="font-display text-[1.5rem] font-bold uppercase leading-none text-text-strong" aria-label="{{ shop.name | escape }}">{{ shop.name | upcase }}<span class="text-accent">.</span></a>
        <p class="mt-3 font-mono text-xs uppercase tracking-label text-text-muted">{{ s.tagline | default: 'No noise. Drops, restocks, field notes.' }}</p>
      </div>
      <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs uppercase tracking-label">
        {%- for link in menu.links -%}
          <a href="{{ link.url }}" class="text-text-body transition-colors hover:text-text-strong">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
      {%- form 'customer', class: 'flex min-w-0 gap-2 md:w-80' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="Footer-email-{{ section.id }}" class="sr-only">{{ 'newsletter.label' | t | default: 'Email' }}</label>
        <input id="Footer-email-{{ section.id }}" type="email" name="contact[email]" required placeholder="you@domain.com" class="min-w-0 flex-1 border border-border-strong bg-transparent px-3 py-2 font-mono text-xs text-text-strong outline-none placeholder:text-text-muted focus-visible:border-accent">
        {%- render 'button', label: 'Join', type: 'submit', size: 'sm' -%}
      {%- endform -%}
    </div>
    <div class="mx-auto flex max-w-[var(--page-width)] flex-col items-center justify-between gap-3 border-t border-border-hairline px-6 py-5 font-mono text-xs text-text-muted md:flex-row">
      <span>&copy; {{ shop.name }}. Engineered for movement.</span>
      {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="flex flex-wrap items-center gap-2">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'h-6 w-auto' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- elsif footer_style == 'editorial' -%}
    <div class="mx-auto grid max-w-[var(--page-width)] gap-10 px-6 py-14 md:grid-cols-[1.35fr_1fr] md:py-20">
      <div>
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.newsletter_heading | default: 'The drop list' }}</span>
        <h2 class="mt-4 max-w-4xl font-display text-display-2 uppercase leading-none text-text-strong">{{ s.cta_heading | default: 'Stay in the system' }}</h2>
        <p class="mt-5 max-w-lg font-mono text-xs uppercase tracking-label text-text-muted">{{ s.tagline | default: 'No noise. Drops, restocks, field notes.' }}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <nav aria-label="Footer" class="flex flex-col gap-3">
          <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.menu_heading | default: 'Shop' }}</span>
          {%- for link in menu.links -%}
            <a href="{{ link.url }}" class="text-sm text-text-body transition-colors hover:text-text-strong">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
        <div class="flex flex-col gap-3">
          <span class="font-mono text-xs uppercase tracking-label text-text-muted">Follow</span>
          {%- if s.show_social -%}
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank">Instagram</a>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank">TikTok</a>{%- endif -%}
            {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank">YouTube</a>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank">Facebook</a>{%- endif -%}
            {%- if settings.social_x != blank -%}<a href="{{ settings.social_x }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank"><span>X</span></a>{%- endif -%}
          {%- endif -%}
          {%- if s.enable_follow_on_shop -%}
            <follow-on-shop shop-id="{{ shop.id }}"></follow-on-shop>
          {%- endif -%}
        </div>
      </div>
    </div>
    <div class="border-y border-border-hairline px-6 py-6">
      {%- form 'customer', class: 'mx-auto flex max-w-[var(--page-width)] flex-col gap-3 md:flex-row md:items-center' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="Footer-email-{{ section.id }}" class="sr-only">{{ 'newsletter.label' | t | default: 'Email' }}</label>
        <input id="Footer-email-{{ section.id }}" type="email" name="contact[email]" required placeholder="you@domain.com" class="min-w-0 flex-1 border border-border-strong bg-transparent px-4 py-3 font-mono text-sm text-text-strong outline-none placeholder:text-text-muted focus-visible:border-accent">
        {%- render 'button', label: 'Subscribe', type: 'submit', size: 'md' -%}
      {%- endform -%}
    </div>
    <div aria-hidden="true" class="overflow-hidden px-6">
      <div class="mx-auto max-w-[var(--page-width)]">
        <span class="block select-none whitespace-normal font-display text-[clamp(2.5rem,11vw,17rem)] font-bold uppercase leading-[0.85] tracking-[-0.04em] text-text-strong md:whitespace-nowrap md:leading-[0.78] md:tracking-[-0.05em]">{{ shop.name }}<span class="text-accent">.</span></span>
      </div>
    </div>
  {%- elsif footer_style == 'split' -%}
    <div class="mx-auto grid max-w-[var(--page-width)] gap-0 px-6 py-12 md:grid-cols-[0.9fr_1.1fr] md:py-16">
      <div class="border-b border-border-hairline pb-10 md:border-b-0 md:border-r md:pr-10">
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.newsletter_heading | default: 'The drop list' }}</span>
        <h2 class="mt-3 font-display text-h1 uppercase text-text-strong">{{ s.cta_heading | default: 'Stay in the system' }}</h2>
        {%- form 'customer', class: 'mt-8 flex flex-col gap-3' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="Footer-email-{{ section.id }}" class="sr-only">{{ 'newsletter.label' | t | default: 'Email' }}</label>
          <div class="flex gap-2">
            <input id="Footer-email-{{ section.id }}" type="email" name="contact[email]" required placeholder="you@domain.com" class="min-w-0 flex-1 border border-border-strong bg-transparent px-4 py-3 font-mono text-sm text-text-strong outline-none placeholder:text-text-muted focus-visible:border-accent">
            {%- render 'button', label: 'Join', type: 'submit', size: 'md' -%}
          </div>
          <p class="font-mono text-xs text-text-muted">{{ s.tagline | default: 'No noise. Drops, restocks, field notes.' }}</p>
        {%- endform -%}
      </div>
      <div class="grid gap-8 pt-10 md:grid-cols-3 md:pl-10 md:pt-0">
        <nav aria-label="Footer" class="flex flex-col gap-3">
          <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.menu_heading | default: 'Shop' }}</span>
          {%- for link in menu.links -%}
            <a href="{{ link.url }}" class="text-sm text-text-body transition-colors hover:text-text-strong">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
        <div class="flex flex-col gap-3">
          <span class="font-mono text-xs uppercase tracking-label text-text-muted">Support</span>
          <a href="/pages/contact" class="text-sm text-text-body transition-colors hover:text-text-strong">Contact</a>
          <a href="/pages/shipping" class="text-sm text-text-body transition-colors hover:text-text-strong">Shipping &amp; returns</a>
          <a href="/pages/faq" class="text-sm text-text-body transition-colors hover:text-text-strong">FAQ</a>
        </div>
        <div class="flex flex-col gap-3">
          <span class="font-mono text-xs uppercase tracking-label text-text-muted">Region</span>
          <span class="text-sm text-text-body">{{ localization.country.name }} · {{ localization.country.currency.iso_code }}</span>
          <span class="text-sm text-text-body">{{ localization.language.endonym_name }}</span>
        </div>
      </div>
    </div>
  {%- else -%}
  <div class="border-b border-border-hairline">
    <div class="mx-auto grid max-w-[var(--page-width)] gap-8 px-6 py-14 md:grid-cols-[1.25fr_1fr] md:items-end md:py-16">
      <div>
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.newsletter_heading | default: 'The drop list' }}</span>
        <h2 class="mt-3 font-display text-display-2 uppercase text-text-strong">{{ s.cta_heading | default: 'Stay in the system' }}</h2>
      </div>
      {%- form 'customer', class: 'flex flex-col gap-3' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="Footer-email-{{ section.id }}" class="sr-only">{{ 'newsletter.label' | t | default: 'Email' }}</label>
        {%- if form.posted_successfully? -%}
          <p class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'newsletter.success' | t | default: 'Thanks for subscribing.' }}</p>
        {%- else -%}
          <div class="flex gap-2">
            <input id="Footer-email-{{ section.id }}" type="email" name="contact[email]" required placeholder="you@domain.com" class="min-w-0 flex-1 border border-border-strong bg-transparent px-4 py-3 font-mono text-sm text-text-strong outline-none placeholder:text-text-muted focus-visible:border-accent">
            {%- render 'button', label: 'Subscribe', type: 'submit', size: 'md' -%}
          </div>
        {%- endif -%}
        <p class="font-mono text-xs text-text-muted">{{ s.tagline | default: 'No noise. Drops, restocks, field notes.' }}</p>
      {%- endform -%}
    </div>
  </div>

  <div class="border-b border-border-hairline">
    <div class="mx-auto grid max-w-[var(--page-width)] gap-8 px-6 py-12 md:grid-cols-4">
      <nav aria-label="Footer" class="flex flex-col gap-3">
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.menu_heading | default: 'Shop' }}</span>
        {%- for link in menu.links -%}
          <a href="{{ link.url }}" class="text-sm text-text-body transition-colors hover:text-text-strong">{{ link.title }}</a>
        {%- endfor -%}
      </nav>

      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">Support</span>
        <a href="/pages/contact" class="text-sm text-text-body transition-colors hover:text-text-strong">Contact</a>
        <a href="/pages/shipping" class="text-sm text-text-body transition-colors hover:text-text-strong">Shipping &amp; returns</a>
        <a href="/pages/faq" class="text-sm text-text-body transition-colors hover:text-text-strong">FAQ</a>
        <a href="/pages/warranty" class="text-sm text-text-body transition-colors hover:text-text-strong">Warranty</a>
      </div>

      <div class="flex flex-col gap-3">
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">Follow</span>
        {%- if s.show_social -%}
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank">Instagram</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank">TikTok</a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank">YouTube</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank">Facebook</a>{%- endif -%}
          {%- if settings.social_x != blank -%}<a href="{{ settings.social_x }}" class="text-sm text-text-body transition-colors hover:text-text-strong" rel="noopener" target="_blank"><span>X</span></a>{%- endif -%}
        {%- endif -%}
        {%- if s.enable_follow_on_shop -%}
          <follow-on-shop shop-id="{{ shop.id }}"></follow-on-shop>
        {%- endif -%}
      </div>

      {%- if s.enable_country_selector or s.enable_language_selector -%}
        <div class="flex flex-col gap-3 md:items-end">
          <span class="font-mono text-xs uppercase tracking-label text-text-muted">Region</span>
          {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
            {%- form 'localization', id: 'FooterLoc-' | append: section.id, class: 'flex flex-col gap-2 font-mono text-xs uppercase tracking-label md:items-end' -%}
              {%- if s.enable_country_selector and localization.available_countries.size > 1 -%}
                <select name="country_code" aria-label="Country/region" class="bg-transparent text-text-body" onchange="this.form.submit()">
                  {%- for country in localization.available_countries -%}
                    <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} {{ country.currency.iso_code }}</option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
              {%- if s.enable_language_selector and localization.available_languages.size > 1 -%}
                <select name="locale_code" aria-label="Language" class="bg-transparent text-text-body" onchange="this.form.submit()">
                  {%- for language in localization.available_languages -%}
                    <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
              <noscript><button type="submit" class="underline underline-offset-4">Update</button></noscript>
            {%- endform -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div aria-hidden="true" class="overflow-hidden border-b border-border-hairline px-6">
    <div class="mx-auto max-w-[var(--page-width)]">
      <span class="block select-none whitespace-normal font-display text-[clamp(2.5rem,11vw,17rem)] font-bold uppercase leading-[0.85] tracking-[-0.04em] text-text-strong md:whitespace-nowrap md:leading-[0.78] md:tracking-[-0.05em]">{{ shop.name }}<span class="text-accent">.</span></span>
    </div>
  </div>

  <div class="mx-auto flex max-w-[var(--page-width)] flex-col items-center justify-between gap-3 px-6 py-5 font-mono text-xs text-text-muted md:flex-row">
    <span>&copy; {{ shop.name }}. Engineered for movement.</span>
    {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="flex flex-wrap items-center gap-2">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'h-6 w-auto' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "class": "section section--footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "t:sections.footer.settings.tagline.label",
      "default": "Engineered for movement."
    },
    {
      "type": "select",
      "id": "footer_style",
      "label": "Footer style",
      "default": "system",
      "options": [
        {
          "value": "system",
          "label": "System"
        },
        {
          "value": "editorial",
          "label": "Editorial masthead"
        },
        {
          "value": "compact",
          "label": "Compact utility"
        },
        {
          "value": "split",
          "label": "Split conversion"
        }
      ]
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "t:sections.footer.settings.menu_heading.label",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.footer.settings.menu.label",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.footer.settings.newsletter_heading.label",
      "default": "The drop list"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "t:sections.footer.settings.cta_heading.label",
      "default": "Stay in the system"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.footer.settings.show_social.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "label": "t:sections.footer.settings.enable_follow_on_shop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "t:sections.footer.settings.enable_country_selector.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "t:sections.footer.settings.enable_language_selector.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.footer.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__2.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.footer.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.footer.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.presets.name"
    }
  ]
}
{% endschema %}
