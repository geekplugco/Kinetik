{%- liquid
  assign show_filter = section.settings.enable_filtering
  assign show_sort = section.settings.enable_sorting
  assign cols = section.settings.columns_desktop | default: 4
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign promo_enable = section.settings.promo_enable
  assign promo_position = section.settings.promo_position | default: 3
  assign filter_style = section.settings.filter_style | default: 'command'
  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
-%}
{%- paginate collection.products by 50 -%}
  <section
    data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
    style="--cols-desktop:{{ cols }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
    class="mx-auto max-w-[var(--page-width)] px-6"
  >
    <collection-facets>
      <header class="flex flex-col gap-2 border-b border-border-hairline pb-8">
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">Collection</span>
        <h1 class="font-display text-h1 tracking-tight text-text-strong">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="max-w-prose text-body text-text-muted">{{ collection.description }}</div>
        {%- endif -%}
      </header>

      {%- if show_filter or show_sort -%}
        <form data-facet-form action="{{ collection.url }}" method="get" class="contents">
        <div class="flex flex-wrap items-center justify-between gap-4 py-6">
          {%- if show_filter -%}
            <div class="flex flex-wrap items-center gap-3">
              <button type="button" data-facet-open class="inline-flex min-h-[44px] items-center gap-2 border border-border-strong px-4 py-2 font-mono text-xs uppercase tracking-label text-text-strong transition-colors hover:bg-surface-sunken">
                Filters
                {%- if active_filter_count > 0 -%}<span class="bg-accent px-1.5 py-0.5 text-accent-ink">{{ active_filter_count }}</span>{%- endif -%}
              </button>
              {%- if active_filter_count > 0 -%}
                <a href="{{ collection.url }}{% if sort_by != blank %}?sort_by={{ sort_by | url_encode }}{% endif %}" class="font-mono text-xs uppercase tracking-label text-text-muted underline underline-offset-4 hover:text-text-strong">Clear all</a>
              {%- endif -%}
            </div>
          {%- else -%}
            <span></span>
          {%- endif -%}
          {%- if show_sort -%}
            <label class="flex items-center gap-2 font-mono text-xs uppercase tracking-label text-text-muted">
              Sort
              <select name="sort_by" data-sort class="min-h-[44px] border border-border-strong bg-surface-page px-3 py-2 text-text-strong">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </label>
          {%- endif -%}
        </div>

        {%- if show_filter -%}
          <div data-facet-overlay class="pointer-events-none fixed inset-0 kx-z-overlay bg-ink-950/70 opacity-0 transition-opacity motion-reduce:transition-none" aria-hidden="true"></div>
          <aside data-facet-panel role="dialog" aria-modal="true" aria-label="Collection filters" class="fixed inset-y-0 right-0 kx-z-drawer flex w-[94vw] translate-x-full flex-col border-l border-border-hairline bg-surface-page transition-transform duration-300 motion-reduce:transition-none {% if filter_style == 'rail' %}max-w-[min(760px,94vw)] shadow-[-40px_0_90px_-48px_rgba(10,10,10,0.85)] md:grid md:grid-cols-[180px_1fr]{% else %}max-w-[460px] shadow-[-24px_0_60px_-36px_rgba(10,10,10,0.65)]{% endif %}">
            {%- if filter_style == 'rail' -%}
              <div class="hidden border-r border-border-hairline bg-ink-950 p-5 text-paper md:flex md:flex-col md:justify-between">
                <div>
                  <span class="font-mono text-[10px] uppercase tracking-label text-paper/55">Filter command</span>
                  <p class="mt-4 font-display text-h3 uppercase leading-none tracking-tight">{{ collection.title }}</p>
                </div>
                <div class="font-mono text-[10px] uppercase tracking-label text-paper/55">
                  <p>{{ collection.products_count }} products</p>
                  <p class="mt-2 text-accent">{{ active_filter_count }} active</p>
                </div>
              </div>
              <div class="flex min-h-0 flex-col">
            {%- endif -%}
            <div class="border-b border-border-hairline px-5 py-4{% if filter_style == 'rail' %} bg-surface-raised/70 md:px-6{% endif %}">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <span class="font-mono text-xs uppercase tracking-label text-text-muted">Collection filters</span>
                  <p class="mt-1 font-display text-h4 tracking-tight text-text-strong">{{ collection.title }}</p>
                </div>
                <button type="button" data-facet-close aria-label="Close filters" class="flex h-11 w-11 shrink-0 items-center justify-center border border-border-hairline text-text-strong transition-colors hover:border-border-strong">×</button>
              </div>
              <div class="mt-4 flex items-center justify-between gap-3 font-mono text-[11px] uppercase tracking-label text-text-muted">
                <span>{{ collection.products_count }} products</span>
                {%- if active_filter_count > 0 -%}
                  <a href="{{ collection.url }}{% if sort_by != blank %}?sort_by={{ sort_by | url_encode }}{% endif %}" class="text-text-strong underline underline-offset-4 hover:text-accent-press">Clear all</a>
                {%- endif -%}
              </div>
            </div>
            <div class="flex-1 overflow-y-auto px-5{% if filter_style == 'rail' %} md:px-6{% endif %}">
              {%- render 'facets-panel', collection: collection -%}
            </div>
            <div class="grid grid-cols-2 gap-2 border-t border-border-hairline p-5{% if filter_style == 'rail' %} md:p-6{% endif %}">
              <button type="button" data-facet-close class="inline-flex min-h-[44px] items-center justify-center border border-border-strong px-5 py-3 font-mono text-xs uppercase tracking-label text-text-strong transition-colors hover:bg-surface-sunken">Close</button>
              <button type="submit" class="inline-flex min-h-[44px] items-center justify-center bg-accent px-5 py-3 font-mono text-xs uppercase tracking-label text-accent-ink transition-colors hover:bg-accent-hover">Apply</button>
            </div>
            {%- if filter_style == 'rail' -%}
              </div>
            {%- endif -%}
          </aside>

          {%- if active_filter_count > 0 -%}
            <div class="flex flex-wrap gap-2 pb-6">
              {%- for filter in collection.filters -%}
                {%- for value in filter.active_values -%}
                  <a href="{{ value.url_to_remove }}" class="inline-flex min-h-8 items-center gap-2 border border-border-hairline px-2 py-1 font-mono text-[11px] uppercase tracking-label text-text-strong">{{ value.label }} <span aria-hidden="true">×</span></a>
                {%- endfor -%}
                {%- assign has_price_filter = false -%}
                {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                  {%- assign has_price_filter = true -%}
                {%- endif -%}
                {%- if filter.type == 'price_range' and has_price_filter -%}
                  <a href="{{ filter.url_to_remove }}" class="inline-flex min-h-8 items-center gap-2 border border-border-hairline px-2 py-1 font-mono text-[11px] uppercase tracking-label text-text-strong">Price <span aria-hidden="true">×</span></a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
        </form>
      {%- endif -%}

      <p class="mb-6 font-mono text-xs text-text-muted" data-count>{{ collection.products_count }} products</p>

      <div data-grid class="grid grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-[repeat(var(--cols-desktop,4),minmax(0,1fr))]">
        {%- for product in collection.products -%}
          {%- if promo_enable and section.settings.promo_link != blank and paginate.current_page == 1 and forloop.index == promo_position -%}
            {%- assign pm = section.settings -%}
            <a href="{{ pm.promo_link }}" class="group relative flex aspect-[4/5] flex-col justify-end overflow-hidden border border-border-strong bg-ink-950 p-5 text-paper">
              {%- if pm.promo_image != blank -%}
                <div class="kx-media-effect absolute inset-0">
                  {%- assign pm_alt = pm.promo_image.alt | default: pm.promo_heading | default: 'Featured' -%}
                  {{ pm.promo_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width:990px) 25vw, 50vw', alt: pm_alt, class: 'h-full w-full object-cover' }}
                </div>
                <div class="absolute inset-0 z-[2] bg-gradient-to-t from-ink-950/90 via-ink-950/20 to-transparent" aria-hidden="true"></div>
              {%- endif -%}
              <div class="relative z-[3] flex flex-col gap-1.5">
                {%- if pm.promo_eyebrow != blank -%}<span class="font-mono text-[10px] uppercase tracking-label text-accent">{{ pm.promo_eyebrow }}</span>{%- endif -%}
                {%- if pm.promo_heading != blank -%}<span class="font-display text-h4 uppercase leading-[0.95]">{{ pm.promo_heading }}</span>{%- endif -%}
                {%- if pm.promo_button_label != blank -%}<span class="mt-1 inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-label group-hover:text-accent">{{ pm.promo_button_label }}<span class="transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none">{%- render 'icon', name: 'arrow', size: 12 -%}</span></span>{%- endif -%}
              </div>
            </a>
          {%- endif -%}
          {%- liquid
            assign pc_colors = ''
            assign pc_sizes = ''
            for option in product.options_with_values
              assign oname = option.name | downcase
              if oname contains 'color' or oname contains 'colour'
                assign pc_colors = option.values | join: '|'
              elsif oname contains 'size'
                assign pc_sizes = option.values | join: '|'
              endif
            endfor
          -%}
          <div data-product-item data-option-color="{{ pc_colors }}" data-option-size="{{ pc_sizes }}">
            {%- render 'product-card', product: product -%}
          </div>
        {%- else -%}
          <div class="col-span-full border border-border-hairline px-6 py-12 text-center">
            <p class="font-display text-h3 text-text-strong">No products match this setup.</p>
            <p class="mx-auto mt-2 max-w-md text-sm text-text-muted">Clear filters or browse the full collection to reset the grid.</p>
            <a href="{{ collection.url }}" class="mt-5 inline-flex min-h-[44px] items-center justify-center border border-border-strong px-5 py-2 font-mono text-xs uppercase tracking-label text-text-strong">Clear filters</a>
          </div>
        {%- endfor -%}
      </div>
      {%- if show_filter -%}
        <button type="button" data-facet-open aria-label="Open filters and sort" class="fixed bottom-5 left-1/2 kx-z-sticky flex min-h-[44px] -translate-x-1/2 items-center gap-2 border border-border-strong bg-surface-page px-5 py-2.5 font-mono text-xs uppercase tracking-label text-text-strong shadow-[var(--shadow-pop)] md:hidden">Filter &amp; sort{%- if active_filter_count > 0 -%}<span class="bg-accent px-1.5 py-0.5 text-accent-ink">{{ active_filter_count }}</span>{%- endif -%}</button>
      {%- endif -%}
    </collection-facets>

    {%- if paginate.pages > 1 -%}
      <nav class="mt-10 font-mono text-xs uppercase tracking-label" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </section>
{%- endpaginate -%}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "t:sections.main-collection.name",
  "tag": "section",
  "class": "section section--main-collection",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main-collection.settings.enable_filtering.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main-collection.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_style",
      "label": "Filter drawer style",
      "default": "command",
      "options": [
        {
          "value": "command",
          "label": "Command drawer"
        },
        {
          "value": "rail",
          "label": "Technical rail"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-collection.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Promo tile"
    },
    {
      "type": "checkbox",
      "id": "promo_enable",
      "label": "Show a promo tile in the grid",
      "default": false
    },
    {
      "type": "range",
      "id": "promo_position",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3,
      "label": "Grid position",
      "info": "Inserts the tile before this product (page 1 only)."
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Promo image"
    },
    {
      "type": "text",
      "id": "promo_eyebrow",
      "label": "Promo eyebrow"
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Promo heading",
      "default": "New drop"
    },
    {
      "type": "text",
      "id": "promo_button_label",
      "label": "Promo button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Promo link"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-collection.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-collection.settings.padding_bottom.label"
    }
  ]
}
{% endschema %}
