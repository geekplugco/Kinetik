<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="mx-auto max-w-[var(--page-width)] px-6"
>
  <header class="grid gap-6 border-y border-border-hairline py-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ shop.name }} &middot; Journal</span>
      <h1 class="mt-3 font-display text-h1 tracking-tight text-text-strong">{{ blog.title }}</h1>
    </div>
    <div class="grid grid-cols-2 border border-border-hairline font-mono text-[10px] uppercase tracking-label text-text-muted md:min-w-56">
      <span class="border-r border-border-hairline p-3">{{ blog.articles_count }} posts</span>
      <span class="p-3 text-text-strong">Field notes</span>
    </div>
  </header>

  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      {%- assign featured = blog.articles.first -%}
      <article class="mt-10 grid border border-border-hairline md:grid-cols-[1.15fr_0.85fr]">
        <a href="{{ featured.url }}" class="kx-media-effect relative aspect-[16/10] overflow-hidden bg-surface-sunken md:aspect-auto" {% render 'media-effect' %} aria-label="{{ featured.title | escape }}">
          {%- if featured.image -%}
            {{ featured.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1400', sizes: '(min-width:990px) 55vw, 100vw', alt: featured.title, class: 'absolute inset-0 h-full w-full object-cover' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-border-hairline' }}
          {%- endif -%}
        </a>
        <div class="flex flex-col justify-center gap-4 border-t border-border-hairline p-5 md:border-l md:border-t-0 md:p-8">
          <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ featured.published_at | date: '%b %d, %Y' }}{% if featured.author != blank %} &middot; {{ featured.author }}{% endif %}</span>
          <a href="{{ featured.url }}" class="font-display text-h2 tracking-tight text-text-strong hover:text-accent-press">{{ featured.title }}</a>
          {%- if featured.excerpt_or_content != blank -%}
            <p class="max-w-xl text-body text-text-muted">{{ featured.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
          {%- endif -%}
          <a href="{{ featured.url }}" class="inline-flex min-h-[44px] items-center gap-2 self-start border border-border-strong px-4 py-2 font-mono text-xs uppercase tracking-label text-text-strong transition-colors hover:bg-surface-sunken">Read note <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <ul class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 md:grid-cols-3">
        {%- for article in blog.articles -%}
          {%- if forloop.first -%}{%- continue -%}{%- endif -%}
          {%- assign article_alt = article.title | escape -%}
          <li>
            <article class="group flex h-full flex-col gap-3 border-t border-border-hairline pt-4">
              <a href="{{ article.url }}" class="kx-media-effect relative block aspect-[3/2] overflow-hidden bg-surface-sunken" {% render 'media-effect' %} aria-label="{{ article_alt }}">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(min-width:990px) 33vw, (min-width:750px) 50vw, 100vw', alt: article_alt, class: 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'h-full w-full object-cover text-border-hairline' }}
                {%- endif -%}
              </a>
              <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ article.published_at | date: '%b %d, %Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}</span>
              <a href="{{ article.url }}" class="font-display text-h4 tracking-tight text-text-strong transition-colors group-hover:text-accent-press">{{ article.title }}</a>
              {%- if article.excerpt_or_content != blank -%}
                <p class="text-sm text-text-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              {%- endif -%}
              {%- if article.tags.size > 0 -%}
                <div class="mt-1 flex flex-wrap gap-2">
                  {%- for tag in article.tags limit: 3 -%}
                    {%- render 'tag', label: tag -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="mt-12 flex justify-center font-mono text-xs uppercase tracking-label text-text-muted" aria-label="Pagination">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="mt-10 grid overflow-hidden border border-border-hairline md:grid-cols-[0.9fr_1.1fr]">
        <div class="flex min-h-[360px] flex-col justify-between bg-ink-950 p-6 text-paper md:p-8">
          <div>
            <span class="font-mono text-xs uppercase tracking-label text-accent">{{ section.settings.empty_eyebrow }}</span>
            <p class="mt-4 max-w-lg font-display text-h2 uppercase leading-none tracking-tight">{{ section.settings.empty_heading }}</p>
            <p class="mt-5 max-w-md text-body text-paper/70">{{ section.settings.empty_text }}</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            {%- if section.settings.empty_button_label != blank and section.settings.empty_button_link != blank -%}
              <a href="{{ section.settings.empty_button_link }}" class="inline-flex min-h-[44px] items-center justify-center bg-accent px-5 py-3 font-mono text-xs uppercase tracking-label text-accent-ink transition-colors hover:bg-accent-hover">{{ section.settings.empty_button_label }}</a>
            {%- endif -%}
            {%- if section.settings.empty_secondary_label != blank and section.settings.empty_secondary_link != blank -%}
              <a href="{{ section.settings.empty_secondary_link }}" class="inline-flex min-h-[44px] items-center justify-center border border-paper/55 px-5 py-3 font-mono text-xs uppercase tracking-label text-paper transition-colors hover:border-paper">{{ section.settings.empty_secondary_label }}</a>
            {%- endif -%}
          </div>
        </div>
        <div class="grid bg-surface-page sm:grid-cols-3">
          {%- assign demo_notes = 'Material brief|How the shell system handles rain, pack weight, and the first mile.|Transit test|Pocket access, strap position, and audio under a hood.|Care log|Wash cycles, repair points, and what changes after thirty wears.' | split: '|' -%}
          {%- for i in (0..2) -%}
            {%- assign title_index = i | times: 2 -%}
            {%- assign text_index = title_index | plus: 1 -%}
            <article class="flex min-h-[360px] flex-col justify-between border-b border-border-hairline p-5 sm:border-b-0 sm:border-l">
              <div class="relative aspect-[4/5] overflow-hidden bg-surface-sunken">
                <span class="absolute inset-5 border border-border-hairline"></span>
                <span class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-border-hairline"></span>
                <span class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-border-hairline"></span>
                <span class="absolute bottom-5 left-5 font-mono text-[10px] uppercase tracking-label text-text-muted">Frame 0{{ forloop.index }}</span>
              </div>
              <div class="mt-5">
                <span class="font-mono text-[10px] uppercase tracking-label text-text-muted">Field note</span>
                <p class="mt-2 font-display text-h4 tracking-tight text-text-strong">{{ demo_notes[title_index] }}</p>
                <p class="mt-2 text-sm text-text-muted">{{ demo_notes[text_index] }}</p>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section section--main-blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-blog.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header__empty.content"
    },
    {
      "type": "text",
      "id": "empty_eyebrow",
      "label": "t:sections.main-blog.settings.empty_eyebrow.label",
      "default": "Journal setup"
    },
    {
      "type": "inline_richtext",
      "id": "empty_heading",
      "label": "t:sections.main-blog.settings.empty_heading.label",
      "default": "Field notes are ready for your first post"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "t:sections.main-blog.settings.empty_text.label",
      "default": "Use the journal for launch notes, material proof, fit guides, care stories, and behind-the-scenes release content."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "t:sections.main-blog.settings.empty_button_label.label",
      "default": "Shop the system"
    },
    {
      "type": "url",
      "id": "empty_button_link",
      "label": "t:sections.main-blog.settings.empty_button_link.label"
    },
    {
      "type": "text",
      "id": "empty_secondary_label",
      "label": "t:sections.main-blog.settings.empty_secondary_label.label",
      "default": "Open lookbook"
    },
    {
      "type": "url",
      "id": "empty_secondary_link",
      "label": "t:sections.main-blog.settings.empty_secondary_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-blog.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-blog.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-blog.presets.name"
    }
  ]
}
{% endschema %}
