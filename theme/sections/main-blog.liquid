<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="mx-auto max-w-[var(--page-width)] px-6"
>
  <header class="flex flex-col gap-3 border-b border-border-hairline pb-8">
    <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ shop.name }} &middot; Journal</span>
    <h1 class="font-display text-h1 tracking-tight text-text-strong">{{ blog.title }}</h1>
  </header>

  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      <ul class="mt-10 grid gap-10 sm:grid-cols-2 md:grid-cols-3">
        {%- for article in blog.articles -%}
          {%- assign article_alt = article.title | escape -%}
          <li>
            <article class="group flex flex-col gap-3">
              <a href="{{ article.url }}" class="kx-media-effect relative block aspect-[3/2] overflow-hidden bg-surface-sunken" data-kx-effect="proof" aria-label="{{ article_alt }}">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(min-width:990px) 33vw, (min-width:750px) 50vw, 100vw', alt: article_alt, class: 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'h-full w-full object-cover text-border-hairline' }}
                {%- endif -%}
              </a>
              <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ article.published_at | date: '%b %d, %Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}</span>
              <a href="{{ article.url }}" class="font-display text-h4 tracking-tight text-text-strong transition-colors group-hover:text-accent-press">{{ article.title }}</a>
              {%- if article.excerpt_or_content != blank -%}
                <p class="text-sm text-text-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              {%- endif -%}
              {%- if article.tags.size > 0 -%}
                <div class="mt-1 flex flex-wrap gap-2">
                  {%- for tag in article.tags limit: 3 -%}
                    {%- render 'tag', label: tag -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="mt-12 flex justify-center font-mono text-xs uppercase tracking-label text-text-muted" aria-label="Pagination">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="mt-10 text-body text-text-muted">No articles yet.</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section section--main-blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-blog.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-blog.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-blog.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-blog.presets.name"
    }
  ]
}
{% endschema %}
