<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="mx-auto max-w-[var(--page-width)] px-6"
>
  <header class="grid gap-6 border-y border-border-hairline py-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ shop.name }} &middot; Journal</span>
      <h1 class="mt-3 font-display text-h1 tracking-tight text-text-strong">{{ blog.title }}</h1>
    </div>
    <div class="grid grid-cols-2 border border-border-hairline font-mono text-[10px] uppercase tracking-label text-text-muted md:min-w-56">
      <span class="border-r border-border-hairline p-3">{{ blog.articles_count }} posts</span>
      <span class="p-3 text-text-strong">Field notes</span>
    </div>
  </header>

  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      {%- assign featured = blog.articles.first -%}
      <article class="mt-10 grid border border-border-hairline md:grid-cols-[1.15fr_0.85fr]">
        <a href="{{ featured.url }}" class="kx-media-effect relative aspect-[16/10] overflow-hidden bg-surface-sunken md:aspect-auto" data-kx-effect="proof" aria-label="{{ featured.title | escape }}">
          {%- if featured.image -%}
            {{ featured.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600,900,1200,1400', sizes: '(min-width:990px) 55vw, 100vw', alt: featured.title, class: 'absolute inset-0 h-full w-full object-cover' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-border-hairline' }}
          {%- endif -%}
        </a>
        <div class="flex flex-col justify-center gap-4 border-t border-border-hairline p-5 md:border-l md:border-t-0 md:p-8">
          <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ featured.published_at | date: '%b %d, %Y' }}{% if featured.author != blank %} &middot; {{ featured.author }}{% endif %}</span>
          <a href="{{ featured.url }}" class="font-display text-h2 tracking-tight text-text-strong hover:text-accent-press">{{ featured.title }}</a>
          {%- if featured.excerpt_or_content != blank -%}
            <p class="max-w-xl text-body text-text-muted">{{ featured.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
          {%- endif -%}
          <a href="{{ featured.url }}" class="inline-flex min-h-[44px] items-center gap-2 self-start border border-border-strong px-4 py-2 font-mono text-xs uppercase tracking-label text-text-strong transition-colors hover:bg-surface-sunken">Read note <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <ul class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 md:grid-cols-3">
        {%- for article in blog.articles -%}
          {%- if forloop.first -%}{%- continue -%}{%- endif -%}
          {%- assign article_alt = article.title | escape -%}
          <li>
            <article class="group flex h-full flex-col gap-3 border-t border-border-hairline pt-4">
              <a href="{{ article.url }}" class="kx-media-effect relative block aspect-[3/2] overflow-hidden bg-surface-sunken" data-kx-effect="proof" aria-label="{{ article_alt }}">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(min-width:990px) 33vw, (min-width:750px) 50vw, 100vw', alt: article_alt, class: 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'h-full w-full object-cover text-border-hairline' }}
                {%- endif -%}
              </a>
              <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ article.published_at | date: '%b %d, %Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}</span>
              <a href="{{ article.url }}" class="font-display text-h4 tracking-tight text-text-strong transition-colors group-hover:text-accent-press">{{ article.title }}</a>
              {%- if article.excerpt_or_content != blank -%}
                <p class="text-sm text-text-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              {%- endif -%}
              {%- if article.tags.size > 0 -%}
                <div class="mt-1 flex flex-wrap gap-2">
                  {%- for tag in article.tags limit: 3 -%}
                    {%- render 'tag', label: tag -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="mt-12 flex justify-center font-mono text-xs uppercase tracking-label text-text-muted" aria-label="Pagination">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="mt-10 border border-border-hairline p-8 text-center">
        <p class="font-display text-h3 text-text-strong">No articles yet.</p>
        <p class="mt-2 text-body text-text-muted">Publish a field note to populate this journal.</p>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section section--main-blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-blog.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-blog.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-blog.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-blog.presets.name"
    }
  ]
}
{% endschema %}
