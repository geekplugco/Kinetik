{%- liquid
  assign s = section.settings
  assign mcount = 0
  for block in section.blocks
    if block.type == 'message'
      assign mcount = mcount | plus: 1
    endif
  endfor
  assign rotate = false
  if s.display == 'rotate' and mcount > 1
    assign rotate = true
  endif
  assign delay = s.rotate_speed | default: 4 | times: 1000
  case s.text_alignment
    when 'left'
      assign align_class = 'justify-start text-left'
    when 'right'
      assign align_class = 'justify-end text-right'
    else
      assign align_class = 'justify-center text-center'
  endcase
  assign full = false
  if s.width == 'full'
    assign full = true
  endif
-%}
<announcement-bar
  role="region"
  aria-label="Announcement"
  data-rotate="{% if rotate %}true{% else %}false{% endif %}"
  data-speed="{{ delay }}"
  data-color-scheme="{{ s.color_scheme }}"
  style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px"
  class="block bg-ink-950 pb-[var(--pb,0.5rem)] pt-[var(--pt,0.5rem)] text-paper"
>
  <div class="mx-auto flex items-center justify-between gap-6 px-6 {% if full %}max-w-none{% else %}max-w-[var(--page-width)]{% endif %}">
    {%- if s.show_localization -%}<span class="hidden w-32 md:block" aria-hidden="true"></span>{%- endif -%}
    <div class="flex flex-1 items-center gap-6 {{ align_class }}">
      {%- if mcount == 0 -%}
        <span data-ann-item class="inline-flex min-h-[44px] min-w-0 max-w-full items-center overflow-x-auto whitespace-nowrap [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"><span class="font-mono text-xs uppercase tracking-label">Free shipping on orders over $50</span></span>
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'message' -%}
            {%- if block.settings.link != blank -%}
              <a {{ block.shopify_attributes }} data-ann-item href="{{ block.settings.link }}" class="inline-flex min-h-[44px] min-w-0 max-w-full items-center overflow-x-auto whitespace-nowrap transition-opacity hover:opacity-70 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"><span class="font-mono text-xs uppercase tracking-label">{{ block.settings.text }}</span></a>
            {%- else -%}
              <span {{ block.shopify_attributes }} data-ann-item class="inline-flex min-h-[44px] min-w-0 max-w-full items-center overflow-x-auto whitespace-nowrap [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"><span class="font-mono text-xs uppercase tracking-label">{{ block.settings.text }}</span></span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if s.show_localization -%}
      <div class="hidden md:flex">
        {%- assign ann_loc_id = 'AnnLoc-' | append: section.id -%}
        {%- render 'localization-switcher', id_prefix: ann_loc_id, show_country: true, show_language: true, tone: 'dark' -%}
      </div>
    {%- endif -%}
  </div>
</announcement-bar>
<script src="{{ 'announcement-bar.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "tag": "div",
  "class": "section section--announcement",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "display",
      "label": "t:sections.announcement-bar.settings.display.label",
      "default": "static",
      "options": [
        {
          "value": "static",
          "label": "t:sections.announcement-bar.settings.display.options__1.label"
        },
        {
          "value": "rotate",
          "label": "t:sections.announcement-bar.settings.display.options__2.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.rotate_speed.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.announcement-bar.settings.text_alignment.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:sections.announcement-bar.settings.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.announcement-bar.settings.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.announcement-bar.settings.text_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.announcement-bar.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.announcement-bar.settings.width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.announcement-bar.settings.width.options__2.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "t:sections.announcement-bar.settings.show_localization.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.announcement-bar.settings.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.announcement-bar.settings.padding_top.label",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.announcement-bar.settings.padding_bottom.label",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement-bar.blocks.message.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement-bar.blocks.message.settings.text.label",
          "default": "Free shipping on orders over $50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.message.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name__1",
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  ]
}
{% endschema %}
