{%- assign field = 'border border-border-strong bg-transparent px-4 py-3 text-text-strong outline-none transition-colors focus-visible:border-accent' -%}
<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="mx-auto max-w-[420px] px-6"
>
  <h1 class="font-display text-h1 tracking-tight text-text-strong">{{ 'customer.register.title' | t | default: 'Create account' }}</h1>
  {%- form 'create_customer', class: 'mt-8 grid gap-4' -%}
    {%- if form.errors -%}
      <div class="border border-state-error px-4 py-3 text-sm text-state-error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="grid gap-1">
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'customer.register.first_name' | t | default: 'First name' }}</span>
        <input type="text" name="customer[first_name]" autocomplete="given-name" class="{{ field }}">
      </label>
      <label class="grid gap-1">
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'customer.register.last_name' | t | default: 'Last name' }}</span>
        <input type="text" name="customer[last_name]" autocomplete="family-name" class="{{ field }}">
      </label>
    </div>
    <label class="grid gap-1">
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'customer.register.email' | t | default: 'Email' }}</span>
      <input type="email" name="customer[email]" autocomplete="email" required class="{{ field }}">
    </label>
    <label class="grid gap-1">
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'customer.register.password' | t | default: 'Password' }}</span>
      <input type="password" name="customer[password]" autocomplete="new-password" required class="{{ field }}">
    </label>
    <button type="submit" class="mt-2 bg-accent px-6 py-3 font-mono text-xs uppercase tracking-label text-accent-ink transition-colors hover:bg-accent-hover{% if settings.button_style == 'rounded' %} rounded-full{% endif %}">{{ 'customer.register.submit' | t | default: 'Create account' }}</button>
  {%- endform -%}
  <a href="{{ routes.account_login_url }}" class="mt-6 inline-flex font-mono text-xs uppercase tracking-label text-text-muted transition-colors hover:text-text-strong">Already have an account? <span class="ml-1 text-text-strong underline underline-offset-4">{{ 'customer.login.sign_in' | t | default: 'Sign in' }}</span></a>
</section>
{% schema %}
{
  "name": "t:sections.main-register.name",
  "tag": "section",
  "class": "section section--main-register",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-register.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-register.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-register.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-register.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-register.presets.name"
    }
  ]
}
{% endschema %}
