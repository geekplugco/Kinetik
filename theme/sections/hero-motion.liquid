{%- liquid
  assign s = section.settings
  assign media_blocks = section.blocks | where: 'type', 'media'
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign heading_text = s.heading | default: 'Built for the next condition' | escape
  assign words = heading_text | split: ' '
  assign rotate_s = s.auto_rotate | default: 6
  assign overlay_pct = s.overlay_opacity | default: 35
  assign frame = s.frame_style
  if frame == blank or frame == 'default'
    if settings.media_effect == 'none'
      assign frame = 'none'
    else
      assign frame = 'both'
    endif
  endif
  assign btn_label = s.button_label | default: 'Shop the drop'
  assign btn_link = s.button_link | default: routes.all_products_collection_url

  case s.height
    when 'medium'
      assign height_cls = 'min-h-[70vh]'
    when 'large'
      assign height_cls = 'min-h-[88vh]'
    else
      assign height_cls = 'min-h-[100svh]'
  endcase

  if s.content_position == 'center'
    assign align_cls = 'items-center text-center'
    assign cta_cls = 'justify-center'
  else
    assign align_cls = 'items-start text-left'
    assign cta_cls = 'justify-start'
  endif

  assign rotating = false
  if media_blocks.size > 1 and rotate_s > 0
    assign rotating = true
  endif
-%}

<hero-motion
  data-color-scheme="{{ s.color_scheme | default: 'scheme-1' }}"
  data-parallax="{% if s.enable_parallax %}true{% else %}false{% endif %}"
  style="--pt:{{ s.padding_top | default: 0 }}px;--pb:{{ s.padding_bottom | default: 0 }}px;--hm-rotate:{{ rotate_s }}s"
  class="theme-dark relative block overflow-hidden border-b border-border-strong bg-ink-950 pb-[var(--pb,0px)] pt-[var(--pt,0px)] text-paper"
>
  <div class="relative w-full overflow-hidden bg-ink-900 {{ height_cls }}"{% if rotating %} role="region" aria-roledescription="carousel" aria-label="{{ heading_text }}"{% endif %}>
    <div class="hm-layer absolute inset-0" data-hm-layer>
      {%- if media_blocks.size > 0 -%}
        {%- for block in media_blocks -%}
          {%- liquid
            assign media_label = block.settings.label
            assign media_alt = block.settings.image.alt | default: media_label | default: heading_text | escape
          -%}
          <div
            class="hm-slide absolute inset-0 transition-opacity duration-700 {% if forloop.first %}opacity-100{% else %}pointer-events-none opacity-0{% endif %}"
            data-hm-slide
            data-label="{{ media_label | escape }}"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} / {{ forloop.length }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {%- if forloop.first -%}
                {%- if s.image_mobile != blank -%}
                  {{ s.image_mobile | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '550,750,1100', sizes: '100vw', alt: media_alt, class: 'absolute inset-0 h-full w-full object-cover md:hidden' }}
                  {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600,2000', sizes: '100vw', alt: media_alt, class: 'absolute inset-0 hidden h-full w-full object-cover md:block' }}
                {%- else -%}
                  {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600,2000', sizes: '100vw', alt: media_alt, class: 'absolute inset-0 h-full w-full object-cover' }}
                {%- endif -%}
              {%- else -%}
                {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '600,900,1200,1600,2000', sizes: '100vw', alt: media_alt, class: 'absolute inset-0 h-full w-full object-cover' }}
              {%- endif -%}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-border-hairline' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="hm-slide absolute inset-0" data-hm-slide data-label="">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-border-hairline' }}
        </div>
      {%- endif -%}
    </div>

    <div class="absolute inset-0 bg-gradient-to-t from-ink-950/85 via-ink-950/35 to-ink-950/15" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-ink-950" style="opacity:{{ overlay_pct | divided_by: 100.0 }}" aria-hidden="true"></div>

    {%- if frame == 'scanline' or frame == 'both' -%}
      <span class="hm-scan absolute inset-0 overflow-hidden" aria-hidden="true"></span>
    {%- endif -%}
    {%- if frame == 'viewfinder' or frame == 'both' -%}
      <span class="hm-frame absolute inset-4" aria-hidden="true"></span>
    {%- endif -%}

    {%- if media_blocks.size > 0 and media_blocks.first.settings.label != blank -%}
      <span class="hm-fade absolute left-5 top-5 z-10 flex items-center gap-2 font-mono text-[10px] uppercase tracking-label text-paper/85" style="--hm-d:900ms">
        <span class="h-1.5 w-1.5 bg-accent" aria-hidden="true"></span>
        <span data-hm-label>{{ media_blocks.first.settings.label }}</span>
      </span>
    {%- endif -%}

    {%- if rotating -%}
      <div class="hm-fade absolute right-5 top-5 z-10 flex items-center gap-3 font-mono text-[10px] uppercase tracking-label text-paper/80" style="--hm-d:900ms">
        <span><span data-hm-index>01</span><span class="text-paper/50"> / 0{{ media_blocks.size }}</span></span>
        <span class="hm-progress-track h-px w-16 overflow-hidden bg-paper/25"><span class="hm-progress block h-full w-full origin-left bg-accent" data-hm-progress></span></span>
      </div>
    {%- endif -%}

    <div class="absolute inset-0 z-10 mx-auto flex max-w-[var(--page-width)] flex-col justify-center gap-6 px-7 py-16 md:px-14 {{ align_cls }}{% if stat_blocks.size > 0 %} pb-32 md:pb-36{% endif %}">
      {%- if s.kicker != blank -%}
        <span class="hm-fade font-mono text-xs uppercase tracking-label text-accent" data-accent-ok style="--hm-d:420ms">{{ s.kicker }}</span>
      {%- endif -%}
      <h1 class="max-w-4xl font-display font-bold uppercase tracking-hero" style="font-size:clamp(2.75rem,7vw,5.25rem);line-height:.95;letter-spacing:-0.035em" aria-label="{{ heading_text }}">
        <span aria-hidden="true">
          {%- for word in words %}
            <span class="hm-line"><span class="hm-word" style="--hm-i:{{ forloop.index0 }}">{{ word }}</span></span>
          {%- endfor %}
        </span>
      </h1>
      {%- if s.text != blank -%}
        <div class="hm-fade max-w-md text-body-lg leading-snug text-ink-300 [&_p]:m-0" style="--hm-d:560ms">{{ s.text }}</div>
      {%- endif -%}
      <div class="hm-fade flex flex-wrap gap-3 {{ cta_cls }}" style="--hm-d:700ms">
        <span class="hm-magnet inline-flex" data-hm-magnet>{%- render 'button', label: btn_label, href: btn_link, variant: 'primary', size: 'md', icon: 'arrow', class: 'min-h-[44px] gap-3 px-8 py-4 text-sm' -%}</span>
        {%- if s.secondary_button_label != blank -%}
          <span class="hm-magnet inline-flex" data-hm-magnet><a href="{{ s.secondary_button_link | default: '#' }}" class="kx-hero-secondary inline-flex min-h-[44px] items-center justify-center px-8 py-4 font-mono text-sm uppercase tracking-wide transition-colors">{{ s.secondary_button_label }}</a></span>
        {%- endif -%}
      </div>
    </div>

    {%- if stat_blocks.size > 0 -%}
      <div class="hm-fade absolute inset-x-0 bottom-0 z-10 bg-ink-950/45 backdrop-blur-sm" style="--hm-d:850ms">
        <dl class="mx-auto grid max-w-[var(--page-width)] grid-cols-2 md:auto-cols-fr md:grid-flow-col">
          {%- for block in stat_blocks -%}
            <div class="hm-stat flex flex-col gap-1 border-t border-paper/15 px-5 py-4 md:border-l md:first:border-l-0" data-hm-stat {{ block.shopify_attributes }}>
              <dt class="flex items-center gap-2">
                <span class="hm-tick h-1.5 w-1.5 border border-accent/60" aria-hidden="true"></span>
                <span class="hm-stat-label min-w-0 overflow-x-auto whitespace-nowrap [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden font-mono text-[10px] uppercase tracking-label text-paper/60 transition-colors">{{ block.settings.label }}</span>
              </dt>
              <dd class="m-0 font-mono text-xs uppercase tracking-wide text-paper">{{ block.settings.value }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      </div>
    {%- endif -%}
  </div>
</hero-motion>

<style>
  #shopify-section-{{ section.id }} .hm-line {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  #shopify-section-{{ section.id }} hero-motion[data-color-scheme],
  #shopify-section-{{ section.id }} hero-motion h1 {
    color: var(--paper);
  }

  #shopify-section-{{ section.id }} .hm-word {
    display: inline-block;
    transform: translateY(110%);
    will-change: transform;
    animation: hmWord-{{ section.id }} 620ms var(--ease-enter, cubic-bezier(0.22, 0.61, 0.36, 1)) calc(var(--hm-i, 0) * 70ms) forwards;
  }

  #shopify-section-{{ section.id }} .hm-fade {
    opacity: 0;
    animation: hmFade-{{ section.id }} 700ms var(--ease-enter, ease) var(--hm-d, 500ms) forwards;
  }

  #shopify-section-{{ section.id }} hero-motion[data-parallax="true"] .hm-layer {
    scale: 1.05;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .hm-magnet {
    transition: transform 260ms cubic-bezier(0.34, 1.3, 0.4, 1);
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .hm-frame {
    pointer-events: none;
    opacity: 0.8;
    background:
      linear-gradient(var(--accent), var(--accent)) left top / 44px 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) left top / 2px 44px no-repeat,
      linear-gradient(var(--accent), var(--accent)) right top / 44px 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) right top / 2px 44px no-repeat,
      linear-gradient(var(--accent), var(--accent)) left bottom / 44px 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) left bottom / 2px 44px no-repeat,
      linear-gradient(var(--accent), var(--accent)) right bottom / 44px 2px no-repeat,
      linear-gradient(var(--accent), var(--accent)) right bottom / 2px 44px no-repeat;
  }

  #shopify-section-{{ section.id }} .hm-scan {
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .hm-scan::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent calc(50% - 1px), color-mix(in srgb, var(--accent) 60%, transparent) 50%, transparent calc(50% + 1px));
    opacity: 0.55;
    transform: translateY(-100%);
    will-change: transform;
    animation: hmScan-{{ section.id }} 9s linear infinite;
  }

  #shopify-section-{{ section.id }} .hm-progress {
    transform: scaleX(0);
  }

  #shopify-section-{{ section.id }} .hm-progress-run {
    animation: hmProgress-{{ section.id }} var(--hm-rotate, 6s) linear forwards;
  }

  #shopify-section-{{ section.id }} .hm-paused .hm-progress-run {
    animation-play-state: paused;
  }

  #shopify-section-{{ section.id }} .hm-tick {
    background: transparent;
    transition: background-color 240ms ease;
  }

  #shopify-section-{{ section.id }} .hm-stat[data-active] .hm-tick {
    background: var(--accent);
  }

  #shopify-section-{{ section.id }} .hm-stat[data-active] .hm-stat-label {
    color: var(--accent);
  }

  @keyframes hmWord-{{ section.id }} {
    to { transform: translateY(0); }
  }

  @keyframes hmFade-{{ section.id }} {
    to { opacity: 1; }
  }

  @keyframes hmScan-{{ section.id }} {
    to { transform: translateY(100%); }
  }

  @keyframes hmProgress-{{ section.id }} {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @media (hover: none) {
    #shopify-section-{{ section.id }} hero-motion[data-parallax="true"] .hm-layer {
      scale: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .hm-word {
      transform: none;
      animation: none;
    }

    #shopify-section-{{ section.id }} .hm-fade {
      opacity: 1;
      animation: none;
    }

    #shopify-section-{{ section.id }} .hm-scan,
    #shopify-section-{{ section.id }} .hm-progress-track {
      display: none;
    }

    #shopify-section-{{ section.id }} hero-motion[data-parallax="true"] .hm-layer {
      scale: none;
    }

    #shopify-section-{{ section.id }} .hm-magnet,
    #shopify-section-{{ section.id }} .hm-tick {
      transition: none;
    }
  }
</style>

<script src="{{ 'hero-motion.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.hero-motion.name",
  "tag": "section",
  "class": "section section--hero-motion",
  "max_blocks": 7,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero-motion.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero-motion.settings.height.label",
      "default": "full",
      "options": [
        {
          "value": "full",
          "label": "t:sections.hero-motion.settings.height.options__1.label"
        },
        {
          "value": "large",
          "label": "t:sections.hero-motion.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.hero-motion.settings.height.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.hero-motion.settings.content_position.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.hero-motion.settings.content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.hero-motion.settings.content_position.options__2.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.hero-motion.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hero-motion.settings.padding_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hero-motion.settings.padding_bottom.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.hero-motion.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "t:sections.hero-motion.settings.enable_parallax.label",
      "default": true
    },
    {
      "type": "select",
      "id": "frame_style",
      "label": "t:sections.hero-motion.settings.frame_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.hero-motion.settings.frame_style.options__1.label"
        },
        {
          "value": "viewfinder",
          "label": "t:sections.hero-motion.settings.frame_style.options__2.label"
        },
        {
          "value": "scanline",
          "label": "t:sections.hero-motion.settings.frame_style.options__3.label"
        },
        {
          "value": "both",
          "label": "t:sections.hero-motion.settings.frame_style.options__4.label"
        },
        {
          "value": "none",
          "label": "t:sections.hero-motion.settings.frame_style.options__5.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "auto_rotate",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.hero-motion.settings.auto_rotate.label",
      "info": "t:sections.hero-motion.settings.auto_rotate.info",
      "default": 6
    },
    {
      "type": "header",
      "content": "t:sections.hero-motion.settings.header__3.content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.hero-motion.settings.kicker.label",
      "default": "SS26 / Field System"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero-motion.settings.heading.label",
      "default": "Built for the next condition"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero-motion.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero-motion.settings.button_label.label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero-motion.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:sections.hero-motion.settings.secondary_button_label.label",
      "default": "Lookbook"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:sections.hero-motion.settings.secondary_button_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.hero-motion.settings.header__4.content"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:sections.hero-motion.settings.overlay_opacity.label",
      "default": 35
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.hero-motion.settings.image_mobile.label",
      "info": "t:sections.hero-motion.settings.image_mobile.info"
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "t:sections.hero-motion.blocks.media.name",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.hero-motion.blocks.media.settings.image.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.hero-motion.blocks.media.settings.label.label",
          "default": "Drop 01"
        }
      ]
    },
    {
      "type": "stat",
      "name": "t:sections.hero-motion.blocks.stat.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.hero-motion.blocks.stat.settings.label.label",
          "default": "Membrane"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.hero-motion.blocks.stat.settings.value.label",
          "default": "3L shell"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-motion.presets.name",
      "blocks": [
        {
          "type": "media",
          "settings": {
            "label": "Drop 01"
          }
        },
        {
          "type": "media",
          "settings": {
            "label": "Drop 02"
          }
        },
        {
          "type": "stat",
          "settings": {
            "label": "Membrane",
            "value": "3L shell"
          }
        },
        {
          "type": "stat",
          "settings": {
            "label": "Drop window",
            "value": "72 hours"
          }
        },
        {
          "type": "stat",
          "settings": {
            "label": "Restock",
            "value": "None planned"
          }
        }
      ]
    }
  ]
}
{% endschema %}
