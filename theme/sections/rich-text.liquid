{%- liquid
  assign s = section.settings
  case s.width
    when 'full'
      assign width = 'max-w-none'
    when 'narrow'
      assign width = 'max-w-3xl'
    else
      assign width = 'max-w-[var(--page-width)]'
  endcase
  if s.content_alignment == 'center'
    assign align = 'items-center text-center'
  else
    assign align = 'items-start text-left'
  endif
  assign panel = ''
  if s.style == 'panel'
    assign panel = 'theme-dark rounded-sm bg-surface-page p-8 md:p-14'
  endif
  assign rule = ''
  if s.style == 'accent-rule'
    assign rule = 'border-l-2 border-accent pl-6 md:pl-8'
  endif
-%}
<section
  data-color-scheme="{{ s.color_scheme }}"
  style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px"
  class="bg-surface-page pt-[var(--pt,clamp(4rem,7vw,6rem))] pb-[var(--pb,clamp(4rem,7vw,6rem))]"
>
  <div class="mx-auto px-6">
    <div class="mx-auto flex flex-col gap-4 {{ width }} {{ align }} {{ panel }} {{ rule }}">
      {%- if s.subheading != blank -%}
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.subheading }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="font-display text-h2 tracking-tight text-text-strong">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="max-w-prose text-body text-text-body">{{ s.text }}</div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "section section--rich-text",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.rich-text.settings.header__1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.rich-text.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.rich-text.settings.style.label",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "t:sections.rich-text.settings.style.options__1.label"
        },
        {
          "value": "panel",
          "label": "t:sections.rich-text.settings.style.options__2.label"
        },
        {
          "value": "accent-rule",
          "label": "t:sections.rich-text.settings.style.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.rich-text.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.rich-text.settings.width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.rich-text.settings.width.options__2.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.rich-text.settings.width.options__3.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.rich-text.settings.header__2.content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.rich-text.settings.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.rich-text.settings.heading.label",
      "default": "Rich text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.rich-text.settings.text.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.rich-text.settings.content_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.content_alignment.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.rich-text.settings.header__3.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "label": "t:sections.rich-text.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "label": "t:sections.rich-text.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name__1"
    }
  ]
}
{% endschema %}
