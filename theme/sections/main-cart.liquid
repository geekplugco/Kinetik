{%- liquid
  assign subtotal = cart.total_price
  assign threshold = section.settings.free_shipping_threshold | default: 150 | times: 100
  assign show_goal = section.settings.show_free_shipping_goal
  assign remaining = threshold | minus: subtotal
  if remaining < 0
    assign remaining = 0
  endif
  assign progress = 0
  if threshold > 0
    assign progress = subtotal | times: 100 | divided_by: threshold
  endif
  if progress > 100
    assign progress = 100
  endif
-%}
<cart-items data-section-id="{{ section.id }}" class="block">
  {%- if cart.item_count == 0 -%}
    <section
      data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
      style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
      class="mx-auto max-w-[var(--page-width)] px-6"
    >
      <div class="grid overflow-hidden border border-border-hairline md:grid-cols-[0.86fr_1.14fr]">
        <div class="flex min-h-[360px] flex-col justify-between bg-ink-950 p-6 text-paper md:p-8">
          <div>
            <span class="font-mono text-xs uppercase tracking-label text-accent">{{ section.settings.empty_eyebrow }}</span>
            <h1 class="mt-4 max-w-xl font-display text-h1 uppercase leading-none tracking-tight text-paper">{{ section.settings.empty_heading | default: 'Your cart is empty' }}</h1>
            <p class="mt-5 max-w-md text-body text-paper/70">{{ section.settings.empty_text }}</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            {%- assign continue_label = 'sections.cart.continue' | t | default: 'Continue shopping' -%}
            {%- render 'button', label: continue_label, href: routes.all_products_collection_url -%}
            {%- if section.settings.empty_secondary_label != blank and section.settings.empty_secondary_link != blank -%}
              <a href="{{ section.settings.empty_secondary_link }}" class="inline-flex min-h-[44px] items-center justify-center border border-paper/55 px-5 py-3 font-mono text-xs uppercase tracking-label text-paper transition-colors hover:border-paper">{{ section.settings.empty_secondary_label }}</a>
            {%- endif -%}
          </div>
        </div>
        <div class="grid bg-surface-page sm:grid-cols-3">
          {%- assign empty_category_blocks = section.blocks | where: 'type', 'category' -%}
          {%- if empty_category_blocks.size > 0 -%}
            {%- for block in empty_category_blocks -%}
              {%- liquid
                assign tile_collection = block.settings.collection
                assign tile_image = block.settings.image
                if tile_image == blank and tile_collection != blank
                  assign tile_image = tile_collection.featured_image
                endif
                assign tile_href = tile_collection.url
                assign tile_label = block.settings.label
                assign tile_caption = block.settings.caption
                assign tile_alt = tile_image.alt | default: tile_label | escape
                assign tile_number = forloop.index | prepend: '0' | slice: -2, 2
                assign tile_ph_index = forloop.index0 | modulo: 3 | plus: 1
                assign tile_placeholder = 'collection-' | append: tile_ph_index
              -%}
              {%- capture tile_content -%}
                <div class="relative aspect-[4/3] overflow-hidden bg-surface-sunken">
                  {%- if tile_image != blank -%}
                    {{ tile_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width:768px) 33vw, 100vw', alt: tile_alt, class: 'h-full w-full object-cover' }}
                  {%- else -%}
                    {{ tile_placeholder | placeholder_svg_tag: 'h-full w-full border border-border-hairline bg-surface-sunken object-cover text-border-hairline' }}
                  {%- endif -%}
                  <span class="absolute left-5 top-5 font-mono text-xs uppercase tracking-label text-text-muted">{{ tile_number }}</span>
                </div>
                <div class="mt-5">
                  <p class="font-display text-h4 tracking-tight text-text-strong">{{ tile_label }}</p>
                  <p class="mt-2 text-sm text-text-muted">{{ tile_caption }}</p>
                </div>
              {%- endcapture -%}
              {%- if tile_href != blank -%}
                <a href="{{ tile_href }}" {{ block.shopify_attributes }} class="group flex min-h-[300px] flex-col justify-between border-b border-border-hairline p-5 transition-colors hover:bg-surface-sunken/40 sm:border-b-0 sm:border-l">{{ tile_content }}</a>
              {%- else -%}
                <div {{ block.shopify_attributes }} class="flex min-h-[300px] flex-col justify-between border-b border-border-hairline p-5 sm:border-b-0 sm:border-l">{{ tile_content }}</div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign empty_category_fallback = '01|Shell|Weather layer|02|Carry|Daily loadout|03|Audio|Transit signal' | split: '|' -%}
            {%- for i in (0..2) -%}
              {%- liquid
                assign base = i | times: 3
                assign num_index = base
                assign title_index = base | plus: 1
                assign text_index = base | plus: 2
                assign fallback_ph_index = i | plus: 1
                assign fallback_placeholder = 'collection-' | append: fallback_ph_index
              -%}
              <div class="flex min-h-[300px] flex-col justify-between border-b border-border-hairline p-5 sm:border-b-0 sm:border-l">
                <div class="relative aspect-[4/3] overflow-hidden bg-surface-sunken">
                  {{ fallback_placeholder | placeholder_svg_tag: 'h-full w-full border border-border-hairline bg-surface-sunken object-cover text-border-hairline' }}
                  <span class="absolute left-5 top-5 font-mono text-xs uppercase tracking-label text-text-muted">{{ empty_category_fallback[num_index] }}</span>
                </div>
                <div class="mt-5">
                  <p class="font-display text-h4 tracking-tight text-text-strong">{{ empty_category_fallback[title_index] }}</p>
                  <p class="mt-2 text-sm text-text-muted">{{ empty_category_fallback[text_index] }}</p>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      {%- assign empty_collection = section.settings.empty_collection -%}
      {%- if empty_collection != blank and empty_collection.products_count > 0 -%}
        <div class="mt-10 border-t border-border-hairline pt-8">
          <div class="flex items-end justify-between gap-6">
            <div>
              <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ empty_collection.title }}</span>
              <h2 class="mt-2 font-display text-h3 tracking-tight text-text-strong">{{ section.settings.empty_collection_heading }}</h2>
            </div>
            <a href="{{ empty_collection.url }}" class="hidden min-h-[44px] items-center font-mono text-xs uppercase tracking-label text-text-strong underline underline-offset-4 hover:text-accent-press sm:inline-flex">View all</a>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-4 md:grid-cols-4">
            {%- for p in empty_collection.products limit: 4 -%}
              {%- render 'product-card', product: p -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </section>
  {%- else -%}
    <section
      data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
      style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
      class="mx-auto max-w-[900px] px-6"
    >
      <h1 class="font-display text-h1 tracking-tight text-text-strong">{{ 'sections.cart.title' | t | default: 'Cart' }}</h1>

      {%- if show_goal and threshold > 0 -%}
        <div class="mt-6 border border-border-hairline p-4">
          <p class="font-mono text-xs uppercase tracking-label text-text-muted">
            {%- if remaining > 0 -%}
              {{ remaining | money }} away from free shipping
            {%- else -%}
              You&rsquo;ve unlocked free shipping
            {%- endif -%}
          </p>
          <div class="mt-2 h-1 w-full bg-surface-sunken">
            <div class="h-full bg-accent" style="width: {{ progress }}%"></div>
          </div>
        </div>
      {%- endif -%}

      {%- form 'cart', cart -%}
        <ul class="mt-8 divide-y divide-border-hairline">
          {%- for item in cart.items -%}
            <li class="flex gap-4 py-6">
              {%- assign item_alt = item.image.alt | default: item.product.title | escape -%}
              <a href="{{ item.url }}" class="relative h-28 w-24 shrink-0 overflow-hidden bg-surface-sunken" aria-label="{{ item.product.title | escape }}">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 192 | image_tag: loading: 'lazy', widths: '96,192', sizes: '96px', alt: item_alt, class: 'h-full w-full object-cover' }}
                {%- endif -%}
              </a>
              <div class="flex flex-1 flex-col gap-2">
                <a href="{{ item.url }}" class="font-sans text-body text-text-strong hover:text-accent-press">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <span class="font-mono text-xs text-text-muted">
                    {%- for option in item.options_with_values -%}
                      {{ option.name }}: {{ option.value }}{% unless forloop.last %} &middot; {% endunless %}
                    {%- endfor -%}
                  </span>
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}
                  <div class="flex flex-col gap-0.5">
                    <span class="font-mono text-[11px] uppercase tracking-label text-accent-press">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                    {%- for selling_plan_option in item.selling_plan_allocation.selling_plan.options -%}
                      <span class="font-mono text-[11px] text-text-muted">{{ selling_plan_option.name }}: {{ selling_plan_option.value }}</span>
                    {%- endfor -%}
                    <span class="font-mono text-[11px] text-text-muted">{{ item.selling_plan_allocation.per_delivery_price | money }} per delivery</span>
                  </div>
                {%- endif -%}
                {%- if item.unit_price_measurement -%}
                  <span class="font-mono text-[11px] text-text-muted">{{ item.unit_price | money }}/{% if item.unit_price_measurement.reference_value != 1 %}{{ item.unit_price_measurement.reference_value }}{% endif %}{{ item.unit_price_measurement.reference_unit }}</span>
                {%- endif -%}
                {%- if item.line_level_discount_allocations.size > 0 -%}
                  <div class="flex flex-col gap-0.5">
                    {%- for discount_allocation in item.line_level_discount_allocations -%}
                      <span class="font-mono text-[11px] uppercase tracking-label text-accent-press">{{ discount_allocation.discount_application.title }} &minus;{{ discount_allocation.amount | money }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <div class="mt-auto flex items-center justify-between">
                  <div class="flex items-center border border-border-strong">
                    <button type="button" aria-label="Decrease quantity" data-qty-down data-line="{{ forloop.index }}" data-qty="{{ item.quantity }}" class="px-3 py-1 text-text-strong">&minus;</button>
                    <span class="w-8 text-center font-mono text-sm">{{ item.quantity }}</span>
                    <button type="button" aria-label="Increase quantity" data-qty-up data-line="{{ forloop.index }}" data-qty="{{ item.quantity }}" class="px-3 py-1 text-text-strong">+</button>
                  </div>
                  <span class="font-mono text-sm text-text-strong">{{ item.final_line_price | money }}</span>
                </div>
              </div>
              <button type="button" data-remove data-line="{{ forloop.index }}" class="self-start font-mono text-xs uppercase tracking-label text-text-muted hover:text-negative">{{ 'sections.cart.remove' | t | default: 'Remove' }}</button>
            </li>
          {%- endfor -%}
        </ul>

        <div class="mt-8 grid gap-8 border-t border-border-strong pt-8 md:grid-cols-2">
          <div class="flex flex-col gap-6">
            <div class="flex flex-col gap-2">
              <label for="cart-note" class="font-mono text-xs uppercase tracking-label text-text-muted">Order note</label>
              <textarea id="cart-note" name="note" rows="3" placeholder="Add a note to your order" class="border border-border-strong bg-surface-page px-4 py-3 font-sans text-sm text-text-strong placeholder:text-text-faint">{{ cart.note }}</textarea>
            </div>
            <details class="flex flex-col gap-2"{% if cart.attributes['Gift note'] != blank %} open{% endif %}>
              <summary class="cursor-pointer select-none font-mono text-xs uppercase tracking-label text-text-muted">This is a gift &mdash; add a note</summary>
              <textarea name="attributes[Gift note]" rows="2" placeholder="Write a gift message" class="mt-2 w-full border border-border-strong bg-surface-page px-4 py-3 font-sans text-sm text-text-strong placeholder:text-text-faint">{{ cart.attributes['Gift note'] }}</textarea>
            </details>
            <label class="flex cursor-pointer items-center gap-3 border border-border-hairline p-4">
              <input type="hidden" name="attributes[Gift wrapping]" value="">
              <input type="checkbox" name="attributes[Gift wrapping]" value="Yes"{% if cart.attributes['Gift wrapping'] == 'Yes' %} checked{% endif %} class="h-4 w-4 border border-border-strong accent-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
              <span class="font-mono text-xs uppercase tracking-label text-text-strong">Add gift wrapping</span>
            </label>
            <div class="flex flex-col gap-2">
              <span class="font-mono text-xs uppercase tracking-label text-text-muted">Discount code</span>
              <p class="font-mono text-[11px] text-text-faint">Discount codes are applied at checkout.</p>
            </div>
          </div>

          <div class="flex flex-col gap-3 md:items-end">
            <div class="flex w-full max-w-xs items-center justify-between font-mono text-sm">
              <span class="uppercase tracking-label text-text-muted">{{ 'sections.cart.subtotal' | t | default: 'Subtotal' }}</span>
              <span class="text-text-strong">{{ cart.total_price | money }}</span>
            </div>
            {%- for discount_application in cart.cart_level_discount_applications -%}
              <div class="flex w-full max-w-xs items-center justify-between font-mono text-sm">
                <span class="uppercase tracking-label text-text-muted">{{ discount_application.title }}</span>
                <span class="text-accent-press">&minus;{{ discount_application.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
            <div class="flex w-full max-w-xs items-center justify-between border-t border-border-hairline pt-3 font-mono">
              <span class="text-sm uppercase tracking-label text-text-muted">Total</span>
              <span class="text-h4 text-text-strong">{{ cart.total_price | money }}</span>
            </div>
            <p class="w-full max-w-xs text-right font-mono text-[10px] text-text-faint">{% if cart.taxes_included %}Tax included.{% endif %} Shipping calculated at checkout</p>
            {%- assign checkout_label = 'sections.cart.checkout' | t | default: 'Checkout' -%}
            {%- render 'button', label: checkout_label, type: 'submit', name: 'checkout', size: 'md', class: 'w-full max-w-xs' -%}
            {%- if additional_checkout_buttons -%}
              <div class="w-full max-w-xs">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endform -%}

      {%- if section.settings.show_recommendations and cart.items.first -%}
        {%- assign rec_source = cart.items.first.product.collections.first.products -%}
        {%- assign rec_shown = 0 -%}
        {%- capture rec_html -%}
          {%- for p in rec_source -%}
            {%- if rec_shown >= 4 -%}{%- break -%}{%- endif -%}
            {%- assign in_cart = false -%}
            {%- for item in cart.items -%}
              {%- if item.product.id == p.id -%}{%- assign in_cart = true -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- if in_cart or p.available == false -%}{%- continue -%}{%- endif -%}
            {%- assign rec_shown = rec_shown | plus: 1 -%}
            <div class="flex flex-col gap-2">
              {%- render 'product-tile-compact', product: p, image_width: 400, sizes: '(min-width:750px) 22vw, 45vw' -%}
              <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                <button type="submit" class="w-full border border-border-strong px-3 py-2 font-mono text-[11px] uppercase tracking-label text-text-strong transition-colors hover:bg-surface-sunken">Add to cart</button>
              </form>
            </div>
          {%- endfor -%}
        {%- endcapture -%}
        {%- if rec_shown > 0 -%}
          <div class="mt-12 border-t border-border-hairline pt-8">
            <h2 class="font-mono text-xs uppercase tracking-label text-text-muted">Complete your order</h2>
            <div class="mt-5 grid grid-cols-2 gap-4 md:grid-cols-4">{{ rec_html }}</div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </section>
  {%- endif -%}
</cart-items>
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "t:sections.main-cart.name",
  "tag": "section",
  "class": "section section--main-cart",
  "enabled_on": {
    "templates": [
      "cart"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_free_shipping_goal",
      "label": "t:sections.main-cart.settings.show_free_shipping_goal.label",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "default": 150,
      "label": "t:sections.main-cart.settings.free_shipping_threshold.label",
      "info": "t:sections.main-cart.settings.free_shipping_threshold.info"
    },
    {
      "type": "checkbox",
      "id": "show_recommendations",
      "label": "t:sections.main-cart.settings.show_recommendations.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main-cart.settings.header__empty.content"
    },
    {
      "type": "text",
      "id": "empty_eyebrow",
      "label": "t:sections.main-cart.settings.empty_eyebrow.label",
      "default": "System empty"
    },
    {
      "type": "inline_richtext",
      "id": "empty_heading",
      "label": "t:sections.main-cart.settings.empty_heading.label",
      "default": "Your cart is empty"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "t:sections.main-cart.settings.empty_text.label",
      "default": "Start with one anchor piece, then add carry, audio, or weather modules to complete the kit."
    },
    {
      "type": "text",
      "id": "empty_secondary_label",
      "label": "t:sections.main-cart.settings.empty_secondary_label.label",
      "default": "Open lookbook"
    },
    {
      "type": "url",
      "id": "empty_secondary_link",
      "label": "t:sections.main-cart.settings.empty_secondary_link.label"
    },
    {
      "type": "collection",
      "id": "empty_collection",
      "label": "t:sections.main-cart.settings.empty_collection.label"
    },
    {
      "type": "inline_richtext",
      "id": "empty_collection_heading",
      "label": "t:sections.main-cart.settings.empty_collection_heading.label",
      "default": "Start with the live system"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-cart.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-cart.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-cart.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-cart.settings.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Links the tile and supplies a fallback image when no image is set below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)",
          "info": "Overrides the collection image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shell"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Weather layer"
        }
      ]
    }
  ]
}
{% endschema %}
