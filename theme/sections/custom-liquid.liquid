{%- liquid
  assign s = section.settings
-%}
{%- if s.custom_liquid != blank -%}
  <section
    data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
    class="bg-surface-page"
  >
    <div class="mx-auto max-w-[var(--page-width)] px-6">{{ s.custom_liquid }}</div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.custom-liquid.name",
  "tag": "section",
  "class": "section section--custom-liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom-liquid.settings.custom_liquid.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.custom-liquid.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.custom-liquid.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.custom-liquid.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.custom-liquid.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-liquid.presets.name"
    }
  ]
}
{% endschema %}
