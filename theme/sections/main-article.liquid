{%- liquid
  assign share_url = shop.url | append: article.url | url_encode
-%}
<article
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="mx-auto max-w-[var(--page-width)] px-6"
>
  <header class="grid gap-8 border-y border-border-hairline py-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
    <div class="flex flex-col justify-between gap-6">
      <a href="{{ blog.url }}" class="inline-flex items-center gap-2 self-start font-mono text-xs uppercase tracking-label text-text-muted transition-colors hover:text-text-strong">
        &larr; {{ blog.title }}
      </a>
      <div class="grid max-w-sm grid-cols-2 border border-border-hairline font-mono text-[10px] uppercase tracking-label text-text-muted">
        <span class="border-r border-border-hairline p-3">{{ article.published_at | date: '%b %d, %Y' }}</span>
        <span class="p-3">{% if article.author != blank %}{{ article.author }}{% else %}{{ shop.name }}{% endif %}</span>
      </div>
    </div>
    <div>
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">Journal entry</span>
      <h1 class="mt-3 max-w-4xl font-display text-h1 tracking-tight text-text-strong">{{ article.title }}</h1>
    </div>
  </header>

  {%- if article.image -%}
    <div class="relative mt-8 aspect-[16/9] overflow-hidden border border-border-hairline bg-surface-sunken">
      {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1400', sizes: '(min-width:750px) 760px, 100vw', alt: article.title, class: 'h-full w-full object-cover' }}
    </div>
  {%- endif -%}

  <div class="mx-auto max-w-[760px]">
    {%- render 'rte', content: article.content, class: 'mt-10 text-body-lg leading-relaxed text-text-body' -%}
  </div>

  <footer class="mx-auto mt-12 flex max-w-[760px] flex-col gap-6 border-t border-border-hairline pt-8">
    {%- if article.tags.size > 0 -%}
      <div class="flex flex-wrap gap-2">
        {%- for tag in article.tags -%}
          {%- render 'tag', label: tag -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="flex flex-wrap items-center gap-4 font-mono text-xs uppercase tracking-label text-text-muted">
      <span>Share</span>
      <a href="https://www.facebook.com/sharer.php?u={{ share_url }}" class="hover:text-text-strong" target="_blank" rel="noopener">Facebook</a>
      <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}" class="hover:text-text-strong" target="_blank" rel="noopener">Pinterest</a>
      <a href="https://twitter.com/intent/tweet?url={{ share_url }}" class="hover:text-text-strong" target="_blank" rel="noopener">X</a>
    </div>
  </footer>

  {%- if article.next_article != blank or article.previous_article != blank -%}
    <nav class="mx-auto mt-10 flex max-w-[760px] justify-between gap-6 border-t border-border-hairline pt-8 font-mono text-xs uppercase tracking-label" aria-label="More articles">
      {%- if article.previous_article != blank -%}
        <a href="{{ article.previous_article.url }}" class="flex max-w-[45%] flex-col gap-1 text-text-muted transition-colors hover:text-text-strong">
          <span>&larr; Previous</span>
          <span class="text-text-strong normal-case">{{ article.previous_article.title }}</span>
        </a>
      {%- else -%}<span></span>{%- endif -%}
      {%- if article.next_article != blank -%}
        <a href="{{ article.next_article.url }}" class="flex max-w-[45%] flex-col items-end gap-1 text-right text-text-muted transition-colors hover:text-text-strong">
          <span>Next &rarr;</span>
          <span class="text-text-strong normal-case">{{ article.next_article.title }}</span>
        </a>
      {%- else -%}<span></span>{%- endif -%}
    </nav>
  {%- endif -%}

  {%- if blog.comments_enabled? -%}
    <section class="mx-auto mt-12 flex max-w-[760px] flex-col gap-6 border-t border-border-hairline pt-8">
      <h2 class="font-mono text-xs uppercase tracking-label text-text-muted">{{ article.comments_count }} Comments</h2>

      {%- if article.comments_count > 0 -%}
        {%- paginate article.comments by 5 -%}
          <ul class="flex flex-col gap-6">
            {%- for comment in article.comments -%}
              <li class="border border-border-hairline p-5">
                <p class="text-body text-text-body">{{ comment.content }}</p>
                <span class="mt-3 block font-mono text-xs uppercase tracking-label text-text-muted">{{ comment.author }} &middot; {{ comment.created_at | date: '%b %d, %Y' }}</span>
              </li>
            {%- endfor -%}
          </ul>
          {%- if paginate.pages > 1 -%}
            <nav aria-label="Comments pagination" class="flex items-center gap-4 font-mono text-xs uppercase tracking-label">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="text-text-body hover:text-text-strong">&larr; Newer</a>{%- endif -%}
              <span class="text-text-muted">{{ paginate.current_page }} / {{ paginate.pages }}</span>
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="text-text-body hover:text-text-strong">Older &rarr;</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}

      {%- form 'new_comment', article, class: 'flex flex-col gap-4' -%}
        {%- if form.errors -%}
          <div class="border border-state-error px-4 py-3 text-sm text-state-error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <div class="border border-positive px-4 py-3 text-sm text-positive">{% if blog.moderated? %}Thanks — your comment is awaiting moderation.{% else %}Thanks — your comment is live.{% endif %}</div>
        {%- endif -%}
        <div class="grid gap-4 sm:grid-cols-2">
          <input type="text" name="comment[author]" autocomplete="name" required placeholder="Name" aria-label="Name" class="border border-border-strong bg-transparent px-4 py-3 text-text-strong outline-none focus-visible:border-accent">
          <input type="email" name="comment[email]" autocomplete="email" required placeholder="Email" aria-label="Email" class="border border-border-strong bg-transparent px-4 py-3 text-text-strong outline-none focus-visible:border-accent">
        </div>
        <textarea name="comment[body]" rows="4" required placeholder="Comment" aria-label="Comment" class="border border-border-strong bg-transparent px-4 py-3 text-text-strong outline-none focus-visible:border-accent"></textarea>
        {%- render 'button', label: 'Post comment', type: 'submit' -%}
      {%- endform -%}
    </section>
  {%- endif -%}
</article>
{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section section--main-article",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-article.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-article.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-article.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-article.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-article.presets.name"
    }
  ]
}
{% endschema %}
