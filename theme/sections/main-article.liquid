{%- liquid
  assign share_url = shop.url | append: article.url | url_encode
-%}
<article
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="mx-auto max-w-[760px] px-6"
>
  <a href="{{ blog.url }}" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-label text-text-muted transition-colors hover:text-text-strong">
    &larr; {{ blog.title }}
  </a>

  <header class="mt-6 flex flex-col gap-3">
    <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ article.published_at | date: '%b %d, %Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}</span>
    <h1 class="font-display text-h1 tracking-tight text-text-strong">{{ article.title }}</h1>
  </header>

  {%- if article.image -%}
    <div class="relative mt-8 aspect-[16/9] overflow-hidden bg-surface-sunken">
      {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1400', sizes: '(min-width:750px) 760px, 100vw', alt: article.title, class: 'h-full w-full object-cover' }}
    </div>
  {%- endif -%}

  <div class="mt-10 flex flex-col gap-4 text-body-lg leading-relaxed text-text-body [&_a]:text-accent-press [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-5 [&_blockquote]:font-display [&_blockquote]:text-h4 [&_blockquote]:text-text-strong [&_h2]:mt-6 [&_h2]:font-display [&_h2]:text-h3 [&_h2]:text-text-strong [&_h3]:font-display [&_h3]:text-h4 [&_h3]:text-text-strong [&_img]:my-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5">
    {{ article.content }}
  </div>

  <footer class="mt-12 flex flex-col gap-6 border-t border-border-hairline pt-8">
    {%- if article.tags.size > 0 -%}
      <div class="flex flex-wrap gap-2">
        {%- for tag in article.tags -%}
          {%- render 'tag', label: tag -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="flex flex-wrap items-center gap-4 font-mono text-xs uppercase tracking-label text-text-muted">
      <span>Share</span>
      <a href="https://www.facebook.com/sharer.php?u={{ share_url }}" class="hover:text-text-strong" target="_blank" rel="noopener">Facebook</a>
      <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}" class="hover:text-text-strong" target="_blank" rel="noopener">Pinterest</a>
      <a href="https://twitter.com/intent/tweet?url={{ share_url }}" class="hover:text-text-strong" target="_blank" rel="noopener">X</a>
    </div>
  </footer>

  {%- if blog.next_article != blank or blog.previous_article != blank -%}
    <nav class="mt-10 flex justify-between gap-6 border-t border-border-hairline pt-8 font-mono text-xs uppercase tracking-label" aria-label="More articles">
      {%- if blog.previous_article != blank -%}
        <a href="{{ blog.previous_article.url }}" class="flex max-w-[45%] flex-col gap-1 text-text-muted transition-colors hover:text-text-strong">
          <span>&larr; Previous</span>
          <span class="text-text-strong normal-case">{{ blog.previous_article.title }}</span>
        </a>
      {%- else -%}<span></span>{%- endif -%}
      {%- if blog.next_article != blank -%}
        <a href="{{ blog.next_article.url }}" class="flex max-w-[45%] flex-col items-end gap-1 text-right text-text-muted transition-colors hover:text-text-strong">
          <span>Next &rarr;</span>
          <span class="text-text-strong normal-case">{{ blog.next_article.title }}</span>
        </a>
      {%- else -%}<span></span>{%- endif -%}
    </nav>
  {%- endif -%}

  {%- if blog.comments_enabled? -%}
    <section class="mt-12 flex flex-col gap-6 border-t border-border-hairline pt-8">
      <h2 class="font-mono text-xs uppercase tracking-label text-text-muted">{{ article.comments_count }} Comments</h2>

      {%- if article.comments_count > 0 -%}
        <ul class="flex flex-col gap-6">
          {%- for comment in article.comments -%}
            <li class="border border-border-hairline p-5">
              <p class="text-body text-text-body">{{ comment.content }}</p>
              <span class="mt-3 block font-mono text-xs uppercase tracking-label text-text-muted">{{ comment.author }} &middot; {{ comment.created_at | date: '%b %d, %Y' }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- form 'new_comment', article, class: 'flex flex-col gap-4' -%}
        {%- if form.errors -%}
          <div class="border border-state-error px-4 py-3 text-sm text-state-error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <div class="border border-positive px-4 py-3 text-sm text-positive">Thanks — your comment is awaiting moderation.</div>
        {%- endif -%}
        <div class="grid gap-4 sm:grid-cols-2">
          <input type="text" name="comment[author]" autocomplete="name" required placeholder="Name" aria-label="Name" class="border border-border-strong bg-transparent px-4 py-3 text-text-strong outline-none focus-visible:border-accent">
          <input type="email" name="comment[email]" autocomplete="email" required placeholder="Email" aria-label="Email" class="border border-border-strong bg-transparent px-4 py-3 text-text-strong outline-none focus-visible:border-accent">
        </div>
        <textarea name="comment[body]" rows="4" required placeholder="Comment" aria-label="Comment" class="border border-border-strong bg-transparent px-4 py-3 text-text-strong outline-none focus-visible:border-accent"></textarea>
        {%- render 'button', label: 'Post comment', type: 'submit' -%}
      {%- endform -%}
    </section>
  {%- endif -%}
</article>
{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section section--main-article",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-article.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-article.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-article.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-article.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-article.presets.name"
    }
  ]
}
{% endschema %}
