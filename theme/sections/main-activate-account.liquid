{%- liquid
  assign field = 'min-h-[44px] border border-border-strong bg-transparent px-4 py-3 text-text-strong outline-none transition-colors focus-visible:border-accent'
  assign submit_label = 'customer.activate_account.submit' | t | default: 'Activate account'
  assign decline_label = 'customer.activate_account.decline' | t | default: 'Decline'
-%}
<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="mx-auto max-w-[420px] px-6"
>
  <h1 class="font-display text-h1 tracking-tight text-text-strong">{{ 'customer.activate_account.title' | t | default: 'Activate account' }}</h1>
  <p class="mt-3 text-sm text-text-muted">Set a password to finish activating your account.</p>
  {%- form 'activate_customer_password', class: 'mt-8 grid gap-4' -%}
    {%- if form.errors -%}
      <div role="alert" class="border border-negative px-4 py-3 text-sm text-negative">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label class="grid gap-1">
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'customer.activate_account.password' | t | default: 'Password' }}</span>
      <input type="password" name="customer[password]" autocomplete="new-password" required class="{{ field }}">
    </label>
    <label class="grid gap-1">
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'customer.activate_account.password_confirmation' | t | default: 'Confirm password' }}</span>
      <input type="password" name="customer[password_confirmation]" autocomplete="new-password" required class="{{ field }}">
    </label>
    <div class="mt-2 flex flex-wrap gap-3">
      {%- render 'button', label: submit_label, type: 'submit', name: 'commit' -%}
      {%- render 'button', label: decline_label, type: 'submit', name: 'decline', variant: 'secondary' -%}
    </div>
  {%- endform -%}
</section>
{% schema %}
{
  "name": "t:sections.main-activate-account.name",
  "tag": "section",
  "class": "section section--main-activate-account",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-activate-account.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-activate-account.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-activate-account.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-activate-account.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-activate-account.presets.name"
    }
  ]
}
{% endschema %}
