{%- liquid
  assign s = section.settings
  assign cards = section.blocks | where: 'type', 'promo'
  assign hover_effect = s.image_hover_effect | default: 'inherit'
  assign effect_attr = ''
  if hover_effect == 'inherit'
    capture effect_attr
      render 'media-effect'
    endcapture
  elsif hover_effect == 'technical'
    capture effect_attr
      render 'media-effect', override: 'scan'
    endcapture
  endif
  assign width = s.width | default: 'page'
  if width == 'full'
    assign container_class = 'max-w-none px-6'
  else
    assign container_class = 'max-w-[var(--page-width)] px-6'
  endif
-%}
<section
  data-color-scheme="{{ s.color_scheme | default: 'scheme-1' }}"
  data-media-hover="{{ hover_effect }}"
  style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px;--cols-desktop:{{ s.columns_desktop | default: 3 }};--cols-mobile:{{ s.columns_mobile | default: 1 }}"
  class="bg-surface-page pt-[var(--pt,clamp(3.5rem,6vw,5rem))] pb-[var(--pb,clamp(3.5rem,6vw,5rem))]"
>
  {%- if hover_effect == 'none' or hover_effect == 'zoom' -%}
    <style>
      #shopify-section-{{ section.id }} .kx-media-effect::before,
      #shopify-section-{{ section.id }} .kx-media-effect::after {
        display: none;
      }
      {%- if hover_effect == 'none' -%}
        #shopify-section-{{ section.id }} .group:hover .kx-media-effect > img,
        #shopify-section-{{ section.id }} .group:focus-within .kx-media-effect > img,
        #shopify-section-{{ section.id }} .kx-media-effect:hover > img,
        #shopify-section-{{ section.id }} .kx-media-effect:focus-within > img {
          transform: none;
          filter: none;
        }
      {%- endif -%}
    </style>
  {%- endif -%}
  <div class="mx-auto {{ container_class }}">
    {%- if s.subheading != blank or s.heading != blank -%}
      <div class="mb-8 flex flex-col gap-2">
        {%- if s.subheading != blank -%}<span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.subheading }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="font-display text-h3 tracking-tight text-text-strong">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="grid gap-4 grid-cols-[repeat(var(--cols-mobile,1),minmax(0,1fr))] md:grid-cols-[repeat(var(--cols-desktop,3),minmax(0,1fr))]">
      {%- for block in cards -%}
        {%- assign b = block.settings -%}
        {%- capture promo_inner -%}
          {%- if b.image != blank -%}
            <div class="kx-media-effect relative {% case s.image_ratio %}{% when 'square' %}aspect-square{% when 'wide' %}aspect-[4/3]{% else %}aspect-[4/5]{% endcase %} overflow-hidden" {{ effect_attr }}>
              {%- assign promo_alt = b.image.alt | default: b.heading | default: b.eyebrow -%}
              {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width:750px) 33vw, 100vw', alt: promo_alt, class: 'h-full w-full object-cover' }}
            </div>
          {%- else -%}
            <div class="kx-media-effect relative {% case s.image_ratio %}{% when 'square' %}aspect-square{% when 'wide' %}aspect-[4/3]{% else %}aspect-[4/5]{% endcase %} overflow-hidden" {{ effect_attr }}>
              {%- assign promo_ph_idx = forloop.index0 | modulo: 6 | plus: 1 -%}
              {%- assign promo_ph = 'collection-' | append: promo_ph_idx -%}
              {{ promo_ph | placeholder_svg_tag: 'h-full w-full object-cover bg-surface-sunken text-border-hairline' }}
            </div>
          {%- endif -%}
          <div class="flex flex-1 flex-col gap-2 p-5">
            {%- if b.eyebrow != blank -%}<span class="font-mono text-[11px] uppercase tracking-label text-accent-press">{{ b.eyebrow }}</span>{%- endif -%}
            {%- if b.heading != blank -%}<h3 class="font-display text-h4 tracking-tight text-text-strong">{{ b.heading }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<div class="text-sm text-text-muted [&_p]:m-0 [&_p]:mt-1">{{ b.text }}</div>{%- endif -%}
            {%- if b.button_label != blank -%}<span class="mt-auto inline-flex items-center gap-1.5 pt-2 font-mono text-xs uppercase tracking-label text-text-strong transition-colors group-hover:text-accent-press">{{ b.button_label }}<span class="transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none">{%- render 'icon', name: 'arrow', size: 13 -%}</span></span>{%- endif -%}
          </div>
        {%- endcapture -%}
        {%- if b.link != blank -%}
          <a href="{{ b.link }}" class="group flex flex-col overflow-hidden border border-border-hairline bg-surface-page transition-colors hover:border-border-strong" {{ block.shopify_attributes }}>{{ promo_inner }}</a>
        {%- else -%}
          <div class="group flex flex-col overflow-hidden border border-border-hairline bg-surface-page" {{ block.shopify_attributes }}>{{ promo_inner }}</div>
        {%- endif -%}
      {%- else -%}
        <div class="border border-border-hairline py-16 text-center">
          <p class="font-mono text-xs uppercase tracking-label text-text-muted">Add promo cards to fill the grid.</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.promo-grid.name",
  "tag": "section",
  "class": "section section--promo-grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.promo-grid.settings.subheading.label",
      "default": "Featured"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.promo-grid.settings.heading.label",
      "default": "Shop the edit"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.promo-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.promo-grid.settings.columns_mobile.label",
      "default": "1",
      "options": [
        { "value": "1", "label": "t:sections.promo-grid.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.promo-grid.settings.columns_mobile.options__2.label" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.promo-grid.settings.image_ratio.label",
      "default": "portrait",
      "options": [
        { "value": "portrait", "label": "t:sections.promo-grid.settings.image_ratio.options__1.label" },
        { "value": "square", "label": "t:sections.promo-grid.settings.image_ratio.options__2.label" },
        { "value": "wide", "label": "t:sections.promo-grid.settings.image_ratio.options__3.label" }
      ]
    },
    {
      "type": "select",
      "id": "image_hover_effect",
      "label": "t:sections.promo-grid.settings.image_hover_effect.label",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "t:sections.promo-grid.settings.image_hover_effect.options__1.label" },
        { "value": "zoom", "label": "t:sections.promo-grid.settings.image_hover_effect.options__2.label" },
        { "value": "technical", "label": "t:sections.promo-grid.settings.image_hover_effect.options__3.label" },
        { "value": "none", "label": "t:sections.promo-grid.settings.image_hover_effect.options__4.label" }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.promo-grid.settings.width.label",
      "default": "page",
      "options": [
        { "value": "page", "label": "t:sections.promo-grid.settings.width.options__1.label" },
        { "value": "full", "label": "t:sections.promo-grid.settings.width.options__2.label" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.promo-grid.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.promo-grid.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56,
      "label": "t:sections.promo-grid.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56,
      "label": "t:sections.promo-grid.settings.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "t:sections.promo-grid.blocks.promo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.promo-grid.blocks.promo.settings.image.label"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.promo-grid.blocks.promo.settings.eyebrow.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.promo-grid.blocks.promo.settings.heading.label",
          "default": "Promo card"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.promo-grid.blocks.promo.settings.text.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.promo-grid.blocks.promo.settings.button_label.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.promo-grid.blocks.promo.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo-grid.presets.name",
      "blocks": [
        { "type": "promo" },
        { "type": "promo" },
        { "type": "promo" }
      ]
    }
  ]
}
{% endschema %}
