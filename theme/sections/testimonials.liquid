{%- liquid
  assign s = section.settings
  assign tcount = 0
  for block in section.blocks
    if block.type == 'testimonial'
      assign tcount = tcount | plus: 1
    endif
  endfor
  case section.settings.width
    when 'full'
      assign width_cls = 'max-w-none'
    when 'narrow'
      assign width_cls = 'max-w-4xl'
    else
      assign width_cls = 'max-w-[var(--page-width)]'
  endcase
-%}
<section
  data-color-scheme="{{ s.color_scheme | default: 'scheme-3' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="theme-dark bg-surface-page text-text-body"
>
  <div class="mx-auto {{ width_cls }} px-6">
    <div class="flex items-start justify-between gap-6">
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.kicker | default: 'Field reports' }}</span>
      {%- if s.heading != blank -%}<span class="sr-only">{{ s.heading }}</span>{%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'testimonial' -%}
        <figure {{ block.shopify_attributes }} class="mt-8 grid gap-6 md:grid-cols-[4rem_1fr] md:gap-10">
          <span aria-hidden="true" data-accent-ok class="font-display text-[5rem] leading-[0.6] text-accent md:text-[7rem]">&ldquo;</span>
          <div>
            <blockquote class="font-display text-[clamp(1.75rem,4.2vw,3.25rem)] font-bold leading-[1.04] tracking-tight text-text-strong [&_p]:m-0">{{ block.settings.quote }}</blockquote>
            <figcaption class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-label text-text-muted">
              <span class="text-text-strong">{{ block.settings.author }}</span>
              {%- if block.settings.role != blank -%}<span aria-hidden="true">/ {{ block.settings.role }}</span>{%- endif -%}
            </figcaption>
          </div>
        </figure>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if tcount > 1 -%}
      <ul class="mt-14 grid border-t border-border-hairline md:grid-cols-3">
        {%- assign ti = 0 -%}
        {%- assign shown = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            {%- assign ti = ti | plus: 1 -%}
            {%- if ti > 1 and shown < 3 -%}
              {%- assign shown = shown | plus: 1 -%}
              <li {{ block.shopify_attributes }} class="flex flex-col gap-4 border-border-hairline py-7 md:border-l md:px-7 md:first:border-l-0 md:first:pl-0">
                <blockquote class="text-body-lg leading-snug text-text-body [&_p]:m-0">{{ block.settings.quote }}</blockquote>
                <figcaption class="mt-auto font-mono text-xs uppercase tracking-label text-text-muted">{{ block.settings.author }}</figcaption>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "section section--testimonials",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.testimonials.settings.kicker.label",
      "default": "Field reports"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.testimonials.settings.heading.label",
      "default": "What people say"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.testimonials.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "page",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "full", "label": "Full width" },
        { "value": "narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.testimonials.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.testimonials.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.testimonials.settings.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:sections.testimonials.blocks.testimonial.settings.quote.label"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author.label"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:sections.testimonials.blocks.testimonial.settings.role.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.name",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
