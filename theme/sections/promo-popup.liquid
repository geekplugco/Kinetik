{%- liquid
  assign s = section.settings
  assign popup_alt = s.heading | escape
  assign popup_signup_label = s.button_label | default: 'Sign up'
-%}
{%- if s.enable and s.heading != blank -%}
  <promo-popup
    hidden
    data-delay="{{ s.delay_seconds | default: 4 }}"
    data-frequency="{{ s.frequency | default: 'session' }}"
    data-key="{{ s.heading | append: s.text | md5 }}"
    class="fixed inset-0 kx-z-modal flex items-center justify-center p-4 opacity-0 transition-opacity duration-200 [&.is-open]:opacity-100"
  >
    <div data-promo-popup-close class="absolute inset-0 bg-ink-950/60"></div>
    <div
      data-color-scheme="{{ s.color_scheme | default: 'scheme-1' }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ s.heading | escape }}"
      tabindex="-1"
      class="relative z-10 grid w-[min(560px,92vw)] gap-5 overflow-auto border border-border-strong bg-surface-page p-6 shadow-[0_24px_60px_-24px_rgba(10,10,10,0.5)] md:grid-cols-[1fr] md:p-8{% if s.image != blank %} md:grid-cols-[0.9fr_1.1fr] md:p-0{% endif %}"
    >
      <button type="button" data-promo-popup-close aria-label="Close" class="absolute right-4 top-4 z-20 flex h-9 w-9 items-center justify-center text-text-muted transition-colors hover:text-text-strong">{%- render 'icon', name: 'close', size: 18 -%}</button>
      {%- if s.image != blank -%}
        <div class="relative hidden aspect-square overflow-hidden bg-surface-sunken md:block">
          {{ s.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,700', sizes: '(min-width:768px) 40vw, 0px', alt: popup_alt, class: 'h-full w-full object-cover' }}
        </div>
      {%- endif -%}
      <div class="flex flex-col gap-4 {% if s.image != blank %}p-6 md:p-8{% endif %}">
        <div class="flex flex-col gap-2">
          {%- if s.subheading != blank -%}
            <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ s.subheading }}</span>
          {%- endif -%}
          <h2 class="font-display text-h3 tracking-tight text-text-strong">{{ s.heading }}</h2>
          {%- if s.text != blank -%}
            <div class="text-body text-text-body [&_p]:m-0">{{ s.text }}</div>
          {%- endif -%}
        </div>
        {%- if s.show_email_signup -%}
          {%- form 'customer', class: 'flex flex-col gap-2' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="sr-only" for="PromoPopupEmail-{{ section.id }}">Email</label>
            <input type="email" required name="contact[email]" id="PromoPopupEmail-{{ section.id }}" placeholder="you@email.com" class="min-h-[44px] border border-border-strong bg-surface-page px-4 py-3 font-sans text-sm text-text-strong placeholder:text-text-faint focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
            {%- if form.posted_successfully? -%}
              <p class="font-mono text-xs text-text-strong">Thanks. You&rsquo;re on the list.</p>
            {%- else -%}
              {%- render 'button', label: popup_signup_label, type: 'submit', size: 'md' -%}
            {%- endif -%}
          {%- endform -%}
        {%- elsif s.button_label != blank and s.button_link != blank -%}
          {%- render 'button', label: s.button_label, href: s.button_link, size: 'md' -%}
        {%- endif -%}
      </div>
    </div>
  </promo-popup>
  <script src="{{ 'promo-popup.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.promo-popup.name",
  "tag": "div",
  "class": "section section--promo-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "t:sections.promo-popup.settings.enable.label",
      "default": false
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.promo-popup.settings.subheading.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.promo-popup.settings.heading.label",
      "default": "Join the list"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.promo-popup.settings.text.label",
      "default": "<p>Get early access to new drops and restocks.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.promo-popup.settings.image.label"
    },
    {
      "type": "checkbox",
      "id": "show_email_signup",
      "label": "t:sections.promo-popup.settings.show_email_signup.label",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.promo-popup.settings.button_label.label",
      "default": "Sign up"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.promo-popup.settings.button_link.label",
      "info": "t:sections.promo-popup.settings.button_link.info"
    },
    {
      "type": "header",
      "content": "t:sections.promo-popup.settings.header__behavior.content"
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "t:sections.promo-popup.settings.frequency.label",
      "default": "session",
      "options": [
        { "value": "session", "label": "t:sections.promo-popup.settings.frequency.options__1.label" },
        { "value": "day", "label": "t:sections.promo-popup.settings.frequency.options__2.label" },
        { "value": "once", "label": "t:sections.promo-popup.settings.frequency.options__3.label" }
      ]
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 4,
      "label": "t:sections.promo-popup.settings.delay_seconds.label"
    },
    {
      "type": "header",
      "content": "t:sections.promo-popup.settings.header__style.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.promo-popup.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
