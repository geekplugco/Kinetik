{%- liquid
  assign s = section.settings
  assign heading_text = s.heading | default: 'Every gram earns its place' | escape
  assign words = heading_text | split: ' '
  assign accent_word = s.accent_word | strip | downcase
  assign term_blocks = section.blocks | where: 'type', 'term'
  assign btn_label = s.button_label | default: 'Shop the system'
  assign btn_link = s.button_link | default: routes.all_products_collection_url
-%}

<section
  data-color-scheme="{{ s.color_scheme | default: 'scheme-1' }}"
  style="--pt:{{ s.padding_top | default: 0 }}px;--pb:{{ s.padding_bottom | default: 0 }}px"
  class="relative overflow-hidden border-b border-border-strong bg-surface-page pb-[var(--pb,0px)] pt-[var(--pt,0px)]"
>
  <div class="hma-grid absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto flex min-h-[62vh] max-w-[var(--page-width)] flex-col justify-center gap-7 px-7 py-20 md:min-h-[76vh] md:px-14 md:py-24">
    {%- if s.kicker != blank -%}
      <span class="hma-fade font-mono text-xs uppercase tracking-label text-accent-press" style="--hma-d:420ms">{{ s.kicker }}</span>
    {%- endif -%}
    <h1 class="max-w-6xl font-display font-bold uppercase tracking-hero" style="font-size:clamp(3.5rem,10vw,8rem);line-height:.92;letter-spacing:-0.04em" aria-label="{{ heading_text }}">
      <span aria-hidden="true">
        {%- for word in words %}
          {%- assign clean_word = word | downcase | remove: '.' | remove: ',' | remove: '!' | remove: '?' | remove: ':' -%}
          <span class="hma-line"><span class="hma-word{% if accent_word != blank and clean_word == accent_word %} text-accent-press{% endif %}" style="--hma-i:{{ forloop.index0 }}">{{ word }}</span></span>
        {%- endfor %}
      </span>
    </h1>
    {%- if s.text != blank -%}
      <div class="hma-fade max-w-md text-body-lg leading-snug text-text-muted [&_p]:m-0" style="--hma-d:560ms">{{ s.text }}</div>
    {%- endif -%}
    <div class="hma-fade flex flex-wrap gap-3" style="--hma-d:700ms">
      {%- render 'button', label: btn_label, href: btn_link, variant: 'primary', size: 'md', icon: 'arrow', class: 'min-h-[44px] gap-3 px-8 py-4 text-sm' -%}
      {%- if s.secondary_button_label != blank -%}
        {%- render 'button', label: s.secondary_button_label, href: s.secondary_button_link, variant: 'secondary', size: 'md', class: 'min-h-[44px] px-8 py-4 text-sm' -%}
      {%- endif -%}
    </div>
  </div>

  {%- if term_blocks.size > 0 -%}
    <div class="hma-fade relative overflow-hidden border-t border-border-hairline py-3" style="--hma-d:840ms">
      <div class="flex w-max animate-[marquee_38s_linear_infinite] motion-reduce:animate-none" style="animation-duration:64s">
        {%- for r in (1..2) -%}
          <div class="flex items-center"{% if r == 2 %} aria-hidden="true"{% endif %}>
            {%- for i in (1..3) -%}
              {%- for block in term_blocks -%}
                <span class="flex items-center font-mono text-[11px] uppercase tracking-label text-text-muted"{% if r == 1 and i == 1 %} {{ block.shopify_attributes }}{% endif %}>
                  {{ block.settings.label }}
                  <span class="mx-6 h-1 w-1 shrink-0 bg-accent" aria-hidden="true"></span>
                </span>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  #shopify-section-{{ section.id }} .hma-grid {
    pointer-events: none;
    opacity: 0.05;
    background:
      linear-gradient(90deg, var(--accent) 1px, transparent 1px) 0 0 / 96px 100%,
      linear-gradient(180deg, var(--accent) 1px, transparent 1px) 0 0 / 100% 96px;
  }

  #shopify-section-{{ section.id }} .hma-line {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  #shopify-section-{{ section.id }} .hma-word {
    display: inline-block;
    transform: translateY(110%);
    will-change: transform;
    animation: hmaWord-{{ section.id }} 620ms var(--ease-enter, cubic-bezier(0.22, 0.61, 0.36, 1)) calc(var(--hma-i, 0) * 70ms) forwards;
  }

  #shopify-section-{{ section.id }} .hma-fade {
    opacity: 0;
    animation: hmaFade-{{ section.id }} 700ms var(--ease-enter, ease) var(--hma-d, 500ms) forwards;
  }

  @keyframes hmaWord-{{ section.id }} {
    to { transform: translateY(0); }
  }

  @keyframes hmaFade-{{ section.id }} {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .hma-word {
      transform: none;
      animation: none;
    }

    #shopify-section-{{ section.id }} .hma-fade {
      opacity: 1;
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.hero-manifesto.name",
  "tag": "section",
  "class": "section section--hero-manifesto",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero-manifesto.settings.header__1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.hero-manifesto.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hero-manifesto.settings.padding_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hero-manifesto.settings.padding_bottom.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.hero-manifesto.settings.header__2.content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.hero-manifesto.settings.kicker.label",
      "default": "Field manifesto"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero-manifesto.settings.heading.label",
      "default": "Every gram earns its place"
    },
    {
      "type": "text",
      "id": "accent_word",
      "label": "t:sections.hero-manifesto.settings.accent_word.label",
      "info": "t:sections.hero-manifesto.settings.accent_word.info",
      "default": "earns"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero-manifesto.settings.text.label",
      "default": "<p>No filler panels, no decorative hardware. If a feature cannot justify its weight in the field, it never leaves the lab.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero-manifesto.settings.button_label.label",
      "default": "Shop the system"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero-manifesto.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:sections.hero-manifesto.settings.secondary_button_label.label",
      "default": "Read the spec"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:sections.hero-manifesto.settings.secondary_button_link.label"
    }
  ],
  "blocks": [
    {
      "type": "term",
      "name": "t:sections.hero-manifesto.blocks.term.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.hero-manifesto.blocks.term.settings.label.label",
          "default": "Field-tested"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-manifesto.presets.name",
      "blocks": [
        {
          "type": "term",
          "settings": {
            "label": "Field-tested"
          }
        },
        {
          "type": "term",
          "settings": {
            "label": "3L membrane"
          }
        },
        {
          "type": "term",
          "settings": {
            "label": "No filler"
          }
        },
        {
          "type": "term",
          "settings": {
            "label": "Repairable"
          }
        },
        {
          "type": "term",
          "settings": {
            "label": "Carbon-neutral"
          }
        },
        {
          "type": "term",
          "settings": {
            "label": "Ships in 24h"
          }
        }
      ]
    }
  ]
}
{% endschema %}
