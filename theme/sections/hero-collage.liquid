{%- liquid
  assign s = section.settings
  assign heading_text = s.heading | default: 'Shot in the field, worn in transit' | escape
  assign words = heading_text | split: ' '
  assign media_blocks = section.blocks | where: 'type', 'media'
  assign btn_label = s.button_label | default: 'Shop the system'
  assign btn_link = s.button_link | default: routes.all_products_collection_url
-%}

<section
  data-color-scheme="{{ s.color_scheme | default: 'scheme-1' }}"
  style="--pt:{{ s.padding_top | default: 0 }}px;--pb:{{ s.padding_bottom | default: 0 }}px"
  class="border-b border-border-strong bg-surface-page pb-[var(--pb,0px)] pt-[var(--pt,0px)]"
>
  <div class="mx-auto grid max-w-[var(--page-width)] grid-cols-1 gap-px border-y border-border-hairline bg-border-hairline md:grid-cols-12 md:grid-rows-2">
    <div class="order-1 flex flex-col justify-center gap-6 bg-surface-page px-7 py-14 md:col-span-5 md:row-span-2 md:px-10 md:py-16">
      {%- if s.kicker != blank -%}
        <span class="hc-fade font-mono text-xs uppercase tracking-label text-accent-press" style="--hc-d:420ms">{{ s.kicker }}</span>
      {%- endif -%}
      <h1 class="max-w-lg font-display font-bold uppercase tracking-hero" style="font-size:clamp(2.5rem,5vw,4rem);line-height:.95;letter-spacing:-0.035em" aria-label="{{ heading_text }}">
        <span aria-hidden="true">
          {%- for word in words %}
            <span class="hc-line"><span class="hc-word" style="--hc-i:{{ forloop.index0 }}">{{ word }}</span></span>
          {%- endfor %}
        </span>
      </h1>
      {%- if s.text != blank -%}
        <div class="hc-fade max-w-sm text-body-lg leading-snug text-text-muted [&_p]:m-0" style="--hc-d:560ms">{{ s.text }}</div>
      {%- endif -%}
      <div class="hc-fade flex flex-wrap gap-3" style="--hc-d:700ms">
        {%- render 'button', label: btn_label, href: btn_link, variant: 'primary', size: 'md', icon: 'arrow', class: 'min-h-[44px] gap-3 px-7 py-4 text-sm' -%}
      </div>
    </div>

    {%- for i in (1..3) -%}
      {%- liquid
        assign idx = i | minus: 1
        assign block = media_blocks[idx]
        if i == 1
          assign cell_cls = 'order-2 aspect-[4/5] md:col-span-4 md:row-span-2 md:aspect-auto'
          assign cell_sizes = '(min-width: 768px) 33vw, 100vw'
        else
          assign cell_cls = 'aspect-[4/3] md:col-span-3'
          assign cell_sizes = '(min-width: 768px) 25vw, 100vw'
          if i == 2
            assign cell_cls = cell_cls | prepend: 'order-3 '
          else
            assign cell_cls = cell_cls | prepend: 'order-4 '
          endif
        endif
        assign cell_alt = block.settings.image.alt | default: block.settings.caption | default: heading_text | escape
      -%}
      {%- capture cell_inner -%}
        <span class="kx-media-effect absolute inset-0" {% render 'media-effect' %}>
          {%- if block.settings.image != blank -%}
            {%- if i == 1 -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400,600,800,1000,1200', sizes: cell_sizes, alt: cell_alt, class: 'absolute inset-0 h-full w-full object-cover' }}
            {%- else -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: cell_sizes, alt: cell_alt, class: 'absolute inset-0 h-full w-full object-cover' }}
            {%- endif -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-border-hairline' }}
          {%- endif -%}
        </span>
        {%- if block.settings.caption != blank -%}
          <span class="absolute bottom-3 left-3 z-10 bg-ink-950/75 px-2.5 py-1 font-mono text-[10px] uppercase tracking-label text-paper backdrop-blur-sm">{{ block.settings.caption }}</span>
        {%- endif -%}
      {%- endcapture -%}
      {%- if block and block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="group relative block overflow-hidden bg-surface-sunken {{ cell_cls }}"{% if block.settings.caption != blank %} aria-label="{{ block.settings.caption | escape }}"{% endif %} {{ block.shopify_attributes }}>{{ cell_inner }}</a>
      {%- elsif block -%}
        <div class="group relative overflow-hidden bg-surface-sunken {{ cell_cls }}" {{ block.shopify_attributes }}>{{ cell_inner }}</div>
      {%- else -%}
        <div class="group relative overflow-hidden bg-surface-sunken {{ cell_cls }}">{{ cell_inner }}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .hc-line {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  #shopify-section-{{ section.id }} .hc-word {
    display: inline-block;
    transform: translateY(110%);
    will-change: transform;
    animation: hcWord-{{ section.id }} 620ms var(--ease-enter, cubic-bezier(0.22, 0.61, 0.36, 1)) calc(var(--hc-i, 0) * 70ms) forwards;
  }

  #shopify-section-{{ section.id }} .hc-fade {
    opacity: 0;
    animation: hcFade-{{ section.id }} 700ms var(--ease-enter, ease) var(--hc-d, 500ms) forwards;
  }

  @keyframes hcWord-{{ section.id }} {
    to { transform: translateY(0); }
  }

  @keyframes hcFade-{{ section.id }} {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .hc-word {
      transform: none;
      animation: none;
    }

    #shopify-section-{{ section.id }} .hc-fade {
      opacity: 1;
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.hero-collage.name",
  "tag": "section",
  "class": "section section--hero-collage",
  "max_blocks": 3,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero-collage.settings.header__1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.hero-collage.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hero-collage.settings.padding_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.hero-collage.settings.padding_bottom.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.hero-collage.settings.header__2.content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.hero-collage.settings.kicker.label",
      "default": "SS26 · Field System"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero-collage.settings.heading.label",
      "default": "Shot in the field, worn in transit"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero-collage.settings.text.label",
      "default": "<p>Three frames from the season. Every piece in shot ships now.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero-collage.settings.button_label.label",
      "default": "Shop the system"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero-collage.settings.button_link.label"
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "t:sections.hero-collage.blocks.media.name",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.hero-collage.blocks.media.settings.image.label"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.hero-collage.blocks.media.settings.caption.label",
          "default": "Frame 01 · Flat lay"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.hero-collage.blocks.media.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-collage.presets.name",
      "blocks": [
        {
          "type": "media",
          "settings": {
            "caption": "Frame 01 · Flat lay"
          }
        },
        {
          "type": "media",
          "settings": {
            "caption": "Frame 02 · Worn"
          }
        },
        {
          "type": "media",
          "settings": {
            "caption": "Frame 03 · Detail"
          }
        }
      ]
    }
  ]
}
{% endschema %}
