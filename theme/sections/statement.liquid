<div class="flex flex-col">
  {%- for block in section.blocks -%}
    {%- liquid
      assign bs = block.settings
      case bs.height
        when 'compact'
          assign h_cls = 'min-h-[40vh] py-16'
        when 'tall'
          assign h_cls = 'min-h-[70vh] py-24'
        else
          assign h_cls = 'min-h-[50vh] py-20'
      endcase
      assign on_image = false
      if bs.image != blank
        assign on_image = true
      endif
      assign overlay = bs.overlay_opacity | default: 45 | divided_by: 100.0
    -%}
    <div
      {{ block.shopify_attributes }}
      data-color-scheme="{{ bs.color_scheme | default: 'scheme-1' }}"
      class="relative isolate flex {{ h_cls }} {% if on_image %}bg-ink-950{% else %}bg-surface-page{% endif %}"
    >
      {%- if on_image -%}
        {%- assign stmt_alt = bs.image.alt | default: bs.quote | strip_html | truncate: 120 -%}
        {{ bs.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750,1100,1600,2000,2400', sizes: '100vw', alt: stmt_alt, class: 'absolute inset-0 -z-10 h-full w-full object-cover' }}
        <div class="absolute inset-0 -z-10 bg-ink-950" style="opacity:{{ overlay }}" aria-hidden="true"></div>
      {%- endif -%}
      <div class="mx-auto flex w-full max-w-[var(--page-width)] flex-col justify-center px-6 py-4 {% if bs.alignment == 'left' %}items-start text-left{% else %}items-center text-center{% endif %}">
        <div class="flex max-w-[900px] flex-col gap-6 {% unless bs.alignment == 'left' %}mx-auto{% endunless %}">
          {%- if bs.eyebrow != blank -%}
            <span class="font-mono text-xs uppercase tracking-label {% if on_image %}text-paper/80{% else %}text-text-muted{% endif %}">{{ bs.eyebrow }}</span>
          {%- endif -%}
          {%- if bs.quote != blank -%}
            <blockquote class="font-display font-bold uppercase {% if on_image %}text-paper{% else %}text-text-strong{% endif %} [&_p]:m-0" style="font-size:clamp(2rem,6vw,5rem);line-height:.98;letter-spacing:-0.035em;text-wrap:balance;">{{ bs.quote }}</blockquote>
          {%- endif -%}
          {%- if bs.attribution != blank -%}
            <span class="font-mono text-xs uppercase tracking-label {% if on_image %}text-paper/70{% else %}text-text-muted{% endif %}">{{ bs.attribution }}</span>
          {%- endif -%}
          {%- if bs.button_label != blank -%}
            <div class="mt-2 {% unless bs.alignment == 'left' %}mx-auto{% endunless %}">
              {%- if on_image -%}
                {%- if bs.button_style == 'secondary' -%}
                  <a href="{{ bs.button_link | default: '#' }}" class="kx-hero-secondary inline-flex min-h-[44px] items-center justify-center gap-2 px-6 py-3 font-mono text-sm uppercase tracking-wide transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">{{ bs.button_label }}</a>
                {%- else -%}
                  <a href="{{ bs.button_link | default: '#' }}" class="inline-flex min-h-[44px] items-center justify-center gap-2 bg-paper px-6 py-3 font-mono text-sm uppercase tracking-wide text-ink-950 transition-colors hover:bg-accent hover:text-accent-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper">{{ bs.button_label }}</a>
                {%- endif -%}
              {%- else -%}
                {%- assign stmt_btn_link = bs.button_link | default: '#' -%}
                {%- render 'button', label: bs.button_label, href: stmt_btn_link, variant: bs.button_style, size: 'md' -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "t:sections.statement.name",
  "tag": "section",
  "class": "section section--statement",
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "t:sections.statement.blocks.banner.name",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.statement.blocks.banner.settings.eyebrow.label",
          "default": "Manifesto"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:sections.statement.blocks.banner.settings.quote.label",
          "default": "<p>Built for the field, styled for the street.</p>"
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "t:sections.statement.blocks.banner.settings.attribution.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.statement.blocks.banner.settings.image.label"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 45,
          "label": "t:sections.statement.blocks.banner.settings.overlay_opacity.label"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "t:sections.statement.blocks.banner.settings.alignment.label",
          "default": "center",
          "options": [
            { "value": "left", "label": "t:sections.statement.blocks.banner.settings.alignment.options__1.label" },
            { "value": "center", "label": "t:sections.statement.blocks.banner.settings.alignment.options__2.label" }
          ]
        },
        {
          "type": "select",
          "id": "height",
          "label": "t:sections.statement.blocks.banner.settings.height.label",
          "default": "medium",
          "options": [
            { "value": "compact", "label": "t:sections.statement.blocks.banner.settings.height.options__1.label" },
            { "value": "medium", "label": "t:sections.statement.blocks.banner.settings.height.options__2.label" },
            { "value": "tall", "label": "t:sections.statement.blocks.banner.settings.height.options__3.label" }
          ]
        },
        {
          "type": "header",
          "content": "t:sections.statement.blocks.banner.settings.header__1.content"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.statement.blocks.banner.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.statement.blocks.banner.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:sections.statement.blocks.banner.settings.button_style.label",
          "default": "primary",
          "options": [
            { "value": "primary", "label": "t:sections.statement.blocks.banner.settings.button_style.options__1.label" },
            { "value": "secondary", "label": "t:sections.statement.blocks.banner.settings.button_style.options__2.label" }
          ]
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.statement.blocks.banner.settings.color_scheme.label",
          "default": "scheme-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.statement.presets.name",
      "blocks": [
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
