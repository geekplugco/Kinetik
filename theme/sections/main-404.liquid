<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="hp-container text-center"
>
  <h1 class="font-display text-display-1 uppercase tracking-hero text-text-strong">404</h1>
  <p class="mt-4 font-mono text-xs uppercase tracking-label text-text-muted">{{ 'general.404.title' | t }}</p>
  {%- assign back_label = 'general.404.back' | t | default: 'Back home' -%}
  <div class="mt-8">{%- render 'button', label: back_label, href: routes.root_url, size: 'lg' -%}</div>
</section>
{% schema %}
{
  "name": "t:sections.main-404.name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-404.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-404.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-404.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-404.settings.padding_bottom.label"
    }
  ]
}
{% endschema %}
