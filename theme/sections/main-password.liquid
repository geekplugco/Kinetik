<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center"
>
  <span class="font-display text-[1.375rem] font-bold leading-none tracking-[-0.04em]">{{ shop.name | upcase }}<span class="text-accent" data-accent-ok>.</span></span>

  <h1 class="max-w-2xl font-display text-fluid-h1 tracking-hero">Something is coming.</h1>
  {%- if shop.password_message != blank -%}
    <p class="max-w-md text-body text-text-body">{{ shop.password_message }}</p>
  {%- endif -%}
  <p class="font-mono text-xs uppercase tracking-label text-text-muted">{{ shop.name }} {{ 'general.password_page.login_form_heading' | t | downcase | default: 'opens soon' }}</p>

  {%- form 'storefront_password', class: 'mt-2 flex w-full max-w-sm gap-2' -%}
    <label class="sr-only" for="store-password">Password</label>
    <input type="password" name="password" id="store-password" placeholder="Password" autocomplete="current-password" class="min-w-0 flex-1 border border-border-strong bg-transparent px-4 py-3 font-mono text-sm text-text-strong outline-none transition-colors placeholder:text-text-faint focus-visible:border-accent">
    <button type="submit" class="shrink-0 bg-accent px-6 py-3 font-mono text-xs uppercase tracking-label text-accent-ink transition-colors hover:bg-accent-hover{% if settings.button_style == 'rounded' %} rounded-full{% endif %}">{{ 'general.password_page.login_form_submit' | t | default: 'Enter' }}</button>
  {%- endform -%}

  <div class="mt-10 flex w-full max-w-sm flex-col gap-3 border-t border-border-hairline pt-8">
    <span class="font-mono text-xs uppercase tracking-label text-text-muted">Get notified at launch</span>
    {%- form 'customer', class: 'flex w-full gap-2' -%}
      {%- if form.posted_successfully? -%}
        <p class="w-full text-sm text-text-muted" aria-live="polite">Thanks — we'll let you know.</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="prospect,password_page">
        <label class="sr-only" for="notify-email">Email</label>
        <input type="email" name="contact[email]" id="notify-email" required placeholder="Email" autocomplete="email" class="min-w-0 flex-1 border border-border-strong bg-transparent px-4 py-3 font-mono text-sm text-text-strong outline-none transition-colors placeholder:text-text-faint focus-visible:border-accent">
        <button type="submit" class="shrink-0 border border-border-strong px-6 py-3 font-mono text-xs uppercase tracking-label text-text-strong transition-colors hover:text-accent-press{% if settings.button_style == 'rounded' %} rounded-full{% endif %}">Notify me</button>
      {%- endif -%}
    {%- endform -%}
  </div>

  <p class="mt-6 text-xs text-text-muted">{{ powered_by_link }}</p>
</section>
{% schema %}
{
  "name": "t:sections.main-password.name",
  "tag": "section",
  "class": "section section--main-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-password.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-password.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-password.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-password.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-password.presets.name"
    }
  ]
}
{% endschema %}
