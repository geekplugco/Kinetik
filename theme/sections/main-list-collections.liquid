<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="hp-container"
>
  <div class="border border-border-hairline p-5">
    <p class="font-mono text-xs uppercase tracking-label text-text-muted">Archive index</p>
    <h1 class="mt-2 font-display text-h2 tracking-tight text-text-strong">{{ 'general.search.title' | t | default: 'Collections' }}</h1>
  </div>
  <ul class="mt-8 grid grid-cols-1 gap-px bg-border-hairline md:grid-cols-3">
    {%- for collection in collections -%}
      <li class="bg-surface-page"><a href="{{ collection.url }}" class="group relative block aspect-[4/3] overflow-hidden">
        {%- if collection.featured_image != blank -%}
          <div class="kx-media-effect absolute inset-0">
            {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width:750px) 33vw, 100vw', alt: collection.title, class: 'h-full w-full object-cover' }}
          </div>
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'h-full w-full object-cover text-border-hairline' }}
        {%- endif -%}
        <span class="absolute left-4 top-4 z-[3] font-mono text-[10px] uppercase tracking-label text-paper mix-blend-difference">Collection</span>
        <span class="absolute bottom-4 left-4 z-[3] max-w-sm font-display text-h4 text-paper mix-blend-difference">{{ collection.title }}</span>
      </a></li>
    {%- else -%}
      <li class="col-span-full bg-surface-page py-16 text-center">
        <p class="font-display text-h3 text-text-strong">No collections yet.</p>
        <p class="mt-2 text-body text-text-muted">Collections you publish will appear here.</p>
      </li>
    {%- endfor -%}
  </ul>
</section>
{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "list-collections"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-list-collections.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-list-collections.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-list-collections.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-list-collections.settings.padding_bottom.label"
    }
  ]
}
{% endschema %}
