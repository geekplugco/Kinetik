<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="hp-container"
>
  <h1 class="font-display text-h1 uppercase tracking-tight text-text-strong">{{ 'general.search.title' | t | default: 'Collections' }}</h1>
  <ul class="mt-8 grid grid-cols-1 gap-px bg-border-hairline md:grid-cols-3">
    {%- for collection in collections -%}
      <li class="bg-surface-page"><a href="{{ collection.url }}" class="group relative block aspect-[4/3] overflow-hidden">
        {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'h-full w-full object-cover' }}
        <span class="absolute bottom-4 left-4 font-display text-h3 uppercase text-paper mix-blend-difference">{{ collection.title }}</span>
      </a></li>
    {%- endfor -%}
  </ul>
</section>
{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "list-collections"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-list-collections.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-list-collections.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-list-collections.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-list-collections.settings.padding_bottom.label"
    }
  ]
}
{% endschema %}
