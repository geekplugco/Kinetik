{%- liquid
  assign s = section.settings
  assign menu = linklists[s.menu]
-%}
{%- if menu.links.size > 0 -%}
  <section
    data-color-scheme="{{ s.color_scheme | default: 'scheme-1' }}"
    style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px"
    class="bg-surface-page pt-[var(--pt,12px)] pb-[var(--pb,12px)]"
  >
    <nav aria-label="{{ menu.title | default: 'Collections' }}" class="mx-auto max-w-[var(--page-width)] px-6">
      <ul class="flex flex-wrap gap-2 overflow-x-auto">
        {%- for link in menu.links -%}
          {%- assign is_current = false -%}
          {%- if collection and link.object.handle == collection.handle -%}
            {%- assign is_current = true -%}
          {%- endif -%}
          <li>
            <a
              href="{{ link.url }}"
              {% if is_current %}aria-current="page"{% endif %}
              class="inline-flex min-h-[36px] items-center border px-4 font-mono text-xs uppercase tracking-label transition-colors {% if is_current %}border-border-strong bg-surface-sunken text-text-strong{% else %}border-border-hairline text-text-muted hover:border-border-strong hover:text-text-strong{% endif %}"
            >{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.collection-nav.name",
  "tag": "section",
  "class": "section section--collection-nav",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.collection-nav.settings.menu.label",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:sections.collection-nav.settings.header__style.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection-nav.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 12,
      "label": "t:sections.collection-nav.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 12,
      "label": "t:sections.collection-nav.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-nav.presets.name"
    }
  ]
}
{% endschema %}
