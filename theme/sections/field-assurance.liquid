{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign block_count = section.blocks.size
-%}
{%- if block_count > 0 -%}
  <section
    data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
    style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px"
    class="bg-surface-page pt-[var(--pt,32px)] pb-[var(--pb,32px)]"
  >
    <div class="mx-auto max-w-[var(--page-width)] px-6">
      {%- if section.settings.heading != blank -%}
        <h2 class="mb-5 font-mono text-xs uppercase tracking-label text-text-muted">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="grid grid-cols-1 border-l border-t border-border-hairline sm:grid-cols-2 lg:grid-cols-4">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'item' -%}
              {%- if block.settings.heading != blank or block.settings.text != blank -%}
                <div class="flex flex-col gap-1.5 border-r border-b border-border-hairline p-4 md:p-5" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <span class="font-mono text-xs uppercase tracking-label text-text-strong">{{ block.settings.heading }}</span>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="text-sm text-text-body [&_a]:underline [&_a]:underline-offset-2">{{ block.settings.text }}</p>
                  {%- endif -%}
                  {%- if block.settings.link_url != blank and block.settings.link_label != blank -%}
                    <a href="{{ block.settings.link_url }}" class="mt-0.5 inline-flex items-center gap-1 font-mono text-xs uppercase tracking-label text-text-strong transition-colors hover:text-accent-press">{{ block.settings.link_label }} <span aria-hidden="true">&#8599;</span></a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- when 'pickup' -%}
              {%- assign stores = variant.store_availabilities | where: 'available' -%}
              {%- if stores.size > 0 -%}
                {%- assign nearest = stores.first -%}
                <div class="flex flex-col gap-1.5 border-r border-b border-border-hairline p-4 md:p-5" {{ block.shopify_attributes }}>
                  <span class="font-mono text-xs uppercase tracking-label text-text-strong">{{ block.settings.heading | default: 'Store pickup' }}</span>
                  <p class="text-sm text-text-body">{{ nearest.location.name }}{% if nearest.pick_up_time != blank %} &middot; {{ nearest.pick_up_time }}{% endif %}</p>
                </div>
              {%- endif -%}
            {%- when 'policies' -%}
              {%- capture policy_links -%}
                {%- if shop.shipping_policy != blank and shop.shipping_policy.url != blank -%}<a href="{{ shop.shipping_policy.url }}" class="text-text-body underline underline-offset-2 hover:text-text-strong">{{ shop.shipping_policy.title }}</a>{%- endif -%}
                {%- if shop.refund_policy != blank and shop.refund_policy.url != blank -%}<a href="{{ shop.refund_policy.url }}" class="text-text-body underline underline-offset-2 hover:text-text-strong">{{ shop.refund_policy.title }}</a>{%- endif -%}
                {%- if shop.privacy_policy != blank and shop.privacy_policy.url != blank -%}<a href="{{ shop.privacy_policy.url }}" class="text-text-body underline underline-offset-2 hover:text-text-strong">{{ shop.privacy_policy.title }}</a>{%- endif -%}
                {%- if shop.terms_of_service != blank and shop.terms_of_service.url != blank -%}<a href="{{ shop.terms_of_service.url }}" class="text-text-body underline underline-offset-2 hover:text-text-strong">{{ shop.terms_of_service.title }}</a>{%- endif -%}
              {%- endcapture -%}
              {%- if policy_links != blank -%}
                <div class="flex flex-col gap-1.5 border-r border-b border-border-hairline p-4 md:p-5" {{ block.shopify_attributes }}>
                  <span class="font-mono text-xs uppercase tracking-label text-text-strong">{{ block.settings.heading | default: 'Policies' }}</span>
                  <div class="flex flex-col gap-1 text-sm">{{ policy_links }}</div>
                </div>
              {%- endif -%}
            {%- when 'trust_badges' -%}
              {%- if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank or block.settings.image_4 != blank -%}
                <div class="flex flex-col gap-2 border-r border-b border-border-hairline p-4 md:p-5" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}<span class="font-mono text-xs uppercase tracking-label text-text-strong">{{ block.settings.heading }}</span>{%- endif -%}
                  <div class="flex flex-wrap items-center gap-3">
                    {%- for i in (1..4) -%}
                      {%- assign key = 'image_' | append: i -%}
                      {%- assign img = block.settings[key] -%}
                      {%- if img != blank -%}
                        {{ img | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', sizes: '60px', alt: img.alt, class: 'h-7 w-auto object-contain' }}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.field-assurance.name",
  "tag": "section",
  "class": "section section--field-assurance",
  "enabled_on": {
    "templates": ["product", "page", "index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.field-assurance.settings.heading.label"
    },
    {
      "type": "header",
      "content": "t:sections.field-assurance.settings.header__style.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.field-assurance.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32,
      "unit": "px",
      "label": "t:sections.field-assurance.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32,
      "unit": "px",
      "label": "t:sections.field-assurance.settings.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.field-assurance.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.field-assurance.blocks.item.settings.heading.label",
          "default": "Shipping"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.field-assurance.blocks.item.settings.text.label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "t:sections.field-assurance.blocks.item.settings.link_url.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.field-assurance.blocks.item.settings.link_label.label"
        }
      ]
    },
    {
      "type": "pickup",
      "name": "t:sections.field-assurance.blocks.pickup.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.field-assurance.blocks.pickup.settings.heading.label",
          "default": "Store pickup"
        },
        {
          "type": "paragraph",
          "content": "t:sections.field-assurance.blocks.pickup.settings.paragraph.content"
        }
      ]
    },
    {
      "type": "policies",
      "name": "t:sections.field-assurance.blocks.policies.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.field-assurance.blocks.policies.settings.heading.label",
          "default": "Policies"
        },
        {
          "type": "paragraph",
          "content": "t:sections.field-assurance.blocks.policies.settings.paragraph.content"
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "t:sections.field-assurance.blocks.trust_badges.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.field-assurance.blocks.trust_badges.settings.heading.label",
          "default": "Secure checkout"
        },
        { "type": "image_picker", "id": "image_1", "label": "t:sections.field-assurance.blocks.trust_badges.settings.image_1.label" },
        { "type": "image_picker", "id": "image_2", "label": "t:sections.field-assurance.blocks.trust_badges.settings.image_2.label" },
        { "type": "image_picker", "id": "image_3", "label": "t:sections.field-assurance.blocks.trust_badges.settings.image_3.label" },
        { "type": "image_picker", "id": "image_4", "label": "t:sections.field-assurance.blocks.trust_badges.settings.image_4.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.field-assurance.presets.name__1",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "pickup" },
        { "type": "policies" }
      ]
    }
  ]
}
{% endschema %}
