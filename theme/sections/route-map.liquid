{%- liquid
  assign stops = section.blocks | where: 'type', 'stop'
  assign layout = section.settings.layout | default: 'board'
  assign visual_style = section.settings.visual_style | default: 'signal'
  assign show_index = section.settings.show_index
  if show_index == nil
    assign show_index = true
  endif
  assign route_class = 'md:grid-cols-[3rem_0.92fr_1fr]'
  if layout == 'timeline'
    assign route_class = 'md:grid-cols-[3rem_0.58fr_1.2fr]'
  endif
-%}
{%- if stops.size > 0 -%}
  <section
    data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
    style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px"
    class="bg-surface-page pt-[var(--pt,72px)] pb-[var(--pb,72px)]"
  >
    <div class="mx-auto max-w-[var(--page-width)] px-6">
      <div class="mb-8 grid border border-border-strong md:grid-cols-[1fr_auto]">
        <div class="p-4 md:p-5">
          {%- if section.settings.subheading != blank -%}
            <span class="font-mono text-[10px] uppercase tracking-label text-text-muted">{{ section.settings.subheading }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="mt-2 font-display text-h3 tracking-tight text-text-strong">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        <div class="grid grid-cols-2 border-t border-border-hairline font-mono text-[10px] uppercase tracking-label text-text-muted md:w-56 md:border-l md:border-t-0">
          <span class="border-r border-border-hairline p-3">{{ stops.size }} stops</span>
          <span class="p-3">route</span>
        </div>
      </div>
      <ol class="relative border border-border-hairline bg-surface-page">
        {%- for block in stops -%}
          {%- assign p = block.settings.product -%}
          <li class="grid border-b border-border-hairline last:border-b-0 {{ route_class }}" {{ block.shopify_attributes }}>
            <span aria-hidden="true" class="flex min-h-[3rem] items-center justify-center border-b border-border-hairline font-mono text-[11px] text-text-muted md:border-b-0 md:border-r">{% if show_index %}{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}{% endif %}</span>
            <div class="relative aspect-[4/3] overflow-hidden bg-ink-950 md:aspect-auto">
              <div class="absolute inset-0">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width:990px) 45vw, 100vw', alt: block.settings.image.alt | default: block.settings.place, class: 'h-full w-full object-cover' }}
                {%- else -%}
                  <svg viewBox="0 0 900 675" role="img" aria-label="{{ block.settings.place | default: 'Route stop' | escape }}" class="h-full w-full bg-ink-950 text-paper">
                    <rect width="900" height="675" fill="currentColor" opacity="0.035"/>
                    <g fill="none" stroke="currentColor" stroke-width="2" opacity="{% if visual_style == 'quiet' %}0.13{% else %}0.2{% endif %}">
                      <path d="M0 112.5H900M0 225H900M0 337.5H900M0 450H900M0 562.5H900M150 0V675M300 0V675M450 0V675M600 0V675M750 0V675"/>
                    </g>
                    {%- case forloop.index -%}
                      {%- when 1 -%}
                        <g fill="none" stroke="currentColor" stroke-linecap="square" opacity="{% if visual_style == 'quiet' %}0.84{% else %}1{% endif %}">
                          <path d="M145 475 C260 350 330 370 440 250 S660 185 760 95" stroke-width="{% if layout == 'timeline' %}7{% else %}9{% endif %}"/>
                          <path d="M155 485 L250 505 M375 315 L430 395 M590 190 L640 280" stroke-width="3" opacity="0.55"/>
                          <circle cx="145" cy="475" r="18" fill="currentColor"/><circle cx="760" cy="95" r="18" fill="currentColor"/>
                        </g>
                      {%- when 2 -%}
                        <g fill="none" stroke="currentColor" stroke-linecap="square" opacity="{% if visual_style == 'quiet' %}0.84{% else %}1{% endif %}">
                          <path d="M120 365 H300 L355 275 H515 L570 365 H780" stroke-width="{% if layout == 'timeline' %}7{% else %}9{% endif %}"/>
                          <path d="M220 235 V500 M450 170 V530 M675 250 V500" stroke-width="3" opacity="0.55"/>
                          <circle cx="355" cy="275" r="18" fill="currentColor"/><circle cx="570" cy="365" r="18" fill="currentColor"/>
                        </g>
                      {%- else -%}
                        <g fill="none" stroke="currentColor" stroke-linecap="square" opacity="{% if visual_style == 'quiet' %}0.84{% else %}1{% endif %}">
                          <path d="M130 150 L270 520 L455 190 L615 525 L775 145" stroke-width="{% if layout == 'timeline' %}7{% else %}9{% endif %}"/>
                          <path d="M270 520 H130 M455 190 H620 M615 525 H780" stroke-width="3" opacity="0.55"/>
                          <circle cx="130" cy="150" r="18" fill="currentColor"/><circle cx="775" cy="145" r="18" fill="currentColor"/>
                        </g>
                    {%- endcase -%}
                    {%- if visual_style == 'signal' -%}
                      <path d="M0 0H900V675H0Z" fill="none" stroke="currentColor" stroke-width="8" opacity="0.12"/>
                      <path d="M64 64H172M64 64V172M728 64H836M836 64V172M64 611H172M64 503V611M728 611H836M836 503V611" fill="none" stroke="var(--accent)" stroke-width="4" opacity="0.75"/>
                    {%- endif -%}
                    <text x="36" y="625" fill="currentColor" font-size="22" font-family="monospace" opacity="0.48">{{ block.settings.place | default: 'Route stop' }}</text>
                  </svg>
                {%- endif -%}
              </div>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink-950/35 via-transparent to-ink-950/20" aria-hidden="true"></div>
            </div>
            <div class="flex flex-col justify-center gap-4 border-t border-border-hairline p-5 md:border-l md:border-t-0 md:p-8">
                {%- if block.settings.place != blank -%}
                  <span class="font-mono text-[10px] uppercase tracking-label text-text-muted">{{ block.settings.place }}</span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="max-w-xl font-display text-h3 tracking-tight text-text-strong">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <div class="max-w-2xl text-body text-text-body [&_p]:m-0 [&_p:not(:last-child)]:mb-3">{{ block.settings.caption }}</div>
                {%- endif -%}
                {%- if p != blank -%}
                  {%- render 'product-tile-compact', product: p, layout: 'row', image_width: 160, sizes: '72px', kicker: 'Featured', show_arrow: true, class: 'mt-1 flex items-center gap-4 border border-border-hairline bg-surface-raised p-3 transition-colors hover:border-border-strong md:max-w-xl' -%}
                {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.route-map.name",
  "tag": "section",
  "class": "section section--route-map",
  "settings": [
    { "type": "inline_richtext", "id": "subheading", "label": "t:sections.route-map.settings.subheading.label", "default": "Field route" },
    { "type": "text", "id": "heading", "label": "t:sections.route-map.settings.heading.label", "default": "The route" },
    { "type": "header", "content": "t:sections.route-map.settings.header__style.content" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.route-map.settings.layout.label",
      "default": "board",
      "options": [
        { "value": "board", "label": "t:sections.route-map.settings.layout.options__1.label" },
        { "value": "timeline", "label": "t:sections.route-map.settings.layout.options__2.label" }
      ]
    },
    {
      "type": "select",
      "id": "visual_style",
      "label": "t:sections.route-map.settings.visual_style.label",
      "default": "signal",
      "options": [
        { "value": "signal", "label": "t:sections.route-map.settings.visual_style.options__1.label" },
        { "value": "quiet", "label": "t:sections.route-map.settings.visual_style.options__2.label" }
      ]
    },
    { "type": "checkbox", "id": "show_index", "label": "t:sections.route-map.settings.show_index.label", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.route-map.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px", "label": "t:sections.route-map.settings.padding_top.label" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px", "label": "t:sections.route-map.settings.padding_bottom.label" }
  ],
  "blocks": [
    {
      "type": "stop",
      "name": "t:sections.route-map.blocks.stop.name",
      "settings": [
        { "type": "text", "id": "place", "label": "t:sections.route-map.blocks.stop.settings.place.label", "default": "00.000 N / 00.000 W" },
        { "type": "text", "id": "heading", "label": "t:sections.route-map.blocks.stop.settings.heading.label", "default": "Stop" },
        { "type": "image_picker", "id": "image", "label": "t:sections.route-map.blocks.stop.settings.image.label" },
        { "type": "richtext", "id": "caption", "label": "t:sections.route-map.blocks.stop.settings.caption.label" },
        { "type": "product", "id": "product", "label": "t:sections.route-map.blocks.stop.settings.product.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.route-map.presets.name__1",
      "blocks": [
        { "type": "stop", "settings": { "place": "Transit", "heading": "Out the door", "caption": "<p>Shell on, pack loaded, headphones in. The system starts moving.</p>" } },
        { "type": "stop", "settings": { "place": "Trail", "heading": "Off the grid", "caption": "<p>Weather turns. The membrane holds. Keep moving.</p>" } },
        { "type": "stop", "settings": { "place": "Camp", "heading": "Hold position", "caption": "<p>Layer down, power up, reset for the next leg.</p>" } }
      ]
    }
  ]
}
{% endschema %}
