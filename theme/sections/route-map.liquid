{%- liquid
  assign stops = section.blocks | where: 'type', 'stop'
  assign layout = section.settings.layout | default: 'board'
  assign visual_style = section.settings.visual_style
  if visual_style == blank or visual_style == 'default'
    if settings.media_effect == 'none'
      assign visual_style = 'quiet'
    else
      assign visual_style = 'signal'
    endif
  endif
  assign show_index = section.settings.show_index
  if show_index == nil
    assign show_index = true
  endif
  assign alternate_sides = section.settings.alternate_sides
  if alternate_sides == nil
    assign alternate_sides = true
  endif
  assign row_density = section.settings.row_density | default: 'relaxed'
  assign row_min_h = 'md:min-h-[340px]'
  if row_density == 'compact'
    assign row_min_h = 'md:min-h-[240px]'
  endif
  assign route_class = 'md:grid-cols-[4.5rem_minmax(0,0.92fr)_minmax(0,1fr)]'
  if layout == 'timeline'
    assign route_class = 'md:grid-cols-[4.5rem_minmax(0,0.58fr)_minmax(0,1.2fr)]'
  endif
  case section.settings.width
    when 'full'
      assign width_cls = 'max-w-none'
    when 'narrow'
      assign width_cls = 'max-w-4xl'
    else
      assign width_cls = 'max-w-[var(--page-width)]'
  endcase
  case section.settings.image_ratio
    when 'portrait'
      assign ratio_cls = 'aspect-[3/4]'
    when 'square'
      assign ratio_cls = 'aspect-square'
    when 'wide'
      assign ratio_cls = 'aspect-[16/9]'
    else
      assign ratio_cls = 'aspect-[4/3]'
  endcase
  assign stop_count = stops.size | prepend: '0' | slice: -2, 2
-%}
{%- if stops.size > 0 -%}
  <section
    data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
    style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px"
    class="bg-surface-page pt-[var(--pt,72px)] pb-[var(--pb,72px)]"
  >
    <div class="mx-auto {{ width_cls }} overflow-x-hidden px-6">
      <div class="mb-12 flex min-w-0 flex-wrap items-end justify-between gap-6 md:mb-16">
        <div class="min-w-0 max-w-2xl">
          {%- if section.settings.subheading != blank -%}
            <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ section.settings.subheading }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="mt-3 font-display text-display-2 tracking-tight text-balance text-text-strong">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        <div class="flex shrink-0 items-baseline gap-2 font-mono text-xs uppercase tracking-label text-text-muted">
          <span class="text-h3 font-display text-text-strong">{{ stop_count }}</span>
          <span>stop{{ stops.size | pluralize: '', 's' }} on route</span>
        </div>
      </div>
      <ol class="relative min-w-0 divide-y divide-border-hairline border-t border-border-hairline">
        {%- for block in stops -%}
          {%- liquid
            assign p = block.settings.product
            assign flip = false
            if alternate_sides
              assign row_parity = forloop.index0 | modulo: 2
              if row_parity == 1
                assign flip = true
              endif
            endif
            assign img_order_cls = 'md:order-1'
            assign text_order_cls = 'md:order-2'
            assign img_edge_cls = ''
            assign text_edge_cls = 'md:border-l'
            if flip
              assign img_order_cls = 'md:order-2'
              assign text_order_cls = 'md:order-1'
              assign img_edge_cls = 'md:border-l'
              assign text_edge_cls = ''
            endif
            assign stop_index = forloop.index | prepend: '0' | slice: -2, 2
          -%}
          <li class="relative grid min-w-0 {{ route_class }}" {{ block.shopify_attributes }}>
            {%- if show_index -%}
              <span aria-hidden="true" class="pointer-events-none absolute left-4 top-4 z-10 font-display text-h3 text-paper md:sticky md:top-24 md:z-auto md:flex md:min-h-[3rem] md:flex-col md:items-start md:justify-start md:gap-1 md:pt-8 md:text-h2 md:text-text-faint">
                <span>{{ stop_index }}</span>
                <span class="hidden font-mono text-xs font-normal normal-case tracking-normal text-text-faint md:block">/ {{ stop_count }}</span>
              </span>
            {%- endif -%}
            <div class="kx-media-effect relative min-w-0 {{ ratio_cls }} {{ img_order_cls }} {{ img_edge_cls }} overflow-hidden bg-ink-950 md:aspect-auto {{ row_min_h }}" {% render 'media-effect', surface: 'proof' %}>
              <div class="absolute inset-0">
                {%- if block.settings.image != blank -%}
                  {%- assign stop_alt = block.settings.image.alt | default: block.settings.place -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width:990px) 45vw, 100vw', alt: stop_alt, class: 'h-full w-full object-cover' }}
                {%- else -%}
                  <svg viewBox="0 0 900 675" role="img" aria-label="{{ block.settings.place | default: 'Route stop' | escape }}" class="h-full w-full bg-ink-950 text-paper" preserveAspectRatio="xMidYMid meet">
                    <rect width="900" height="675" fill="currentColor" opacity="0.035"/>
                    <g fill="none" stroke="currentColor" stroke-width="2" opacity="{% if visual_style == 'quiet' %}0.13{% else %}0.2{% endif %}">
                      <path d="M0 112.5H900M0 225H900M0 337.5H900M0 450H900M0 562.5H900M150 0V675M300 0V675M450 0V675M600 0V675M750 0V675"/>
                    </g>
                    {%- case forloop.index -%}
                      {%- when 1 -%}
                        <g fill="none" stroke="currentColor" stroke-linecap="square" opacity="{% if visual_style == 'quiet' %}0.84{% else %}1{% endif %}">
                          <path d="M145 475 C260 350 330 370 440 250 S660 185 760 95" stroke-width="{% if layout == 'timeline' %}7{% else %}9{% endif %}"/>
                          <path d="M155 485 L250 505 M375 315 L430 395 M590 190 L640 280" stroke-width="3" opacity="0.55"/>
                          <circle cx="145" cy="475" r="18" fill="currentColor"/><circle cx="760" cy="95" r="18" fill="currentColor"/>
                        </g>
                      {%- when 2 -%}
                        <g fill="none" stroke="currentColor" stroke-linecap="square" opacity="{% if visual_style == 'quiet' %}0.84{% else %}1{% endif %}">
                          <path d="M120 365 H300 L355 275 H515 L570 365 H780" stroke-width="{% if layout == 'timeline' %}7{% else %}9{% endif %}"/>
                          <path d="M220 235 V500 M450 170 V530 M675 250 V500" stroke-width="3" opacity="0.55"/>
                          <circle cx="355" cy="275" r="18" fill="currentColor"/><circle cx="570" cy="365" r="18" fill="currentColor"/>
                        </g>
                      {%- else -%}
                        <g fill="none" stroke="currentColor" stroke-linecap="square" opacity="{% if visual_style == 'quiet' %}0.84{% else %}1{% endif %}">
                          <path d="M130 150 L270 520 L455 190 L615 525 L775 145" stroke-width="{% if layout == 'timeline' %}7{% else %}9{% endif %}"/>
                          <path d="M270 520 H130 M455 190 H620 M615 525 H780" stroke-width="3" opacity="0.55"/>
                          <circle cx="130" cy="150" r="18" fill="currentColor"/><circle cx="775" cy="145" r="18" fill="currentColor"/>
                        </g>
                    {%- endcase -%}
                    {%- if visual_style == 'signal' -%}
                      <path d="M0 0H900V675H0Z" fill="none" stroke="currentColor" stroke-width="8" opacity="0.12"/>
                      <path d="M64 64H172M64 64V172M728 64H836M836 64V172M64 611H172M64 503V611M728 611H836M836 503V611" fill="none" stroke="var(--accent)" stroke-width="4" opacity="0.75"/>
                    {%- endif -%}
                    <text x="36" y="625" fill="currentColor" font-size="22" font-family="monospace" opacity="0.48">{{ block.settings.place | default: 'Route stop' }}</text>
                  </svg>
                {%- endif -%}
              </div>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink-950/35 via-transparent to-ink-950/20" aria-hidden="true"></div>
              {%- if settings.media_ambient -%}
                <span class="kx-ambient" aria-hidden="true"></span>
              {%- endif -%}
            </div>
            <div class="min-w-0 overflow-hidden {{ text_order_cls }} {{ text_edge_cls }} flex flex-col justify-start gap-4 border-t border-border-hairline p-5 md:border-t-0 md:p-8">
                {%- if block.settings.place != blank -%}
                  <span class="max-w-full break-words font-mono text-[10px] uppercase tracking-label text-text-muted">{{ block.settings.place }}</span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="max-w-xl break-words font-display text-h3 tracking-tight text-text-strong">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <div class="max-w-2xl break-words text-body text-text-body [&_p]:m-0 [&_p:not(:last-child)]:mb-3">{{ block.settings.caption }}</div>
                {%- endif -%}
                {%- if p != blank -%}
                  {%- render 'product-tile-compact', product: p, layout: 'row', image_width: 160, sizes: '72px', kicker: 'Featured', show_arrow: true, class: 'mt-1 flex min-w-0 items-center gap-4 overflow-hidden border border-border-hairline bg-surface-raised p-3 transition-colors hover:border-border-strong md:max-w-xl' -%}
                {%- endif -%}
                <span aria-hidden="true" class="mt-auto block h-px w-10 bg-border-hairline"></span>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.route-map.name",
  "tag": "section",
  "class": "section section--route-map",
  "settings": [
    { "type": "inline_richtext", "id": "subheading", "label": "t:sections.route-map.settings.subheading.label", "default": "Field route" },
    { "type": "text", "id": "heading", "label": "t:sections.route-map.settings.heading.label", "default": "The route" },
    { "type": "header", "content": "t:sections.route-map.settings.header__style.content" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.route-map.settings.layout.label",
      "default": "board",
      "options": [
        { "value": "board", "label": "t:sections.route-map.settings.layout.options__1.label" },
        { "value": "timeline", "label": "t:sections.route-map.settings.layout.options__2.label" }
      ]
    },
    {
      "type": "select",
      "id": "visual_style",
      "label": "t:sections.route-map.settings.visual_style.label",
      "default": "default",
      "options": [
        { "value": "default", "label": "t:sections.route-map.settings.visual_style.options__1.label" },
        { "value": "signal", "label": "t:sections.route-map.settings.visual_style.options__2.label" },
        { "value": "quiet", "label": "t:sections.route-map.settings.visual_style.options__3.label" }
      ]
    },
    { "type": "checkbox", "id": "show_index", "label": "t:sections.route-map.settings.show_index.label", "default": true },
    { "type": "checkbox", "id": "alternate_sides", "label": "Alternate image and text sides", "default": true },
    { "type": "select", "id": "row_density", "label": "Row density", "default": "relaxed", "options": [ { "value": "relaxed", "label": "Relaxed" }, { "value": "compact", "label": "Compact" } ] },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "landscape", "options": [ { "value": "landscape", "label": "Landscape" }, { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }, { "value": "wide", "label": "Wide" } ] },
    { "type": "select", "id": "width", "label": "Width", "default": "page", "options": [ { "value": "page", "label": "Page" }, { "value": "full", "label": "Full width" }, { "value": "narrow", "label": "Narrow" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.route-map.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px", "label": "t:sections.route-map.settings.padding_top.label" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px", "label": "t:sections.route-map.settings.padding_bottom.label" }
  ],
  "blocks": [
    {
      "type": "stop",
      "name": "t:sections.route-map.blocks.stop.name",
      "settings": [
        { "type": "text", "id": "place", "label": "t:sections.route-map.blocks.stop.settings.place.label", "default": "00.000 N / 00.000 W" },
        { "type": "text", "id": "heading", "label": "t:sections.route-map.blocks.stop.settings.heading.label", "default": "Stop" },
        { "type": "image_picker", "id": "image", "label": "t:sections.route-map.blocks.stop.settings.image.label" },
        { "type": "richtext", "id": "caption", "label": "t:sections.route-map.blocks.stop.settings.caption.label" },
        { "type": "product", "id": "product", "label": "t:sections.route-map.blocks.stop.settings.product.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.route-map.presets.name__1",
      "blocks": [
        { "type": "stop", "settings": { "place": "Transit", "heading": "Out the door", "caption": "<p>Shell on, pack loaded, headphones in. The system starts moving.</p>" } },
        { "type": "stop", "settings": { "place": "Trail", "heading": "Off the grid", "caption": "<p>Weather turns. The membrane holds. Keep moving.</p>" } },
        { "type": "stop", "settings": { "place": "Camp", "heading": "Hold position", "caption": "<p>Layer down, power up, reset for the next leg.</p>" } }
      ]
    }
  ]
}
{% endschema %}
