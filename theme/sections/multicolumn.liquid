{%- liquid
  assign s = section.settings
  assign kicker = s.subheading | default: 'The system'
  assign list_cols_cls = 'md:grid-cols-2'
  if s.list_columns == '1'
    assign list_cols_cls = ''
  endif
  case section.settings.width
    when 'full'
      assign width_cls = 'max-w-none'
    when 'narrow'
      assign width_cls = 'max-w-4xl'
    else
      assign width_cls = 'max-w-[var(--page-width)]'
  endcase
-%}
<section
  data-color-scheme="{{ s.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="border-y border-border-hairline bg-surface-page"
>
  <div class="mx-auto grid {{ width_cls }} px-6 md:grid-cols-[0.85fr_1.15fr]">
    <div class="border-b border-border-hairline bg-surface-page p-6 md:sticky md:top-24 md:self-start md:border-b-0 md:border-r md:p-8">
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ kicker }}</span>
      {%- if s.heading != blank -%}
        <h2 class="hp-reveal hp-reveal--fade mt-3 font-display text-h3 tracking-tight text-text-strong">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="mt-4 max-w-sm text-body leading-relaxed text-text-muted [&_p]:m-0">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.show_module_count -%}
        <div class="mt-8 grid grid-cols-2 border border-border-hairline font-mono text-[10px] uppercase tracking-label text-text-muted">
          <span class="border-r border-border-hairline p-3">Framework</span>
          <span class="p-3 text-right text-text-strong">{{ section.blocks.size }} modules</span>
        </div>
      {%- endif -%}
    </div>

    <ol class="grid bg-surface-page {{ list_cols_cls }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          {%- assign num = forloop.index -%}
          <li
            {{ block.shopify_attributes }}
            class="group grid grid-cols-[2.5rem_1fr] gap-x-5 gap-y-3 border-b border-border-hairline p-5 transition-colors hover:bg-surface-sunken md:grid-cols-[3rem_1fr] md:border-l md:p-7"
          >
            <span class="font-mono text-sm tabular-nums text-text-muted md:text-base">{% if num < 10 %}0{% endif %}{{ num }}</span>
            <h3 class="font-display text-h4 text-text-strong">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="col-start-2 max-w-md text-body leading-relaxed text-text-muted [&_p]:m-0">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "tag": "section",
  "class": "section section--multicolumn",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.multicolumn.settings.subheading.label",
      "default": "The system"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.multicolumn.settings.heading.label",
      "default": "Why Waypoint"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.multicolumn.settings.text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multicolumn.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_module_count",
      "label": "Show framework module count",
      "default": true
    },
    {
      "type": "select",
      "id": "list_columns",
      "label": "Columns (desktop)",
      "default": "2",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "page",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "full", "label": "Full width" },
        { "value": "narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.multicolumn.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.multicolumn.settings.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label",
          "default": "Feature"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets.name",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
