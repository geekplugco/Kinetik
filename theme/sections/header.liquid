    },
    {
      "type": "text",
      "id": "cart_upsell_heading",
      "label": "Upsell heading",
      "default": "Complete the kit"
    }
  ],
  "blocks": [
    {
      "type": "mega_panel",
      "name": "Mega menu panel",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item to replace",
          "info": "Enter the exact top-level menu item title, for example Shop or Gear."
