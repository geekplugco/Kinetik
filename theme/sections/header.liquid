      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_menu_featured",
      "label": "t:sections.header.settings.show_menu_featured.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account_icon",
      "label": "t:sections.header.settings.show_account_icon.label",
      "default": true
    },
    {
      "type": "header",
