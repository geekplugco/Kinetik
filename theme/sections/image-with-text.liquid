{%- liquid
  assign s = section.settings
  if s.layout == 'text_first'
    assign reverse = 'md:[direction:rtl]'
  else
    assign reverse = ''
  endif
  case s.width
    when 'full'
      assign width = 'max-w-none'
    when 'narrow'
      assign width = 'max-w-4xl'
    else
      assign width = 'max-w-[var(--page-width)]'
  endcase
  case s.image_ratio
    when 'square'
      assign ratio = 'aspect-square'
    when 'portrait'
      assign ratio = 'aspect-[3/4]'
    when 'wide'
      assign ratio = 'aspect-[16/9]'
    else
      assign ratio = 'aspect-[4/3]'
  endcase
  assign overlap_media = ''
  assign overlap_text = ''
  if s.media_style == 'overlap'
    assign overlap_media = 'md:scale-[1.02]'
    assign overlap_text = 'md:-ml-12 md:py-20'
  endif
  assign panel = ''
  if s.text_panel == 'dark'
    assign panel = 'theme-dark bg-surface-page'
  endif
  if s.content_alignment == 'center'
    assign content_align = 'items-center justify-center text-center'
  else
    assign content_align = 'items-start justify-center'
  endif
  assign media_label = s.subheading | default: 'Material proof'
-%}
<section
  data-color-scheme="{{ s.color_scheme }}"
  style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px"
  class="bg-surface-page pt-[var(--pt,0px)] pb-[var(--pb,0px)]"
>
  <div class="mx-auto grid gap-0 border-y border-border-hairline md:grid-cols-2 {{ width }} {{ reverse }}">
    <div class="kx-media-effect relative {{ ratio }} overflow-hidden border-border-hairline bg-surface-sunken md:aspect-auto md:min-h-[560px] md:border-r [direction:ltr] {{ overlap_media }}" {% render 'media-effect' %}>
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '50vw', widths: '400,600,800,1000,1400,1600', alt: s.image.alt, class: 'absolute inset-0 h-full w-full object-cover' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover bg-surface-sunken text-border-hairline' }}
      {%- endif -%}
      <div class="pointer-events-none absolute inset-x-4 top-4 flex items-center justify-between font-mono text-[10px] uppercase tracking-label text-paper mix-blend-difference">
        <span>{{ media_label }}</span>
        <span>Scan 01</span>
      </div>
      <div class="pointer-events-none absolute bottom-4 left-4 right-4 hidden border border-paper/30 bg-ink-950/55 px-3 py-2 font-mono text-[10px] uppercase tracking-label text-paper backdrop-blur-sm md:flex md:items-center md:justify-between">
        <span>Field image</span>
        <span>Proof frame</span>
      </div>
    </div>
    <div class="flex min-h-[440px] flex-col justify-center px-6 py-12 md:px-12 lg:px-16 [direction:ltr] {{ panel }} {{ overlap_text }}">
      <div class="max-w-xl border border-border-hairline bg-surface-page p-5 md:p-7">
        <div class="mb-5 flex items-center justify-between gap-4 border-b border-border-hairline pb-4 font-mono text-[10px] uppercase tracking-label text-text-muted">
          {%- if s.subheading != blank -%}
            <span>{{ s.subheading }}</span>
          {%- else -%}
            <span>System note</span>
          {%- endif -%}
          <span>01 / proof</span>
        </div>
        <div class="flex flex-col gap-5 {{ content_align }}">
          <h2 class="font-display text-h2 tracking-tight text-text-strong">{{ s.heading | default: 'Built to last' }}</h2>
          {%- if s.text != blank -%}
            <div class="max-w-prose text-body text-text-body [&_p]:m-0 [&_p:not(:last-child)]:mb-3">{{ s.text }}</div>
          {%- endif -%}
          <div class="grid w-full grid-cols-3 border border-border-hairline font-mono text-[10px] uppercase tracking-label">
            <span class="border-r border-border-hairline p-2 text-text-muted">Material</span>
            <span class="border-r border-border-hairline p-2 text-text-muted">Motion</span>
            <span class="p-2 text-text-muted">Repair</span>
          </div>
          {%- if s.button_label != blank -%}
            {%- render 'button', label: s.button_label, href: s.button_link, variant: 'secondary' -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "tag": "section",
  "class": "section section--image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image-with-text.settings.layout.label",
      "default": "image_first",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "text_first",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_style",
      "label": "t:sections.image-with-text.settings.media_style.label",
      "default": "split",
      "options": [
        {
          "value": "split",
          "label": "t:sections.image-with-text.settings.media_style.options__1.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.image-with-text.settings.media_style.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.image-with-text.settings.image_ratio.label",
      "default": "landscape",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.image-with-text.settings.image_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.image-with-text.settings.image_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.image-with-text.settings.image_ratio.options__3.label"
        },
        {
          "value": "wide",
          "label": "t:sections.image-with-text.settings.image_ratio.options__4.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.image-with-text.settings.content_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.content_alignment.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_panel",
      "label": "t:sections.image-with-text.settings.text_panel.label",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "t:sections.image-with-text.settings.text_panel.options__1.label"
        },
        {
          "value": "dark",
          "label": "t:sections.image-with-text.settings.text_panel.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.image-with-text.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.image-with-text.settings.width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.image-with-text.settings.width.options__2.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.image-with-text.settings.width.options__3.label"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.image-with-text.settings.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.image-with-text.settings.heading.label",
      "default": "Built to last"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.image-with-text.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image-with-text.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image-with-text.settings.button_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px",
      "label": "t:sections.image-with-text.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px",
      "label": "t:sections.image-with-text.settings.padding_bottom.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.image-with-text.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-with-text.presets.name__1"
    }
  ]
}
{% endschema %}
