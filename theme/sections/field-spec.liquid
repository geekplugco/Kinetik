{%- liquid
  assign p = product
  assign mf = p.metafields.custom

  assign material = mf.material.value
  assign weight = mf.weight.value
  assign dimensions = mf.dimensions.value
  assign compatibility = mf.compatibility.value
  assign care = mf.care.value
  assign fit_notes = mf.fit_notes.value
  assign use_cases = mf.use_cases.value
  assign size_chart = mf.size_chart.value

  assign spec_blocks = section.blocks | where: 'type', 'spec_row'
  assign badge_blocks = section.blocks | where: 'type', 'badge'

  assign has_specs = false
  if material != blank or weight != blank or dimensions != blank or compatibility != blank or care != blank or fit_notes != blank or spec_blocks.size > 0
    assign has_specs = true
  endif

  assign has_badges = false
  if use_cases != blank or badge_blocks.size > 0
    assign has_badges = true
  endif

  assign size_row_blocks = section.blocks | where: 'type', 'size_row'
  assign size_columns = section.settings.size_chart_col_1 | append: '|' | append: section.settings.size_chart_col_2 | append: '|' | append: section.settings.size_chart_col_3 | append: '|' | append: section.settings.size_chart_col_4 | append: '|' | append: section.settings.size_chart_col_5 | split: '|'

  assign size_source = ''
  if section.settings.show_size_guide
    if size_row_blocks.size > 0
      assign size_source = 'blocks'
    elsif size_chart != blank
      assign size_source = 'metafield'
    elsif section.settings.size_guide_page != blank
      assign size_source = 'page'
    endif
  endif

  assign show_section = false
  if has_specs or has_badges or size_source != blank
    assign show_section = true
  endif
-%}
{%- if show_section -%}
  <section
    data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
    style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px"
    class="bg-surface-page pt-[var(--pt,48px)] pb-[var(--pb,48px)]"
  >
    <div class="mx-auto max-w-[var(--page-width)] px-6">
      <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
        <div class="flex flex-col gap-3 md:max-w-xs">
          {%- if section.settings.subheading != blank -%}
            <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ section.settings.subheading }}</span>
          {%- endif -%}
          <h2 class="font-display text-h2 tracking-tight text-text-strong">{{ section.settings.heading | default: 'Field spec' }}</h2>
          {%- if has_badges -%}
            <div class="mt-2 flex flex-wrap gap-2">
              {%- if use_cases != blank -%}
                {%- for uc in use_cases -%}
                  <span class="border border-border-strong px-2.5 py-1 font-mono text-[11px] uppercase leading-none tracking-label text-text-strong">{{ uc }}</span>
                {%- endfor -%}
              {%- endif -%}
              {%- for b in badge_blocks -%}
                {%- if b.settings.label != blank -%}
                  <span class="border border-border-strong px-2.5 py-1 font-mono text-[11px] uppercase leading-none tracking-label text-text-strong" {{ b.shopify_attributes }}>{{ b.settings.label }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if size_source != blank -%}
            <size-guide class="mt-2 block">
              <button type="button" data-size-guide-open aria-haspopup="dialog" class="inline-flex min-h-[44px] items-center gap-2 self-start font-mono text-xs uppercase tracking-label text-text-strong underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent-press">
                {{ section.settings.size_guide_label | default: 'Size guide' }}
                <span aria-hidden="true">&#8599;</span>
              </button>
              <div data-size-guide-modal hidden class="fixed inset-0 kx-z-modal opacity-0 transition-opacity duration-300 motion-reduce:transition-none [&.is-open]:opacity-100">
                <div data-size-guide-close class="absolute inset-0 bg-ink-950/85"></div>
                <div role="dialog" aria-modal="true" aria-label="{{ section.settings.size_guide_label | default: 'Size guide' | escape }}" class="absolute inset-x-0 bottom-0 mx-auto max-h-[85vh] w-full overflow-y-auto border-t border-border-strong bg-surface-page md:inset-y-0 md:right-0 md:left-auto md:max-h-none md:w-[28rem] md:border-l md:border-t-0">
                  <div class="flex items-center justify-between border-b border-border-hairline px-6 py-4">
                    <span class="font-mono text-xs uppercase tracking-label text-text-strong">{{ section.settings.size_guide_label | default: 'Size guide' }}</span>
                    <button type="button" data-size-guide-close aria-label="Close size guide" class="font-mono text-xs uppercase tracking-label text-text-muted transition-colors hover:text-text-strong">Close</button>
                  </div>
                  <div class="prose-spec px-6 py-6 text-body text-text-body [&_h3]:mt-0 [&_h3]:mb-3 [&_h3]:font-mono [&_h3]:text-xs [&_h3]:uppercase [&_h3]:tracking-label [&_h3]:text-text-muted [&_table]:w-full [&_table]:border-collapse [&_table]:font-mono [&_table]:text-xs [&_td]:border [&_td]:border-border-hairline [&_td]:px-3 [&_td]:py-2 [&_th]:border [&_th]:border-border-hairline [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:uppercase [&_th]:tracking-label [&_p]:m-0 [&_p:not(:last-child)]:mb-3">
                    {%- if size_source == 'blocks' -%}
                      <table>
                        <thead>
                          <tr>
                            <th>{{ section.settings.size_chart_col_0 | default: 'Size' }}</th>
                            {%- for col in size_columns -%}
                              {%- if col != blank -%}<th>{{ col }}</th>{%- endif -%}
                            {%- endfor -%}
                          </tr>
                        </thead>
                        <tbody>
                          {%- for row in size_row_blocks -%}
                            <tr {{ row.shopify_attributes }}>
                              <th>{{ row.settings.label }}</th>
                              {%- if section.settings.size_chart_col_1 != blank -%}<td>{{ row.settings.value_1 }}</td>{%- endif -%}
                              {%- if section.settings.size_chart_col_2 != blank -%}<td>{{ row.settings.value_2 }}</td>{%- endif -%}
                              {%- if section.settings.size_chart_col_3 != blank -%}<td>{{ row.settings.value_3 }}</td>{%- endif -%}
                              {%- if section.settings.size_chart_col_4 != blank -%}<td>{{ row.settings.value_4 }}</td>{%- endif -%}
                              {%- if section.settings.size_chart_col_5 != blank -%}<td>{{ row.settings.value_5 }}</td>{%- endif -%}
                            </tr>
                          {%- endfor -%}
                        </tbody>
                      </table>
                      {%- if section.settings.size_chart_note != blank -%}
                        <p class="mt-3 text-text-muted">{{ section.settings.size_chart_note }}</p>
                      {%- endif -%}
                    {%- elsif size_source == 'metafield' -%}
                      {{ size_chart }}
                    {%- elsif size_source == 'page' -%}
                      {{ section.settings.size_guide_page.content }}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </size-guide>
            <script src="{{ 'size-guide.js' | asset_url }}" defer="defer"></script>
          {%- endif -%}
        </div>

        {%- if has_specs -%}
          <dl class="grid flex-1 grid-cols-2 border-l border-t border-border-hairline md:grid-cols-3">
            {%- if material != blank -%}
              <div class="border-r border-b border-border-hairline p-4 md:p-5">
                <dt class="font-mono text-xs uppercase tracking-label text-text-muted">Material</dt>
                <dd class="mt-2 font-mono text-sm text-text-strong [&_p]:m-0">{{ material }}</dd>
              </div>
            {%- endif -%}
            {%- if weight != blank -%}
              <div class="border-r border-b border-border-hairline p-4 md:p-5">
                <dt class="font-mono text-xs uppercase tracking-label text-text-muted">Weight</dt>
                <dd class="mt-2 font-mono text-sm text-text-strong">{{ weight }}</dd>
              </div>
            {%- endif -%}
            {%- if dimensions != blank -%}
              <div class="border-r border-b border-border-hairline p-4 md:p-5">
                <dt class="font-mono text-xs uppercase tracking-label text-text-muted">Dimensions</dt>
                <dd class="mt-2 font-mono text-sm text-text-strong">{{ dimensions }}</dd>
              </div>
            {%- endif -%}
            {%- if compatibility != blank -%}
              <div class="border-r border-b border-border-hairline p-4 md:p-5">
                <dt class="font-mono text-xs uppercase tracking-label text-text-muted">Compatibility</dt>
                <dd class="mt-2 font-mono text-sm text-text-strong [&_p]:m-0">{{ compatibility }}</dd>
              </div>
            {%- endif -%}
            {%- if fit_notes != blank -%}
              <div class="border-r border-b border-border-hairline p-4 md:p-5">
                <dt class="font-mono text-xs uppercase tracking-label text-text-muted">Fit</dt>
                <dd class="mt-2 font-mono text-sm text-text-strong [&_p]:m-0">{{ fit_notes }}</dd>
              </div>
            {%- endif -%}
            {%- if care != blank -%}
              <div class="border-r border-b border-border-hairline p-4 md:p-5">
                <dt class="font-mono text-xs uppercase tracking-label text-text-muted">Care</dt>
                <dd class="mt-2 font-mono text-sm text-text-strong [&_p]:m-0">{{ care }}</dd>
              </div>
            {%- endif -%}
            {%- for b in spec_blocks -%}
              {%- if b.settings.label != blank and b.settings.value != blank -%}
                <div class="border-r border-b border-border-hairline p-4 md:p-5" {{ b.shopify_attributes }}>
                  <dt class="font-mono text-xs uppercase tracking-label text-text-muted">{{ b.settings.label }}</dt>
                  <dd class="mt-2 font-mono text-sm text-text-strong [&_p]:m-0">{{ b.settings.value }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.field-spec.name",
  "tag": "section",
  "class": "section section--field-spec",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.field-spec.settings.subheading.label",
      "default": "Technical brief"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.field-spec.settings.heading.label",
      "default": "Field spec"
    },
    {
      "type": "header",
      "content": "t:sections.field-spec.settings.header__size.content"
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "t:sections.field-spec.settings.show_size_guide.label",
      "default": true
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "t:sections.field-spec.settings.size_guide_label.label",
      "default": "Size guide"
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "t:sections.field-spec.settings.size_guide_page.label",
      "info": "t:sections.field-spec.settings.size_guide_page.info"
    },
    {
      "type": "paragraph",
      "content": "Add Size chart row blocks below to build a table instead -- it takes priority over the page and metafield options above."
    },
    {
      "type": "text",
      "id": "size_chart_col_0",
      "label": "Row label column heading",
      "default": "Size"
    },
    {
      "type": "text",
      "id": "size_chart_col_1",
      "label": "Column 2 heading",
      "default": "Chest"
    },
    {
      "type": "text",
      "id": "size_chart_col_2",
      "label": "Column 3 heading",
      "default": "Waist"
    },
    {
      "type": "text",
      "id": "size_chart_col_3",
      "label": "Column 4 heading (optional)"
    },
    {
      "type": "text",
      "id": "size_chart_col_4",
      "label": "Column 5 heading (optional)"
    },
    {
      "type": "text",
      "id": "size_chart_col_5",
      "label": "Column 6 heading (optional)"
    },
    {
      "type": "text",
      "id": "size_chart_note",
      "label": "Note below the chart (optional)",
      "default": "All measurements in inches, laid flat."
    },
    {
      "type": "header",
      "content": "t:sections.field-spec.settings.header__style.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.field-spec.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "label": "t:sections.field-spec.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "label": "t:sections.field-spec.settings.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "spec_row",
      "name": "t:sections.field-spec.blocks.spec_row.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.field-spec.blocks.spec_row.settings.label.label",
          "default": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.field-spec.blocks.spec_row.settings.value.label",
          "default": "Value"
        }
      ]
    },
    {
      "type": "badge",
      "name": "t:sections.field-spec.blocks.badge.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.field-spec.blocks.badge.settings.label.label",
          "default": "Weatherproof"
        }
      ]
    },
    {
      "type": "size_row",
      "name": "Size chart row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "M"
        },
        {
          "type": "text",
          "id": "value_1",
          "label": "Value 1"
        },
        {
          "type": "text",
          "id": "value_2",
          "label": "Value 2"
        },
        {
          "type": "text",
          "id": "value_3",
          "label": "Value 3"
        },
        {
          "type": "text",
          "id": "value_4",
          "label": "Value 4"
        },
        {
          "type": "text",
          "id": "value_5",
          "label": "Value 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.field-spec.presets.name__1",
      "blocks": [
        { "type": "spec_row" },
        { "type": "spec_row" },
        { "type": "badge" }
      ]
    }
  ]
}
{% endschema %}
