{%- liquid
  assign points = section.blocks | where: 'type', 'point'
  assign layout = section.settings.layout | default: 'split'
  assign image_position = section.settings.image_position | default: 'left'
  assign image_ratio = section.settings.image_ratio | default: '4_3'
  assign visual_effect = section.settings.visual_effect
  if visual_effect == blank
    assign visual_effect = 'default'
  endif
  assign effect_override = visual_effect
  if visual_effect == 'zoom'
    assign effect_override = 'none'
  endif
  assign show_scan_line = true
  if visual_effect == 'none'
    assign show_scan_line = false
  endif
  if visual_effect == 'default' and settings.media_effect == 'none'
    assign show_scan_line = false
  endif
  assign panel_style = section.settings.panel_style | default: 'attached'
  assign show_section = false
  if points.size > 0
    assign show_section = true
  endif
  case image_ratio
    when 'square'
      assign ratio_cls = 'aspect-square'
    when 'portrait'
      assign ratio_cls = 'aspect-[4/5]'
    when 'wide'
      assign ratio_cls = 'aspect-[16/9]'
    else
      assign ratio_cls = 'aspect-[4/3]'
  endcase
  assign scan_grid_cls = 'grid gap-10 md:grid-cols-[1.35fr_0.65fr] md:items-stretch md:gap-14'
  if layout == 'stacked'
    assign scan_grid_cls = 'grid gap-10'
  endif
  assign details_cls = 'flex flex-col divide-y divide-border-hairline'
  if layout == 'stacked'
    assign details_cls = 'grid divide-x divide-border-hairline md:grid-cols-3'
  endif
  if image_position == 'right' and layout == 'split'
    assign media_order = 'md:order-2'
    assign details_order = 'md:order-1'
  endif
  assign detail_button_cls = 'group/row flex w-full items-start gap-5 py-6 text-left first:pt-0 last:pb-0'
  if panel_style == 'cards'
    assign detail_button_cls = 'group/row mb-3 flex w-full items-start gap-5 border border-border-hairline bg-surface-card px-5 py-5 text-left transition-colors last:mb-0 aria-pressed:border-border-strong'
  endif
  case section.settings.width
    when 'full'
      assign width_cls = 'max-w-none'
    when 'narrow'
      assign width_cls = 'max-w-4xl'
    else
      assign width_cls = 'max-w-[var(--page-width)]'
  endcase
-%}
{%- if show_section -%}
  <section
    data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-3' }}"
    style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px"
    class="bg-surface-page pt-[var(--pt,72px)] pb-[var(--pb,72px)] text-text-strong"
  >
    <div class="mx-auto {{ width_cls }} px-6">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6 md:mb-16">
        <div class="max-w-2xl">
          {%- if section.settings.subheading != blank -%}
            <span class="font-mono text-xs uppercase tracking-label text-accent">{{ section.settings.subheading }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="mt-3 font-display text-display-2 tracking-tight text-balance">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        <div class="flex shrink-0 items-baseline gap-2 font-mono text-xs uppercase tracking-label text-text-muted">
          <span class="text-h3 font-display text-text-strong">{{ points.size | prepend: '0' | slice: -2, 2 }}</span>
          <span>{{ points.size | pluralize: 'point', 'points' }} on record</span>
        </div>
      </div>
      <material-scan class="{{ scan_grid_cls }}">
        <div data-scan-stage class="relative overflow-hidden bg-surface-sunken {{ media_order }}">
          <div class="kx-media-effect relative {{ ratio_cls }}" {% render 'media-effect', override: effect_override, surface: 'proof' %}>
            {%- if section.settings.image != blank -%}
              {%- assign scan_alt = section.settings.image.alt | default: section.settings.heading -%}
              {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700,1050,1400', sizes: '(min-width:990px) 45vw, 100vw', alt: scan_alt, class: 'h-full w-full object-cover' }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'h-full w-full object-cover bg-surface-sunken text-border-hairline' }}
            {%- endif -%}
            {%- if settings.media_ambient -%}
              <span class="kx-ambient" aria-hidden="true"></span>
            {%- endif -%}
            {%- if show_scan_line -%}
              <span data-scan-line aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 z-10 h-px bg-accent opacity-0"></span>
            {%- endif -%}
            <span class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-1/2 bg-gradient-to-t from-ink-950/55 to-transparent" aria-hidden="true"></span>
            {%- for point in points -%}
              <button type="button" data-scan-point data-index="{{ forloop.index }}" aria-label="Point {{ forloop.index }}: {{ point.settings.label | default: 'Detail' | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" style="left:{{ point.settings.x | default: 50 }}%;top:{{ point.settings.y | default: 50 }}%" class="absolute z-10 flex h-9 w-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-paper font-mono text-xs text-ink-950 shadow-[0_2px_14px_rgba(10,10,10,0.4)] transition-transform hover:scale-110 aria-pressed:scale-125 aria-pressed:bg-accent aria-pressed:text-accent-ink">
                <span class="absolute inset-0 -z-10 rounded-full border border-paper/60 aria-pressed:border-accent" aria-hidden="true" style="inset:-8px"></span>
                {{ forloop.index }}
              </button>
            {%- endfor -%}
          </div>
        </div>
        <ul class="{{ details_cls }} {{ details_order }}">
          {%- for point in points -%}
            <li class="{% if panel_style == 'cards' %}px-0{% else %}px-0{% endif %}">
              <button type="button" data-scan-detail data-index="{{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" class="{{ detail_button_cls }} border-l-2 border-transparent pl-5 transition-[border-color] aria-pressed:border-accent">
                <span class="shrink-0 pt-1 font-mono text-xs text-text-faint group-aria-pressed/row:text-text-strong">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="flex flex-col gap-2">
                  <span class="font-display text-h4 tracking-tight text-text-strong">{{ point.settings.label | default: 'Detail' }}</span>
                  {%- if point.settings.detail != blank -%}
                    <span data-scan-detail-body class="max-w-md text-body text-text-muted [&_p]:m-0">{{ point.settings.detail }}</span>
                  {%- endif -%}
                </span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      </material-scan>
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <div class="mt-10">{%- render 'button', label: section.settings.cta_label, href: section.settings.cta_url, variant: 'secondary' -%}</div>
      {%- endif -%}
    </div>
  </section>
  <script src="{{ 'material-scan.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.material-scan.name",
  "tag": "section",
  "class": "section section--material-scan",
  "settings": [
    { "type": "inline_richtext", "id": "subheading", "label": "t:sections.material-scan.settings.subheading.label", "default": "Material scan" },
    { "type": "text", "id": "heading", "label": "t:sections.material-scan.settings.heading.label", "default": "Engineered, not decorated" },
    { "type": "image_picker", "id": "image", "label": "t:sections.material-scan.settings.image.label" },
    { "type": "text", "id": "cta_label", "label": "t:sections.material-scan.settings.cta_label.label" },
    { "type": "url", "id": "cta_url", "label": "t:sections.material-scan.settings.cta_url.label" },
    { "type": "header", "content": "t:sections.material-scan.settings.header__style.content" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.material-scan.settings.layout.label",
      "default": "split",
      "options": [
        { "value": "split", "label": "t:sections.material-scan.settings.layout.options__1.label" },
        { "value": "stacked", "label": "t:sections.material-scan.settings.layout.options__2.label" }
      ]
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.material-scan.settings.image_position.label",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:sections.material-scan.settings.image_position.options__1.label" },
        { "value": "right", "label": "t:sections.material-scan.settings.image_position.options__2.label" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.material-scan.settings.image_ratio.label",
      "default": "4_3",
      "options": [
        { "value": "4_3", "label": "t:sections.material-scan.settings.image_ratio.options__1.label" },
        { "value": "wide", "label": "t:sections.material-scan.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.material-scan.settings.image_ratio.options__3.label" },
        { "value": "portrait", "label": "t:sections.material-scan.settings.image_ratio.options__4.label" }
      ]
    },
    {
      "type": "select",
      "id": "visual_effect",
      "label": "t:sections.material-scan.settings.visual_effect.label",
      "default": "default",
      "options": [
        { "value": "default", "label": "t:sections.material-scan.settings.visual_effect.options__1.label" },
        { "value": "scan", "label": "t:sections.material-scan.settings.visual_effect.options__2.label" },
        { "value": "zoom", "label": "t:sections.material-scan.settings.visual_effect.options__3.label" },
        { "value": "none", "label": "t:sections.material-scan.settings.visual_effect.options__4.label" }
      ]
    },
    {
      "type": "select",
      "id": "panel_style",
      "label": "t:sections.material-scan.settings.panel_style.label",
      "default": "attached",
      "options": [
        { "value": "attached", "label": "t:sections.material-scan.settings.panel_style.options__1.label" },
        { "value": "cards", "label": "t:sections.material-scan.settings.panel_style.options__2.label" }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "page",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "full", "label": "Full width" },
        { "value": "narrow", "label": "Narrow" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.material-scan.settings.color_scheme.label", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px", "label": "t:sections.material-scan.settings.padding_top.label" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px", "label": "t:sections.material-scan.settings.padding_bottom.label" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.material-scan.blocks.point.name",
      "settings": [
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "default": 50, "unit": "%", "label": "t:sections.material-scan.blocks.point.settings.x.label" },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "default": 50, "unit": "%", "label": "t:sections.material-scan.blocks.point.settings.y.label" },
        { "type": "text", "id": "label", "label": "t:sections.material-scan.blocks.point.settings.label.label", "default": "GORE-TEX 3L" },
        { "type": "richtext", "id": "detail", "label": "t:sections.material-scan.blocks.point.settings.detail.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.material-scan.presets.name__1",
      "blocks": [
        { "type": "point", "settings": { "x": 30, "y": 35, "label": "GORE-TEX 3L shell", "detail": "<p>Waterproof, windproof, breathable membrane bonded to a ripstop face.</p>" } },
        { "type": "point", "settings": { "x": 65, "y": 55, "label": "Taped seams", "detail": "<p>Every seam fully taped to keep water out under pressure.</p>" } },
        { "type": "point", "settings": { "x": 45, "y": 78, "label": "YKK AquaGuard", "detail": "<p>Water-resistant zippers with bonded storm flaps.</p>" } }
      ]
    }
  ]
}
{% endschema %}
