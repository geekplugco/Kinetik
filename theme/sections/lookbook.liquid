          "label": "Frame label"
        },
        {
          "type": "text",
          "id": "overlay_label",
          "label": "Overlay label",
          "default": "Loadout map"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.lookbook.blocks.shot.settings.caption.label"
        },
        {
          "type": "header",
          "content": "t:sections.lookbook.blocks.shot.settings.header__1.content"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "t:sections.lookbook.blocks.shot.settings.product_1.label"
        },
        {
          "type": "range",
          "id": "x_1",
          "label": "t:sections.lookbook.blocks.shot.settings.x_1.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 25
        },
        {
          "type": "range",
          "id": "y_1",
          "label": "t:sections.lookbook.blocks.shot.settings.y_1.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 40
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "t:sections.lookbook.blocks.shot.settings.product_2.label"
        },
        {
          "type": "range",
          "id": "x_2",
          "label": "t:sections.lookbook.blocks.shot.settings.x_2.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 60
        },
        {
          "type": "range",
          "id": "y_2",
          "label": "t:sections.lookbook.blocks.shot.settings.y_2.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 65
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "t:sections.lookbook.blocks.shot.settings.product_3.label"
        },
        {
          "type": "range",
          "id": "x_3",
          "label": "t:sections.lookbook.blocks.shot.settings.x_3.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 45
        },
        {
          "type": "range",
          "id": "y_3",
          "label": "t:sections.lookbook.blocks.shot.settings.y_3.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 80
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "t:sections.lookbook.blocks.shot.settings.product_4.label"
        },
        {
          "type": "range",
          "id": "x_4",
          "label": "t:sections.lookbook.blocks.shot.settings.x_4.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 75
        },
        {
          "type": "range",
          "id": "y_4",
          "label": "t:sections.lookbook.blocks.shot.settings.y_4.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 30
        }
      ]
    },
    {
      "type": "note",
      "name": "Editorial note",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Field note"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Built as a system"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use notes between frames to explain the kit, material choices, or campaign context without breaking the shopping path.</p>"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "medium",
          "options": [
            {
              "value": "narrow",
              "label": "Narrow"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "wide",
              "label": "Wide"
            }
          ]
        },
        {
