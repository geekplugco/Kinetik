{%- liquid
  assign s = section.settings
  assign shots = section.blocks | where: 'type', 'shot'

  case s.image_ratio
    when 'square'
      assign ratio_cls = 'aspect-square'
    when 'landscape'
      assign ratio_cls = 'aspect-[4/3]'
    when 'wide'
      assign ratio_cls = 'aspect-[16/9]'
    else
      assign ratio_cls = 'aspect-[4/5]'
  endcase

  case s.width
    when 'full'
      assign width_cls = 'max-w-none'
    when 'narrow'
      assign width_cls = 'max-w-4xl'
    else
      assign width_cls = 'max-w-[var(--page-width)]'
  endcase

  assign is_grid = false
  if s.layout == 'grid'
    assign is_grid = true
  endif
  assign is_editorial = false
  if s.layout == 'editorial'
    assign is_editorial = true
  endif
  case s.editorial_density
    when 'spacious'
      assign editorial_gap = 40
      assign editorial_side_offset = 'md:mt-28'
    when 'balanced'
      assign editorial_gap = 24
      assign editorial_side_offset = ''
    else
      assign editorial_gap = 16
      assign editorial_side_offset = ''
  endcase
  if is_grid or is_editorial
    assign shot_sizes = '(min-width:750px) 50vw, 100vw'
  else
    assign shot_sizes = '(min-width:990px) 80vw, 100vw'
  endif
-%}
<section
  data-color-scheme="{{ s.color_scheme | default: 'scheme-1' }}"
  style="--pt:{{ s.padding_top | default: 0 }}px;--pb:{{ s.padding_bottom | default: 0 }}px"
  class="bg-surface-page pt-[var(--pt,clamp(4rem,7vw,6rem))] pb-[var(--pb,clamp(4rem,7vw,6rem))]"
>
  <look-book class="mx-auto block {{ width_cls }} px-6">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6 md:mb-16">
      <div class="max-w-2xl">
        <span class="font-mono text-xs uppercase tracking-label text-accent-press">{{ s.kicker | default: 'Lookbook' }}</span>
        {%- if s.heading != blank -%}<h2 class="mt-3 font-display text-display-2 tracking-tight text-balance text-text-strong">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="mt-5 max-w-md text-body text-text-muted [&_p]:m-0">{{ s.text }}</div>{%- endif -%}
      </div>
      <div class="flex shrink-0 items-baseline gap-2 font-mono text-xs uppercase tracking-label text-text-muted">
        <span class="text-h3 font-display text-text-strong">{{ shots.size | prepend: '0' | slice: -2, 2 }}</span>
        <span>shoppable frame{{ shots.size | pluralize: '', 's' }}</span>
      </div>
    </div>

    <div class="{% if is_editorial %}grid grid-cols-12 items-start{% elsif is_grid %}grid gap-4 md:grid-cols-2 md:gap-6{% else %}flex flex-col gap-8 md:gap-12{% endif %}"{% if is_editorial %} style="gap: {{ editorial_gap }}px;"{% endif %}>
      {%- assign shot_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'note' -%}
          {%- assign n = block.settings -%}
          {%- if is_editorial -%}
            {%- case n.width -%}
              {%- when 'wide' -%}{%- assign note_cls = 'col-span-12 md:col-span-8' -%}
              {%- when 'narrow' -%}{%- assign note_cls = 'col-span-12 md:col-span-3' -%}
              {%- else -%}{%- assign note_cls = 'col-span-12 md:col-span-4' -%}
            {%- endcase -%}
          {%- elsif is_grid -%}
            {%- case n.width -%}
              {%- when 'narrow' -%}{%- assign note_cls = 'col-span-2 md:col-span-1' -%}
              {%- else -%}{%- assign note_cls = 'col-span-2' -%}
            {%- endcase -%}
          {%- else -%}
            {%- case n.width -%}
              {%- when 'wide' -%}{%- assign note_cls = 'w-full' -%}
              {%- when 'narrow' -%}{%- assign note_cls = 'w-full max-w-md' -%}
              {%- else -%}{%- assign note_cls = 'w-full max-w-2xl' -%}
            {%- endcase -%}
          {%- endif -%}
          <article class="flex min-h-44 flex-col border border-border-hairline bg-surface-page p-5 md:p-6 {% if is_editorial %}md:self-center{% else %}justify-between md:h-full{% endif %} {{ note_cls }}" {{ block.shopify_attributes }}>
            <div>
              {%- if n.kicker != blank -%}<span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ n.kicker }}</span>{%- endif -%}
              {%- if n.heading != blank -%}<h3 class="mt-3 font-display text-h3 tracking-tight text-text-strong">{{ n.heading }}</h3>{%- endif -%}
              {%- if n.text != blank -%}<div class="mt-4 max-w-md text-body text-text-body [&_p]:m-0 [&_p:not(:last-child)]:mb-3">{{ n.text }}</div>{%- endif -%}
            </div>
            {%- if n.link_label != blank and n.link_url != blank -%}
              <a href="{{ n.link_url }}" class="mt-6 inline-flex min-h-[44px] items-center gap-2 self-start font-mono text-xs uppercase tracking-label text-text-strong underline underline-offset-4 hover:text-accent-press">{{ n.link_label }} <span aria-hidden="true">&#8599;</span></a>
            {%- endif -%}
          </article>
          {%- continue -%}
        {%- endif -%}
        {%- if block.type != 'shot' -%}{%- continue -%}{%- endif -%}
        {%- assign shot_index = shot_index | plus: 1 -%}
        {%- assign b = block.settings -%}
        {%- assign cell_cls = '' -%}
        {%- assign cell_ratio = ratio_cls -%}
        {%- if is_editorial -%}
          {%- assign pat = forloop.index0 | modulo: 3 -%}
          {%- if pat == 0 -%}
            {%- assign cell_cls = 'col-span-12 md:col-span-8' -%}
            {%- assign cell_ratio = 'aspect-[4/5] md:aspect-[3/2]' -%}
          {%- elsif pat == 1 -%}
            {%- assign cell_cls = 'col-span-12 md:col-span-4 ' | append: editorial_side_offset -%}
            {%- assign cell_ratio = 'aspect-[3/4]' -%}
          {%- else -%}
            {%- assign cell_cls = 'col-span-12' -%}
            {%- assign cell_ratio = 'aspect-[16/9]' -%}
          {%- endif -%}
        {%- endif -%}
        {%- case b.frame_size -%}
          {%- when 'feature' -%}
            {%- assign cell_ratio = 'aspect-[4/5] md:aspect-[3/2]' -%}
            {%- if is_editorial -%}{%- assign cell_cls = 'col-span-12 md:col-span-8' -%}
            {%- elsif is_grid -%}{%- assign cell_cls = 'col-span-2' -%}
            {%- endif -%}
          {%- when 'tall' -%}
            {%- assign cell_ratio = 'aspect-[3/4]' -%}
            {%- if is_editorial -%}{%- assign cell_cls = 'col-span-12 md:col-span-4' -%}
            {%- elsif is_grid -%}{%- assign cell_cls = 'col-span-2 md:col-span-1' -%}
            {%- endif -%}
          {%- when 'wide' -%}
            {%- assign cell_ratio = 'aspect-[16/9]' -%}
            {%- if is_editorial -%}
              {%- assign cell_ratio = 'aspect-[16/9] md:aspect-[16/10]' -%}
              {%- assign cell_cls = 'col-span-12 md:col-span-8' -%}
            {%- elsif is_grid -%}{%- assign cell_cls = 'col-span-2' -%}
            {%- endif -%}
          {%- when 'square' -%}
            {%- assign cell_ratio = 'aspect-square' -%}
            {%- if is_editorial -%}{%- assign cell_cls = 'col-span-12 md:col-span-4' -%}
            {%- elsif is_grid -%}{%- assign cell_cls = 'col-span-2 md:col-span-1' -%}
            {%- endif -%}
        {%- endcase -%}
        {%- case b.focal_point -%}
          {%- when 'top' -%}{%- assign focal_cls = 'object-top' -%}
          {%- when 'bottom' -%}{%- assign focal_cls = 'object-bottom' -%}
          {%- when 'left' -%}{%- assign focal_cls = 'object-left' -%}
          {%- when 'right' -%}{%- assign focal_cls = 'object-right' -%}
          {%- when 'left-top' -%}{%- assign focal_cls = 'object-left-top' -%}
          {%- when 'right-top' -%}{%- assign focal_cls = 'object-right-top' -%}
          {%- when 'left-bottom' -%}{%- assign focal_cls = 'object-left-bottom' -%}
          {%- when 'right-bottom' -%}{%- assign focal_cls = 'object-right-bottom' -%}
          {%- else -%}{%- assign focal_cls = 'object-center' -%}
        {%- endcase -%}
        <figure class="group flex flex-col {{ cell_cls }}" {{ block.shopify_attributes }}>
          <div class="relative {{ cell_ratio }} w-full overflow-hidden bg-surface-sunken">
            <div class="pointer-events-none absolute left-3 top-3 z-20 flex items-center gap-2 bg-ink-950/70 px-2.5 py-1.5 font-mono text-[10px] uppercase tracking-label text-paper backdrop-blur-sm">
              <span class="text-accent" data-accent-ok>{% if shot_index < 10 %}0{% endif %}{{ shot_index }}</span>
              <span class="text-paper/60">/</span>
              <span>{% if b.frame_label != blank %}{{ b.frame_label }}{% else %}{{ b.overlay_label | default: 'Loadout map' }}{% endif %}</span>
            </div>
            {%- if b.image != blank -%}
              <div class="kx-media-effect absolute inset-0" {% render 'media-effect' %}>
                {{ b.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: shot_sizes, alt: b.image_alt, class: 'absolute inset-0 h-full w-full object-cover ' | append: focal_cls }}
              </div>
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover text-border-hairline' }}
            {%- endif -%}

            {%- assign has_hotspot = false -%}
            {%- for i in (1..4) -%}
              {%- assign pkey = 'product_' | append: i -%}
              {%- assign xkey = 'x_' | append: i -%}
              {%- assign ykey = 'y_' | append: i -%}
              {%- assign p = b[pkey] -%}
              {%- if p == blank -%}{%- continue -%}{%- endif -%}
              {%- assign has_hotspot = true -%}
              {%- assign hx = b[xkey] | default: 50 -%}
              {%- assign hy = b[ykey] | default: 50 -%}
              <div class="group/hs absolute z-10 -translate-x-1/2 -translate-y-1/2" style="left:{{ hx }}%;top:{{ hy }}%" data-hotspot-item>
                <button type="button" aria-label="Shop {{ p.title | escape }}" aria-expanded="false" data-hotspot class="relative flex h-9 w-9 items-center justify-center rounded-full bg-paper text-ink-950 shadow-[0_2px_14px_rgba(10,10,10,0.4)] outline-none ring-accent transition-transform hover:scale-110 focus-visible:ring-2">
                  <span class="absolute inset-0 animate-ping rounded-full bg-accent/60 motion-reduce:animate-none" aria-hidden="true"></span>
                  {%- render 'icon', name: 'plus', size: 14 -%}
                </button>
                <div data-tip class="pointer-events-none absolute bottom-[calc(100%+10px)] left-1/2 z-20 w-56 -translate-x-1/2 translate-y-1 border border-border-hairline bg-surface-page p-3 opacity-0 shadow-xl transition-[transform,opacity] duration-200 motion-reduce:transition-none group-hover/hs:pointer-events-auto group-hover/hs:translate-y-0 group-hover/hs:opacity-100 group-focus-within/hs:pointer-events-auto group-focus-within/hs:translate-y-0 group-focus-within/hs:opacity-100">
                  {%- render 'product-tile-compact', product: p, layout: 'row', image_width: 112, sizes: '56px', show_code: true -%}
                  {%- if p.available -%}
                    <quick-add>
                      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                        <button type="submit" class="mt-3 flex w-full items-center justify-center gap-2 bg-accent px-3 py-2 font-mono text-[11px] uppercase tracking-label text-accent-ink transition-colors hover:bg-accent-hover">
                          {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }} {%- render 'icon', name: 'arrow', size: 13 -%}
                        </button>
                      </form>
                    </quick-add>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- if has_hotspot -%}
            <ul class="mt-4 flex gap-3 overflow-x-auto pb-2 md:hidden">
              {%- for i in (1..4) -%}
                {%- assign pkey = 'product_' | append: i -%}
                {%- assign p = b[pkey] -%}
                {%- if p == blank -%}{%- continue -%}{%- endif -%}
                <li class="shrink-0">
                  {%- render 'product-tile-compact', product: p, layout: 'row', image_width: 112, sizes: '56px', class: 'flex w-44 items-center gap-3 border border-border-hairline p-2' -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if b.caption != blank -%}
            <figcaption class="mt-4 flex items-center gap-2.5 font-mono text-xs uppercase tracking-label text-text-muted">
              <span class="h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
              {{ b.caption }}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </look-book>
</section>
<script src="{{ 'lookbook.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.lookbook.name",
  "tag": "section",
  "class": "section section--lookbook",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.lookbook.settings.kicker.label",
      "default": "Lookbook"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.lookbook.settings.heading.label",
      "default": "Shot in the field"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.lookbook.settings.text.label"
    },
    {
      "type": "select",
      "id": "heading_layout",
      "label": "t:sections.lookbook.settings.heading_layout.label",
      "default": "bar",
      "options": [
        {
          "value": "bar",
          "label": "t:sections.lookbook.settings.heading_layout.options__1.label"
        },
        {
          "value": "framed",
          "label": "t:sections.lookbook.settings.heading_layout.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.lookbook.settings.layout.label",
      "default": "single",
      "options": [
        {
          "value": "single",
          "label": "t:sections.lookbook.settings.layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.lookbook.settings.layout.options__2.label"
        },
        {
          "value": "editorial",
          "label": "t:sections.lookbook.settings.layout.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "editorial_density",
      "label": "t:sections.lookbook.settings.editorial_density.label",
      "default": "compact",
      "options": [
        {
          "value": "compact",
          "label": "t:sections.lookbook.settings.editorial_density.options__1.label"
        },
        {
          "value": "balanced",
          "label": "t:sections.lookbook.settings.editorial_density.options__2.label"
        },
        {
          "value": "spacious",
          "label": "t:sections.lookbook.settings.editorial_density.options__3.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.lookbook.settings.image_ratio.label",
      "default": "portrait",
      "options": [
        {
          "value": "portrait",
          "label": "t:sections.lookbook.settings.image_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.lookbook.settings.image_ratio.options__2.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.lookbook.settings.image_ratio.options__3.label"
        },
        {
          "value": "wide",
          "label": "t:sections.lookbook.settings.image_ratio.options__4.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.lookbook.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.lookbook.settings.width.options__1.label"
        },
        {
          "value": "full",
          "label": "t:sections.lookbook.settings.width.options__2.label"
        },
        {
          "value": "narrow",
          "label": "t:sections.lookbook.settings.width.options__3.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.lookbook.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.lookbook.settings.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.lookbook.settings.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "t:sections.lookbook.blocks.shot.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.lookbook.blocks.shot.settings.image.label"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:sections.lookbook.blocks.shot.settings.image_alt.label"
        },
        {
          "type": "select",
          "id": "focal_point",
          "label": "Focal point",
          "default": "center",
          "options": [
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            },
            {
              "value": "left-top",
              "label": "Left top"
            },
            {
              "value": "right-top",
              "label": "Right top"
            },
            {
              "value": "left-bottom",
              "label": "Left bottom"
            },
            {
              "value": "right-bottom",
              "label": "Right bottom"
            }
          ]
        },
        {
          "type": "select",
          "id": "frame_size",
          "label": "Frame size",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto pattern"
            },
            {
              "value": "feature",
              "label": "Feature wide"
            },
            {
              "value": "tall",
              "label": "Tall side frame"
            },
            {
              "value": "wide",
              "label": "Full wide"
            },
            {
              "value": "square",
              "label": "Square"
            }
          ]
        },
        {
          "type": "text",
