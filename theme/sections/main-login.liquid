{%- liquid
  assign recover_done = false
  assign field = 'border border-border-strong bg-transparent px-4 py-3 text-text-strong outline-none transition-colors focus-visible:border-accent'
-%}
{%- capture recover_block -%}
  {%- form 'recover_customer_password', class: 'mt-5 grid gap-4' -%}
    {%- if form.posted_successfully? -%}
      {%- assign recover_done = true -%}
      <div class="border border-positive px-4 py-3 text-sm text-positive" aria-live="polite">We've sent you an email with a link to update your password.</div>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="border border-state-error px-4 py-3 text-sm text-state-error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label class="grid gap-1">
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'customer.login.email' | t | default: 'Email' }}</span>
      <input type="email" name="email" autocomplete="email" required class="{{ field }}">
    </label>
    <button type="submit" class="bg-accent px-6 py-3 font-mono text-xs uppercase tracking-label text-accent-ink transition-colors hover:bg-accent-hover{% if settings.button_style == 'rounded' %} rounded-full{% endif %}">Send reset link</button>
  {%- endform -%}
{%- endcapture -%}
<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="mx-auto max-w-[420px] px-6"
>
  <h1 class="font-display text-h1 tracking-tight text-text-strong">{{ 'customer.login.title' | t | default: 'Sign in' }}</h1>

  {%- form 'customer_login', class: 'mt-8 grid gap-4' -%}
    {%- if form.errors -%}
      <div class="border border-state-error px-4 py-3 text-sm text-state-error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label class="grid gap-1">
      <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'customer.login.email' | t | default: 'Email' }}</span>
      <input type="email" name="customer[email]" autocomplete="email" required class="{{ field }}">
    </label>
    {%- if form.password_needed -%}
      <label class="grid gap-1">
        <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ 'customer.login.password' | t | default: 'Password' }}</span>
        <input type="password" name="customer[password]" autocomplete="current-password" required class="{{ field }}">
      </label>
    {%- endif -%}
    <button type="submit" class="mt-2 bg-accent px-6 py-3 font-mono text-xs uppercase tracking-label text-accent-ink transition-colors hover:bg-accent-hover{% if settings.button_style == 'rounded' %} rounded-full{% endif %}">{{ 'customer.login.sign_in' | t | default: 'Sign in' }}</button>
  {%- endform -%}

  <details id="recover" class="mt-6 border-t border-border-hairline pt-6"{% if recover_done %} open{% endif %}>
    <summary class="cursor-pointer list-none font-mono text-xs uppercase tracking-label text-text-muted transition-colors hover:text-text-strong">Forgot your password?</summary>
    {{ recover_block }}
  </details>

  <p class="mt-6 font-mono text-xs uppercase tracking-label text-text-muted">
    {{ 'customer.login.no_account' | t | default: 'New here?' }}
    <a href="{{ routes.account_register_url }}" class="text-text-strong underline underline-offset-4 transition-colors hover:text-accent-press">{{ 'customer.register.title' | t | default: 'Create account' }}</a>
  </p>
</section>
{% schema %}
{
  "name": "t:sections.main-login.name",
  "tag": "section",
  "class": "section section--main-login",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main-login.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-login.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-login.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.main-login.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-login.presets.name"
    }
  ]
}
{% endschema %}
