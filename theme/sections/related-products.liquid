{%- liquid
  assign limit = section.settings.products_to_show | default: 4
  assign show_related = false
  if recommendations.performed and recommendations.products_count > 0
    assign show_related = true
  endif
-%}
<related-products-section
  data-product-id="{{ product.id }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=related"
  {% unless show_related %}data-pending{% endunless %}
>
  <section
    data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
    class="border-t border-border-hairline bg-surface-page"
  >
    <div class="mx-auto max-w-[var(--page-width)] px-6">
      <div class="mb-8 flex items-end justify-between border border-border-hairline p-5">
        <div>
          <p class="font-mono text-xs uppercase tracking-label text-text-muted">Recommended system</p>
          <h2 class="mt-2 font-display text-h3 tracking-tight text-text-strong">
            {{ section.settings.heading | default: 'You might also like' }}
          </h2>
        </div>
        <span class="hidden font-mono text-xs uppercase tracking-label text-text-muted md:block">{{ limit }} slots</span>
      </div>
      <div data-related-grid class="grid grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4">
        {%- if show_related -%}
          {%- assign shown = 0 -%}
          {%- for rp in recommendations.products -%}
            {%- if rp.id != product.id and shown < limit -%}
              {%- render 'product-card', product: rp -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <p data-related-loading class="col-span-full font-mono text-xs uppercase tracking-label text-text-muted">Loading recommendations…</p>
        {%- endif -%}
      </div>
    </div>
  </section>
</related-products-section>
<script src="{{ 'related-products.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section section--related",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.related-products.settings.heading.label",
      "default": "You might also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "t:sections.related-products.settings.products_to_show.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.related-products.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.related-products.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.related-products.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.related-products.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.related-products.presets.name"
    }
  ]
}
{% endschema %}
