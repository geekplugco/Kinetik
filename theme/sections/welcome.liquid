<section
  data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  class="hp-container text-center"
>
  {%- if section.settings.kicker != blank -%}<span class="hp-label">{{ section.settings.kicker }}</span>{%- endif -%}
  <h1 class="mt-4 font-display text-display-1 uppercase leading-none tracking-hero text-text-strong">{{ section.settings.heading }}</h1>
  {%- if section.settings.text != blank -%}<div class="mx-auto mt-5 max-w-md text-body-lg text-text-muted">{{ section.settings.text }}</div>{%- endif -%}
  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="mt-8 inline-block bg-accent px-8 py-4 font-mono text-sm uppercase tracking-label text-accent-ink">{{ section.settings.button_label }}</a>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "t:sections.welcome.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.welcome.settings.kicker.label",
      "default": "SS26 / Field System"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.welcome.settings.heading.label",
      "default": "Move faster."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.welcome.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.welcome.settings.button_label.label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.welcome.settings.button_link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.welcome.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.welcome.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.welcome.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.welcome.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.welcome.presets.name"
    }
  ]
}
{% endschema %}
