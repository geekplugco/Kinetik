{%- liquid
  assign base = product.selected_or_first_available_variant
  assign companions = product.metafields.custom.loadout.value
  assign block_products = section.blocks | where: 'type', 'product'
  assign picker_type = section.settings.picker_type | default: 'button'

  assign source_count = 0
  if companions != blank
    assign source_count = companions.size
  else
    assign source_count = block_products.size
  endif
-%}
{%- if source_count > 0 -%}
  <section
    data-color-scheme="{{ section.settings.color_scheme | default: 'scheme-2' }}"
    style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px"
    class="bg-surface-page pt-[var(--pt,64px)] pb-[var(--pb,64px)]"
  >
    <div class="mx-auto max-w-[var(--page-width)] px-6">
      <div class="mb-8 flex flex-col gap-3">
        {%- if section.settings.subheading != blank -%}
          <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ section.settings.subheading }}</span>
        {%- endif -%}
        <h2 class="font-display text-h2 tracking-tight text-text-strong">{{ section.settings.heading | default: 'Build the loadout' }}</h2>
        {%- if section.settings.note != blank -%}
          <p class="max-w-xl font-mono text-xs uppercase tracking-label text-text-muted">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>

      <build-loadout class="grid gap-8 lg:grid-cols-[2fr_1fr]" data-base-variant="{{ base.id }}" data-base-price="{{ base.price }}" data-currency="{{ cart.currency.iso_code }}">
        <ul class="flex flex-col border-t border-border-hairline">
          <li class="flex items-center gap-4 border-b border-border-hairline py-4">
            <div class="relative h-16 w-14 shrink-0 overflow-hidden bg-surface-sunken">
              {%- if product.featured_media -%}
                {%- assign base_alt = product.featured_media.alt | default: product.title | escape -%}
                {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', sizes: '56px', alt: base_alt, class: 'h-full w-full object-cover' }}
              {%- endif -%}
            </div>
            <div class="min-w-0 flex-1">
              <span class="font-mono text-[11px] uppercase tracking-label text-text-muted">{{ section.settings.base_label | default: 'This item' }}</span>
              <p class="truncate font-sans text-sm text-text-strong">{{ product.title }}</p>
            </div>
            <span data-base-price-display class="font-mono text-sm text-text-strong">{{ base.price | money }}</span>
          </li>

          {%- assign items = companions -%}
          {%- if companions == blank -%}
            {%- assign items = '' -%}
          {%- endif -%}
          {%- for cp in items -%}
            {%- if cp.id != product.id and cp.available -%}
              {%- assign cv = cp.selected_or_first_available_variant -%}
              <li class="flex items-center gap-4 border-b border-border-hairline py-4">
                <label class="flex items-center gap-4">
                  <input type="checkbox" data-loadout-item data-variant="{{ cv.id }}" data-price="{{ cv.price }}" aria-label="Add {{ cp.title | escape }} to loadout" checked class="h-4 w-4 shrink-0 accent-accent">
                  <div class="relative h-16 w-14 shrink-0 overflow-hidden bg-surface-sunken">
                    {%- if cp.featured_media -%}
                      {%- assign companion_alt = cp.featured_media.alt | default: cp.title | escape -%}
                      {{ cp.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', sizes: '56px', alt: companion_alt, class: 'h-full w-full object-cover' }}
                    {%- endif -%}
                  </div>
                </label>
                <div class="min-w-0 flex-1">
                  <a href="{{ cp.url }}" class="truncate font-sans text-sm text-text-strong hover:text-accent-press">{{ cp.title }}</a>
                  {%- render 'loadout-options', product: cp, section_id: section.id, picker_type: picker_type -%}
                </div>
                <span data-row-price class="font-mono text-sm text-text-muted">{{ cv.price | money }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- for block in block_products -%}
            {%- assign cp = block.settings.product -%}
            {%- if cp != blank and cp.id != product.id and cp.available -%}
              {%- assign cv = cp.selected_or_first_available_variant -%}
              <li class="flex items-center gap-4 border-b border-border-hairline py-4" {{ block.shopify_attributes }}>
                <label class="flex items-center gap-4">
                  <input type="checkbox" data-loadout-item data-variant="{{ cv.id }}" data-price="{{ cv.price }}" aria-label="Add {{ cp.title | escape }} to loadout" checked class="h-4 w-4 shrink-0 accent-accent">
                  <div class="relative h-16 w-14 shrink-0 overflow-hidden bg-surface-sunken">
                    {%- if cp.featured_media -%}
                      {%- assign block_companion_alt = cp.featured_media.alt | default: cp.title | escape -%}
                      {{ cp.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', sizes: '56px', alt: block_companion_alt, class: 'h-full w-full object-cover' }}
                    {%- endif -%}
                  </div>
                </label>
                <div class="min-w-0 flex-1">
                  <a href="{{ cp.url }}" class="truncate font-sans text-sm text-text-strong hover:text-accent-press">{{ cp.title }}</a>
                  {%- render 'loadout-options', product: cp, section_id: section.id, picker_type: picker_type -%}
                </div>
                <span data-row-price class="font-mono text-sm text-text-muted">{{ cv.price | money }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <aside class="flex flex-col gap-4 self-start border border-border-strong p-5 lg:sticky lg:top-24">
          <div class="flex items-center justify-between font-mono text-xs uppercase tracking-label text-text-muted">
            <span data-loadout-count>0 selected</span>
          </div>
          <div class="flex items-baseline justify-between border-t border-border-hairline pt-4">
            <span class="font-mono text-xs uppercase tracking-label text-text-muted">{{ section.settings.total_label | default: 'Loadout total' }}</span>
            <span data-loadout-total class="font-display text-h4 text-text-strong">{{ base.price | money }}</span>
          </div>
          <button type="button" data-add-loadout class="inline-flex w-full items-center justify-center gap-2 bg-accent px-6 py-3 font-mono text-sm uppercase tracking-wide text-accent-ink transition-colors hover:bg-accent-hover disabled:pointer-events-none disabled:opacity-40">
            {{ section.settings.button_label | default: 'Add loadout to cart' }}
          </button>
          <p data-loadout-error role="alert" class="font-mono text-xs text-negative empty:hidden"></p>
        </aside>
      </build-loadout>
    </div>
    <script src="{{ 'product-loadout.js' | asset_url }}" defer="defer"></script>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.product-loadout.name",
  "tag": "section",
  "class": "section section--product-loadout",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "inline_richtext", "id": "subheading", "label": "t:sections.product-loadout.settings.subheading.label", "default": "Field loadout" },
    { "type": "text", "id": "heading", "label": "t:sections.product-loadout.settings.heading.label", "default": "Build the loadout" },
    { "type": "text", "id": "note", "label": "t:sections.product-loadout.settings.note.label", "info": "t:sections.product-loadout.settings.note.info" },
    { "type": "text", "id": "base_label", "label": "t:sections.product-loadout.settings.base_label.label", "default": "This item" },
    { "type": "text", "id": "total_label", "label": "t:sections.product-loadout.settings.total_label.label", "default": "Loadout total" },
    { "type": "text", "id": "button_label", "label": "t:sections.product-loadout.settings.button_label.label", "default": "Add loadout to cart" },
    { "type": "header", "content": "t:sections.product-loadout.settings.header__source.content" },
    { "type": "paragraph", "content": "t:sections.product-loadout.settings.paragraph__source.content" },
    { "type": "header", "content": "t:sections.product-loadout.settings.header__style.content" },
    {
      "type": "select",
      "id": "picker_type",
      "label": "t:sections.product-loadout.settings.picker_type.label",
      "options": [
        { "value": "button", "label": "t:sections.product-loadout.settings.picker_type.options__1.label" },
        { "value": "dropdown", "label": "t:sections.product-loadout.settings.picker_type.options__2.label" }
      ],
      "default": "button"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.product-loadout.settings.color_scheme.label", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "default": 64, "unit": "px", "label": "t:sections.product-loadout.settings.padding_top.label" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "default": 64, "unit": "px", "label": "t:sections.product-loadout.settings.padding_bottom.label" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.product-loadout.blocks.product.name",
      "settings": [
        { "type": "product", "id": "product", "label": "t:sections.product-loadout.blocks.product.settings.product.label" }
      ]
    }
  ],
  "presets": [
    { "name": "t:sections.product-loadout.presets.name__1" }
  ]
}
{% endschema %}
