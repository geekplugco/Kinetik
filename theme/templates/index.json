    "trust": {
      "type": "multicolumn",
      "settings": {
        "subheading": "The system",
        "heading": "Why Waypoint",
        "text": "<p>No seasonal noise. A tight kit of technical pieces, engineered to outlast the trend cycle.</p>"
      },
      "blocks": {
        "c1": {
          "type": "column",
          "settings": {
            "title": "Field-tested, not focus-grouped",
            "text": "<p>Every piece is worn hard before it ships \u2014 trail, transit, weather. If it doesn't earn its place in the kit, it doesn't make the line.</p>"
          }
        },
        "c2": {
          "type": "column",
          "settings": {
            "title": "Materials with a spec sheet",
            "text": "<p>Gore-Tex 3L shells, ripstop nylon, recycled hardware. We publish the build so you know exactly what you're moving in.</p>"
          }
        },
        "c3": {
          "type": "column",
          "settings": {
            "title": "Built to be repaired",
            "text": "<p>Replaceable zips, reinforced stress points, a lifetime warranty on every seam. Keep it in rotation for years, not seasons.</p>"
          }
        },
        "c4": {
          "type": "column",
          "settings": {
            "title": "Carbon-neutral by default",
            "text": "<p>Offset shipping, low-impact dye houses, and take-back recycling. Movement that doesn't cost the planet its own.</p>"
          }
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3",
        "c4"
