{ "name": "Video", "tag": "section", "class": "section section--video",
  "settings": [ { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "video_url", "id": "video_url", "label": "Video URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "width", "label": "Width", "default": "wide",
      "options": [ { "value": "narrow", "label": "Narrow" }, { "value": "wide", "label": "Wide" }, { "value": "page", "label": "Page" }, { "value": "full", "label": "Full width" } ] },
    { "type": "select", "id": "media_ratio", "label": "Video ratio", "default": "16/9",
      "options": [ { "value": "16/9", "label": "16:9" }, { "value": "21/9", "label": "21:9 cinematic" }, { "value": "4/3", "label": "4:3" }, { "value": "1/1", "label": "1:1 square" } ] },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "select", "id": "overlay_style", "label": "Cover overlay", "default": "tint",
      "options": [ { "value": "none", "label": "None" }, { "value": "tint", "label": "Tint" }, { "value": "strong", "label": "Strong" } ] },
    { "type": "header", "content": "Section" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" } ],
  "presets": [
    { "name": "Video" },
    { "name": "Video — cinematic", "settings": { "media_ratio": "21/9", "width": "full", "heading_alignment": "center", "overlay_style": "strong", "color_scheme": "scheme-3" } },
    { "name": "Video — square spotlight", "settings": { "media_ratio": "1/1", "width": "narrow", "heading_alignment": "center", "overlay_style": "tint" } } ] }
