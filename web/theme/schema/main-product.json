{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section section--main-product",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "t:labels.media" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "select", "id": "media_size", "label": "t:labels.media_size", "default": "medium",
      "options": [
        { "value": "small", "label": "t:labels.size_small" },
        { "value": "medium", "label": "t:labels.size_medium" },
        { "value": "large", "label": "t:labels.size_large" }
      ] },
    { "type": "select", "id": "gallery_layout", "label": "t:labels.gallery_layout", "default": "stacked",
      "options": [
        { "value": "stacked", "label": "t:labels.gallery_stacked" },
        { "value": "thumbnail", "label": "t:labels.gallery_thumbnail" },
        { "value": "thumbnail_slider", "label": "t:labels.gallery_thumbnail_slider" }
      ] },
    { "type": "checkbox", "id": "enable_sticky_info", "label": "t:labels.enable_sticky_info", "default": true },
    { "type": "checkbox", "id": "enable_sticky_atc", "label": "Sticky add-to-cart bar", "default": true },
    { "type": "checkbox", "id": "enable_image_zoom", "label": "t:labels.enable_image_zoom", "default": true },
    { "type": "header", "content": "t:labels.section_padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "default": 36, "unit": "px", "label": "t:labels.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "default": 36, "unit": "px", "label": "t:labels.padding_bottom" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "t:blocks.title", "limit": 1,
      "settings": [
        { "type": "select", "id": "heading_size", "label": "t:labels.heading_size", "default": "h1",
          "options": [ { "value": "h1", "label": "t:labels.size_large" }, { "value": "h2", "label": "t:labels.size_medium" } ] }
      ] },
    { "type": "price", "name": "t:blocks.price", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "t:blocks.variant_picker", "limit": 1,
      "settings": [
        { "type": "select", "id": "picker_type", "label": "t:labels.picker_type", "default": "button",
          "options": [ { "value": "button", "label": "t:labels.picker_button" }, { "value": "dropdown", "label": "t:labels.picker_dropdown" } ] }
      ] },
    { "type": "quantity_selector", "name": "t:blocks.quantity_selector", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "t:blocks.buy_buttons", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:labels.show_dynamic_checkout", "default": true }
      ] },
    { "type": "description", "name": "t:blocks.description", "settings": [] },
    { "type": "collapsible_tab", "name": "t:blocks.collapsible_tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Collapsible row" },
        { "type": "richtext", "id": "content", "label": "t:labels.content" }
      ] },
    { "type": "share", "name": "t:blocks.share", "limit": 2, "settings": [] },
    { "type": "custom_liquid", "name": "t:blocks.custom_liquid",
      "settings": [ { "type": "liquid", "id": "custom_liquid", "label": "t:labels.custom_liquid" } ] }
  ]
}
