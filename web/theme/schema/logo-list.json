{ "name": "Logo list", "tag": "section", "class": "section section--logo-list", "max_blocks": 12,
  "settings": [ { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "As seen in" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "row",
      "options": [ { "value": "row", "label": "Centered row" }, { "value": "grid", "label": "Grid" } ] },
    { "type": "select", "id": "width", "label": "Width", "default": "page",
      "options": [ { "value": "narrow", "label": "Narrow" }, { "value": "page", "label": "Page" }, { "value": "full", "label": "Full width" } ] },
    { "type": "select", "id": "logo_size", "label": "Logo size", "default": "medium",
      "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ] },
    { "type": "select", "id": "logo_style", "label": "Logo style", "default": "muted",
      "options": [ { "value": "muted", "label": "Muted (reveal on hover)" }, { "value": "grayscale", "label": "Grayscale (color on hover)" }, { "value": "full", "label": "Full color" } ] },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 1, "max": 5, "step": 1, "default": 5, "info": "Used when layout is Grid" },
    { "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "default": "2",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "header", "content": "Section" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" } ],
  "blocks": [ { "type": "logo", "name": "Logo", "settings": [
    { "type": "image_picker", "id": "image", "label": "Logo" },
    { "type": "text", "id": "alt", "label": "Name" } ] } ],
  "presets": [
    { "name": "Logo list", "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }] },
    { "name": "Logo grid", "settings": { "layout": "grid", "columns_desktop": 5, "columns_mobile": "2", "logo_style": "grayscale" }, "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }] },
    { "name": "Logo wall — dark", "settings": { "layout": "grid", "columns_desktop": 4, "logo_style": "full", "color_scheme": "scheme-3" }, "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }] } ] }
