{ "name": "Announcement bar", "tag": "div", "class": "section section--announcement", "max_blocks": 5,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "display", "label": "Display", "default": "static",
      "options": [
        { "value": "static", "label": "Show all messages" },
        { "value": "rotate", "label": "Rotate one at a time" }
      ] },
    { "type": "range", "id": "rotate_speed", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Rotate every", "default": 4 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ] },
    { "type": "select", "id": "width", "label": "Width", "default": "page",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "full", "label": "Full width" }
      ] },
    { "type": "checkbox", "id": "show_localization", "label": "Show country/language selectors", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 8 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 8 }
  ],
  "blocks": [ { "type": "message", "name": "Message", "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" },
    { "type": "url", "id": "link", "label": "Link" } ] } ],
  "presets": [
    { "name": "Announcement bar", "blocks": [{ "type": "message" }] },
    { "name": "Announcement bar — rotating", "settings": { "display": "rotate", "rotate_speed": 4 }, "blocks": [{ "type": "message" }, { "type": "message" }, { "type": "message" }] }
  ] }
