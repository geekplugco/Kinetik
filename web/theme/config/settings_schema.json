[
  {
    "name": "theme_info",
    "theme_name": "Kinetik",
    "theme_version": "0.1.0",
    "theme_author": "Kinetik",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "header", "content": "Colors" },
          { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
          { "type": "color", "id": "text", "label": "Text", "default": "#0A0A0A" },
          { "type": "color", "id": "accent", "label": "Accent", "default": "#CCFF00" },
          { "type": "color", "id": "on_accent", "label": "On accent", "default": "#0A0A0A" }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "accent",
          "on_primary_button": "on_accent"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "font_heading", "label": "Heading font", "default": "space_grotesk_n7" },
      { "type": "font_picker", "id": "font_body", "label": "Body font", "default": "inter_n4" },
      { "type": "font_picker", "id": "font_accent", "label": "Accent / mono font", "info": "Used for spec labels and codes", "default": "space_mono_n4" },
      { "type": "range", "id": "font_body_scale", "min": 90, "max": 130, "step": 5, "unit": "%", "default": 100, "label": "Body scale" },
      { "type": "range", "id": "font_heading_scale", "min": 100, "max": 150, "step": 5, "unit": "%", "default": 100, "label": "Heading scale" }
    ]
  },
  {
    "name": "Theme CSS",
    "settings": [
      { "type": "paragraph", "content": "No-build Tailwind: 'production' serves the committed minified CSS (Theme Store). 'development' compiles tailwind.css live via the Tailwind browser CDN — use only while developing." },
      { "type": "select", "id": "mode", "label": "CSS mode", "default": "production-css-inline",
        "options": [
          { "value": "production", "label": "Production (linked min.css)" },
          { "value": "production-css-inline", "label": "Production (inlined min.css)" },
          { "value": "development", "label": "Development (live Tailwind CDN)" }
        ] }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1440, "label": "Page width" },
      { "type": "range", "id": "spacing_sections", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "Space between sections" },
      { "type": "range", "id": "corner_radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0, "label": "Corner radius" }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      { "type": "select", "id": "button_style", "label": "Style", "default": "square",
        "options": [{ "value": "square", "label": "Square" }, { "value": "rounded", "label": "Rounded" }] },
      { "type": "checkbox", "id": "button_uppercase", "label": "Uppercase labels", "default": true }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "select", "id": "card_image_ratio", "label": "Image ratio", "default": "portrait",
        "options": [{ "value": "adapt", "label": "Adapt" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }] },
      { "type": "checkbox", "id": "card_show_vendor", "label": "Show vendor", "default": true },
      { "type": "checkbox", "id": "card_quick_add", "label": "Quick add", "default": true }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "select", "id": "cart_type", "label": "Cart type", "default": "drawer",
        "options": [{ "value": "drawer", "label": "Drawer" }, { "value": "page", "label": "Page" }] },
      { "type": "checkbox", "id": "cart_free_shipping_bar", "label": "Free shipping bar", "default": true },
      { "type": "range", "id": "cart_free_shipping_threshold", "min": 0, "max": 50000, "step": 1000, "default": 15000, "unit": "px", "label": "Threshold (cents)" }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok" },
      { "type": "text", "id": "social_youtube", "label": "YouTube" }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      { "type": "checkbox", "id": "animate_reveal", "label": "Reveal on scroll", "default": true },
      { "type": "select", "id": "animate_hover", "label": "Card hover", "default": "zoom",
        "options": [{ "value": "none", "label": "None" }, { "value": "zoom", "label": "Zoom" }] }
    ]
  }
]
