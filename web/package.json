{
  "name": "kinetik-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5555",
    "build": "next build",
    "start": "next start -p 5555",
    "typecheck": "tsc --noEmit",
    "validate": "tsc --noEmit && bun run scripts/validate.ts",
    "guard:comments": "node scripts/guard-comments.mjs ../theme",
    "guard:settings": "node scripts/guard-settings.mjs ../theme",
    "guard:perf": "node scripts/guard-perf.mjs ../theme",
    "guard:contrast": "node scripts/guard-contrast.mjs ../theme",
    "smoke:sections": "SMOKE_THEME_DIR=../theme node scripts/smoke-sections.mjs",
    "smoke:theme": "cd ../theme && node ../web/scripts/smoke-theme.mjs",
    "gate:theme": "node scripts/guard-comments.mjs ../theme && node scripts/guard-settings.mjs ../theme && node scripts/guard-perf.mjs ../theme && node scripts/guard-contrast.mjs ../theme && shopify theme check --path ../theme && node ~/.claude/skills/teifi-theme-json/src/validate.mjs gate ../theme --strict"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
